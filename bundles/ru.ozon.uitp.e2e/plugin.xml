<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension point="org.eclipse.ui.views">
      <category
            id="ru.ozon.uitp.e2e.views.category"
            name="Specter">
      </category>
      <view
            id="ru.ozon.uitp.e2e.views.TestsView"
            category="ru.ozon.uitp.e2e.views.category"
            name="Specter: Тесты и Результаты"
            icon="icons/specter-tests.png"
            class="ru.ozon.uitp.e2e.views.TestsView"
            restorable="true">
      </view>
      <view
            id="ru.ozon.uitp.e2e.views.ExtensionTestsView"
            category="ru.ozon.uitp.e2e.views.category"
            name="Тесты расширения (СП)"
            icon="icons/specter-tests.png"
            class="ru.ozon.uitp.e2e.views.ExtensionTestsView"
            restorable="true">
      </view>
      <view
            id="ru.ozon.uitp.e2e.views.ResultsView"
            category="ru.ozon.uitp.e2e.views.category"
            name="Результаты (лог)"
            icon="icons/specter-results.png"
            class="ru.ozon.uitp.e2e.views.ResultsView"
            restorable="true">
      </view>
   </extension>

   <!-- Маркер обнаружения теста в редакторе кода BSL (YAxUnit-паттерн) -->
   <extension
         id="ru.ozon.uitp.e2e.testMarker"
         name="СП Тест"
         point="org.eclipse.core.resources.markers">
      <super type="org.eclipse.core.resources.textmarker"/>
      <persistent value="false"/>
      <attribute name="testName"/>
      <attribute name="moduleName"/>
   </extension>

   <!-- Тип аннотации для вертикальной линейки (Gutter Ruler) редактора -->
   <extension
         point="org.eclipse.ui.editors.annotationTypes">
      <type
            name="ru.ozon.uitp.e2e.testAnnotation"
            markerType="ru.ozon.uitp.e2e.testMarker"
            super="org.eclipse.ui.workbench.texteditor.info">
      </type>
   </extension>

   <!-- Спецификация иконки запуска теста на вертикальной линейке (Gutter) -->
   <extension
         point="org.eclipse.ui.editors.markerAnnotationSpecification">
      <specification
            annotationType="ru.ozon.uitp.e2e.testAnnotation"
            label="Запустить тест (СП)"
            icon="icons/specter-tests.png"
            verticalRulerPreferenceKey="ru.ozon.uitp.e2e.testAnnotation.ruler"
            verticalRulerPreferenceValue="true"
            overviewRulerPreferenceKey="ru.ozon.uitp.e2e.testAnnotation.overview"
            overviewRulerPreferenceValue="true"
            colorPreferenceKey="ru.ozon.uitp.e2e.testAnnotation.color"
            colorPreferenceValue="34,197,94"
            highlightPreferenceKey="ru.ozon.uitp.e2e.testAnnotation.highlight"
            highlightPreferenceValue="false"
            textPreferenceKey="ru.ozon.uitp.e2e.testAnnotation.text"
            textPreferenceValue="false">
      </specification>
   </extension>

   <!-- Быстрый запуск теста по клику на маркер / QuickFix -->
   <extension
         point="org.eclipse.ui.ide.markerResolution">
      <markerResolutionGenerator
            markerType="ru.ozon.uitp.e2e.testMarker"
            class="ru.ozon.uitp.e2e.views.RunTestMarkerResolutionGenerator">
      </markerResolutionGenerator>
   </extension>

   <!-- Команда в контекстном меню редактора BSL: Запустить тест СП -->
   <extension
         point="org.eclipse.ui.popupMenus">
      <viewerContribution
            id="ru.ozon.uitp.e2e.editor.popup"
            targetID="#CompilationUnitEditorContext">
         <action
               id="ru.ozon.uitp.e2e.actions.runTestAtCursor"
               label="Запустить тест (СП_Тестирование)"
               icon="icons/specter-tests.png"
               class="ru.ozon.uitp.e2e.views.RunTestAtCursorAction"
               menubarPath="additions">
         </action>
      </viewerContribution>
      <viewerContribution
            id="ru.ozon.uitp.e2e.editor.bsl.popup"
            targetID="com._1c.g5.v8.dt.bsl.ui.BslEditor.EditorContext">
         <action
               id="ru.ozon.uitp.e2e.actions.runTestAtCursorBsl"
               label="Запустить тест (СП_Тестирование)"
               icon="icons/specter-tests.png"
               class="ru.ozon.uitp.e2e.views.RunTestAtCursorAction"
               menubarPath="additions">
         </action>
      </viewerContribution>
   </extension>
   <!-- Страница настроек плагина Specter (Путь к тестам Vanessa Automation) -->
   <extension
         point="org.eclipse.ui.preferencePages">
      <page
            id="ru.ozon.uitp.e2e.preferences.SpecterPreferencePage"
            name="Specter"
            class="ru.ozon.uitp.e2e.preferences.SpecterPreferencePage">
      </page>
   </extension>

   <!-- Меню и действия конвертации тестов Vanessa Automation -->
   <extension
         point="org.eclipse.ui.actionSets">
      <actionSet
            id="ru.ozon.uitp.e2e.actionSet"
            label="Specter Vanessa Actions"
            visible="true">
         <action
               id="ru.ozon.uitp.e2e.converter.ConvertVanessaTestsAction"
               label="Конвертировать тесты Vanessa в модули СП..."
               tooltip="Распознавание тестов Vanessa Automation и конвертация в CommonModules расширения СП_Тестирование"
               icon="icons/specter-tests.png"
               class="ru.ozon.uitp.e2e.converter.ConvertVanessaTestsAction"
               menubarPath="window/additions"
               toolbarPath="Normal/additions">
         </action>
      </actionSet>
   </extension>
</plugin>
