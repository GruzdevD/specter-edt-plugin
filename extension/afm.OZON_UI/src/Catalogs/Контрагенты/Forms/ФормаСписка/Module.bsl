// =====================================================================
// Агент платформы ui-test-platform (единый UiAdapter-контур).
//
// ЖИВОЙ МОСТ КОМАНД Runner ↔ сессия 1С (файловый канал как транспорт доставки):
//   Runner  пишет  <каталогОбмена>/bridge-commands.json             { runId, commands:[{id,action,target,...}] }
//   агент   (наш BSL) исполняет команды на РЕАЛЬНОМ слое UI
//           (ЭтаФорма.Элементы.Найти(...).Видимость и т.п.) и пишет
//           <каталогОбмена>/bridge-result-<runId>.json              { runId, status, steps:[...] }.
//
// Файловый канал отвечает ТОЛЬКО за доставку. Семантика UI-команд определяется
// каноническим протоколом UiProtocol (см. CommonModules/OZON_UI_Протокол),
// а не этим файловым форматом. Отдельный независимый формат команд НЕ вводится:
// здесь транспонируется канонический поток шагов (action + локатор).
//
// КОНФИГУРАЦИЯ (без абсолютных путей и учётных данных в коде):
//   каталог обмена передаёт EDT-плагин в стартовой опции клиента:
//     /C "OZONUI_START_BRIDGE|outDir=<абсолютный путь>"
//   (значение целиком попадает в ПараметрЗапуска). Если outDir не задан —
//   агент не переходит на скрытый локальный путь, а возвращает явную ошибку.
//
// Отрицательный случай — assert с заведомо неверным expected — даёт failed
// честно (не подменяется на зелёный).
//
// Ограничения связки: элементы формы мутабельны, существование элемента
// проверяем только через "<> Неопределено" (ЗначениеЗаполнено(ЭлементФормы) падало).
// =====================================================================

// Соглашение стартовой опции, которое формирует EDT-плагин (см. BridgeLaunchHelper).
// Держать в одном месте, чтобы агент и плагин не расходились.
// В 1С Перем нельзя инициализировать при объявлении — значения задаём в коде.
// Агент моста живёт на тонком клиенте (форма списка), поэтому переменные модуля — &НаКлиенте.
&НаКлиенте
Перем МаркерАвтозапуска;
&НаКлиенте
Перем ИмяПараметраКаталога;
&НаКлиенте
Перем КэшКаталогаОбмена; // заполняется при первом разборе стартовой опции
&НаКлиенте
Перем ТекущаяКарточка;   // открытая форма карточки (openCard); Неопределено пока не открыта
&НаКлиенте
Перем ТекущийRunId;   // runId исполняемых команд (для именования артефактов инспектора)

// Вызывается из ПриОткрытии adopted ФормаСписка (EventHandlerExtension, After).
&НаКлиенте
Процедура ПроверитьСценарий(Отказ) Экспорт

	ВыполнитьКомандыRunner();

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьКомандыRunner()

	// Каталог обмена приходит из стартовой опции клиента (формирует EDT-плагин).
	Попытка
		КаталогОбмена = ПолучитьКаталогОбмена();
	Исключение
		// Нет обязательной настройки — понятная ошибка, а не скрытый путь.
		ЗаписатьДиагностику("no-outdir: " + ОписаниеОшибки(), "");
		Возврат;
	КонецПопытки;

	ЗаписатьДиагностику("enter outDir=" + КаталогОбмена, КаталогОбмена);

	Попытка
		КомандыИзФайла = ПрочитатьКомандыСНаСервера(КаталогОбмена);
	Исключение
		// файл команд недоступен — агент ждёт следующего открытия формы
		ЗаписатьДиагностику("client-catch-read: " + ОписаниеОшибки(), КаталогОбмена);
		Возврат;
	КонецПопытки;

	Если КомандыИзФайла = Неопределено Тогда
		// Командного файла нет (или он пуст) — агент нечего исполнять.
		ЗаписатьДиагностику("no-commands", КаталогОбмена);
		Возврат;
	КонецЕсли;

	RunId    = КомандыИзФайла.runId;
	ТекущийRunId = RunId;
	СписокКоманд = КомандыИзФайла.commands;
	ЗаписатьДиагностику("commands-read runId=" + Строка(RunId) + " count=" + Строка(СписокКоманд.Количество()), КаталогОбмена);

	// Команда "runSet" (запуск конкретного тестового набора из панели EDT): НЕ пошаговый
	// UI-цикл, а единый прогон набора движком OZON_UI_Тестирование. Результат - массив
	// шагов по тестам набора + общий итог. Выполняем отдельно от обычного контура
	// UI-действий (движковые тесты не обязаны быть UI-скроллом; UI-наборы исполняются
	// серверно в этой же сессии через &НаСервере).
	Если СписокКоманд.Количество() = 1 И СписокКоманд[0].action = "runSet" Тогда
		ИтогНабора = ЗапуститьНаборЧерезМост(СписокКоманд[0]);
		ЗаписатьДиагностику("runSet: набор=" + Строка(СписокКоманд[0].target)
			+ " итог=" + ИтогНабора.Итог + " тестов=" + Строка(ИтогНабора.Шаги.Количество()), КаталогОбмена);
		Попытка
			ЗаписатьРезультатНаСервер(RunId, ИтогНабора.Итог, ИтогНабора.Шаги, КаталогОбмена);
			ЗаписатьДиагностику("write-ok-runSet", КаталогОбмена);
		Исключение
			ЗаписатьДиагностику("write-fail-runSet: " + ОписаниеОшибки(), КаталогОбмена);
		КонецПопытки;
		Возврат;
	КонецЕсли;

	Шаги = Новый Массив;
	Для Каждого Команда Из СписокКоманд Цикл
		// Отзывчивость сеанса между шагами (ядро УИ_Ожидания, §4/#3): покрутить очередь
		// событий, дать форме перерисоваться и допустить отмену - без блокирующего Sleep.
		OZON_UI_ОжиданияКлиент.Проветриться();
		Шаги.Добавить(ВыполнитьКоманду(Команда));
	КонецЦикла;

	Итог = "passed";
	Для Каждого Шаг Из Шаги Цикл
		Если Шаг.status = "failed" Тогда
			Итог = "failed";
			Прервать;
		КонецЕсли;
	КонецЦикла;

	ЗаписатьДиагностику("before-write status=" + Итог, КаталогОбмена);
	Попытка
		ЗаписатьРезультатНаСервер(RunId, Итог, Шаги, КаталогОбмена);
		ЗаписатьДиагностику("write-ok", КаталогОбмена);
	Исключение
		// не фатально: результат не записан, будет видно по отсутствию файла
		ЗаписатьДиагностику("write-fail: " + ОписаниеОшибки(), КаталогОбмена);
	КонецПопытки;

КонецПроцедуры

// Единая точка конфигурации каталога обмена. Источник — стартовая опция клиента.
&НаКлиенте
Функция ПолучитьКаталогОбмена()

	Если ПустаяСтрока(КэшКаталогаОбмена) Тогда

		Если ПустаяСтрока(МаркерАвтозапуска) Тогда
			МаркерАвтозапуска = "OZONUI_START_BRIDGE";
		КонецЕсли;
		Если ПустаяСтрока(ИмяПараметраКаталога) Тогда
			ИмяПараметраКаталога = "outDir=";
		КонецЕсли;

		// Маркер + параметры: /C "OZONUI_START_BRIDGE|outDir=/абс/путь"
		Опция = ПараметрЗапуска;
		ПозицияМаркера = СтрНайти(Опция, МаркерАвтозапуска);
		Если ПозицияМаркера = 0 Тогда
			ВызватьИсключение "Стартовая опция '" + МаркерАвтозапуска + "' не найдена в параметре запуска клиента.";
		КонецЕсли;

		ПозицияПараметра = СтрНайти(Опция, ИмяПараметраКаталога);
		Если ПозицияПараметра = 0 Тогда
			ВызватьИсключение "Каталог обмена не передан в стартовой опции (ожидается '" + ИмяПараметраКаталога
				+ "' после маркера '" + МаркерАвтозапуска + "'). Установите его в EDT-плагине";
		КонецЕсли;

		Значение = Сред(Опция, ПозицияПараметра + СтрДлина(ИмяПараметраКаталога));
		// Отрезаем всё от ближайшего разделителя опций (|) до конца.
		Разделитель = СтрНайти(Значение, "|");
		Если Разделитель > 0 Тогда
			Значение = Лев(Значение, Разделитель - 1);
		КонецЕсли;
		Значение = СокрЛП(Значение);

		Если ПустаяСтрока(Значение) Тогда
			ВызватьИсключение "Значение outDir пусто в стартовой опции клиента.";
		КонецЕсли;

		КэшКаталогаОбмена = Значение;
	КонецЕсли;

	Возврат КэшКаталогаОбмена;

КонецФункции

&НаКлиенте
Функция ВыполнитьКоманду(Команда)

	Шаг = Новый Структура("id, action, status, detail", "", "", "", "");
	Шаг.id     = Команда.id;
	Шаг.action = Команда.action;

	Действие = Команда.action;

	Если Действие = "openList" Тогда
		// Команда-калибровка: убедиться, что реальная форма списка открыта и таблица существует.
		Элемент = ЭтаФорма.Элементы.Найти(Команда.target);
		Ок = (Элемент <> Неопределено);
		Шаг.status = ?(Ок, "passed", "failed");
		Шаг.detail = "форма списка активна; элемент '" + Команда.target + "' найден=" + Строка(Ок);

	ИначеЕсли Действие = "openCard" Тогда
		// Открыть карточку Контрагента как РЕАЛЬНУЮ форму элемента; команды карточки
		// исполняются экспортными процедурами модуля карточки (УстановитьПоле/НажатьКоманду/...).
		ИмяФормыКарточки = Команда.target;
		Если ПустаяСтрока(ИмяФормыКарточки) Тогда
			ИмяФормыКарточки = "Справочник.Контрагенты.ФормаЭлемента";
		КонецЕсли;
		Попытка
			ТекущаяКарточка = ПолучитьФорму(ИмяФормыКарточки);
			ТекущаяКарточка.Открыть();
			Шаг.status = "passed";
			Шаг.detail = "карточка открыта: " + ИмяФормыКарточки;
		Исключение
			Шаг.status = "failed";
			Шаг.detail = "openCard: " + ОписаниеОшибки();
		КонецПопытки;

	ИначеЕсли Действие = "setValue" Тогда
		// Установить значение реквизита карточки (real UI: Объект[Реквизит] в модуле карточки).
		Если ТекущаяКарточка = Неопределено Тогда
			Шаг.status = "failed";
			Шаг.detail = "setValue: карточка не открыта (сначала openCard)";
		Иначе
			Попытка
				ТекущаяКарточка.УстановитьПоле(Команда.target, Команда.value);
				Шаг.status = "passed";
				Шаг.detail = "setValue " + Команда.target + " = '" + Строка(Команда.value) + "'";
			Исключение
				Шаг.status = "failed";
				Шаг.detail = "setValue: " + ОписаниеОшибки();
			КонецПопытки;
		КонецЕсли;

	ИначеЕсли Действие = "click" Тогда
		// Выполнить команду формы карточки (Записать / Записать и закрыть / Закрыть).
		Вид = Команда.kind;
		Если ПустаяСтрока(Вид) Тогда
			Вид = "command";
		КонецЕсли;
		Если Вид <> "command" Тогда
			Шаг.status = "failed";
			Шаг.detail = "click: неизвестный kind '" + Вид + "' (поддерживается command)";
		ИначеЕсли ТекущаяКарточка = Неопределено Тогда
			Шаг.status = "failed";
			Шаг.detail = "click: карточка не открыта (сначала openCard)";
		Иначе
			Попытка
				ТекущаяКарточка.НажатьКоманду(Команда.target);
				Шаг.status = "passed";
				Шаг.detail = "click command '" + Команда.target + "'";
			Исключение
				Шаг.status = "failed";
				Шаг.detail = "click: " + ОписаниеОшибки();
			КонецПопытки;
		КонецЕсли;

	ИначеЕсли Действие = "read" Тогда
		// Прочитать значение реквизита карточки (без проверки; факт уходит в detail).
		Если ТекущаяКарточка = Неопределено Тогда
			Шаг.status = "failed";
			Шаг.detail = "read: карточка не открыта (сначала openCard)";
		Иначе
			Попытка
				Факт = ТекущаяКарточка.ПрочитатьПоле(Команда.target);
				Шаг.status = "passed";
				Шаг.detail = "read " + Команда.target + " = '" + Строка(Факт) + "'";
			Исключение
				Шаг.status = "failed";
				Шаг.detail = "read: " + ОписаниеОшибки();
			КонецПопытки;
		КонецЕсли;

	ИначеЕсли Действие = "inspect" Тогда
		// Исследователь формы (R4, УИ_Инспектор): карта активной карточки в JSON-файл
		// каталога обмена для EDT/MCP (только топология элементов, БЕЗ значений данных).
		Если ТекущаяКарточка = Неопределено Тогда
			Шаг.status = "failed";
			Шаг.detail = "inspect: карточка не открыта (сначала openCard)";
		Иначе
			Попытка
				Топология = ТекущаяКарточка.СобратьТопологию();
				ПутьТопологии = ОбъединитьПути(КэшКаталогаОбмена, "bridge-form-inspect-" + ТекущийRunId + ".json");
				ЗаписатьТопологиюJSON(ПутьТопологии, Топология);
				Шаг.status = "passed";
				Шаг.detail = "inspect: элементов=" + Строка(Топология.Количество()) + " -> " + ПутьТопологии;
			Исключение
				Шаг.status = "failed";
				Шаг.detail = "inspect: " + ОписаниеОшибки();
			КонецПопытки;
		КонецЕсли;

	ИначеЕсли Действие = "assertValue" Тогда
		// Утверждение значения реквизита карточки (факт из реальной формы).
		Если ТекущаяКарточка = Неопределено Тогда
			Шаг.status = "failed";
			Шаг.detail = "assertValue: карточка не открыта (сначала openCard)";
		Иначе
			Попытка
				Факт = ТекущаяКарточка.ПрочитатьПоле(Команда.target);
				Ок = (Строка(Факт) = Строка(Команда.expected));
				Шаг.status = ?(Ок, "passed", "failed");
				Шаг.detail = "field=" + Команда.target
					+ " fact='" + Строка(Факт) + "'"
					+ " expected='" + Строка(Команда.expected) + "'";
			Исключение
				Шаг.status = "failed";
				Шаг.detail = "assertValue: " + ОписаниеОшибки();
			КонецПопытки;
		КонецЕсли;

	ИначеЕсли Действие = "assert" Тогда
		// Обобщённое утверждение по свойству UI-элемента: субъект "list" (эта форма списка)
		// или "card" (открытая карточка, свойство реального элемента её слоя).
		Субъект = ?(ПустаяСтрока(Команда.subject), "list", НРег(Команда.subject));
		Если Субъект = "card" Тогда
			Если ТекущаяКарточка = Неопределено Тогда
				Шаг.status = "failed";
				Шаг.detail = "assert(card): карточка не открыта (сначала openCard)";
				Возврат Шаг;
			КонецЕсли;
			Попытка
				Факт = ТекущаяКарточка.СвойствоОбъекта(Команда.target, Команда.property);
			Исключение
				Шаг.status = "failed";
				Шаг.detail = "assert(card): " + ОписаниеОшибки();
				Возврат Шаг;
			КонецПопытки;
			Ок = (Строка(Факт) = Строка(Команда.expected));
			Шаг.status = ?(Ок, "passed", "failed");
			Шаг.detail = "subject=card property=" + Команда.property
				+ " element='" + Команда.target + "'"
				+ " fact='" + Строка(Факт) + "'"
				+ " expected='" + Строка(Команда.expected) + "'"
				+ " (реальный слой UI)";
		Иначе
			Элемент = ЭтаФорма.Элементы.Найти(Команда.target);
			Есть = (Элемент <> Неопределено);
			Если НЕ Есть Тогда
				Шаг.status = "failed";
				Шаг.detail = "элемент '" + Команда.target + "' не найден на форме списка (assert по UI-свойству невозможен)";
				Возврат Шаг;
			КонецЕсли;

			Свойство = Команда.property;
			Факт = ПолучитьСвойствоЭлемента(Элемент, Команда.property);
			Ок = (Строка(Факт) = Строка(Команда.expected));
			Шаг.status = ?(Ок, "passed", "failed");
			Шаг.detail = "property=" + Свойство
				+ " fact='" + Строка(Факт) + "'"
				+ " expected='" + Строка(Команда.expected) + "'"
				+ " (реальный слой UI)";
		КонецЕсли;

	ИначеЕсли Действие = "wait" Тогда
		// Smart-wait (аналог Vanessa): поллить свойство элемента, пока оно не станет ожидаемым,
		// либо выйдет таймаут. Использует ядро УИ_Ожидания (неблокирующая пауза между попытками).
		// Команда: {action:wait, target:<элемент>, property:<Видимость|Доступность|Заголовок>,
		//          expected:<значение>, timeout:<сек, по умолчанию 5>}.
		Элемент = ЭтаФорма.Элементы.Найти(Команда.target);
		Если Элемент = Неопределено Тогда
			Шаг.status = "failed";
			Шаг.detail = "wait: элемент '" + Команда.target + "' не найден на форме";
		Иначе
			Свойство = ?(ПустаяСтрока(Команда.property), "Видимость", Команда.property);
			Ожидаемое = Строка(Команда.expected);
			Если ПустаяСтрока(Ожидаемое) Тогда
				Ожидаемое = "Истина";
			КонецЕсли;
			ТаймаутСек = 5;
			Попытка
				Если ЗначениеЗаполнено(Команда.timeout) Тогда
					ТаймаутСек = Число(Команда.timeout);
				КонецЕсли;
			Исключение
				// некорректный таймаут - оставляем 5
			КонецПопытки;

			КоличествоПопыток = Макс(1, Цел(ТаймаутСек / 0.2));
			Готово = Ложь;
			ФактПоследний = "";
			Для Итерация = 1 По КоличествоПопыток Цикл
				ФактПоследний = Строка(ПолучитьСвойствоЭлемента(Элемент, Свойство));
				Если ФактПоследний = Ожидаемое Тогда
					Готово = Истина;
					Прервать;
				КонецЕсли;
				OZON_UI_ОжиданияКлиент.Пауза(0.2);
			КонецЦикла;

			Шаг.status = ?(Готово, "passed", "failed");
			Шаг.detail = "wait property=" + Свойство
				+ " target='" + Команда.target + "'"
				+ " expected='" + Ожидаемое + "'"
				+ " done=" + Строка(Готово);
		КонецЕсли;
	Иначе
		Шаг.status = "failed";
		Шаг.detail = "unknown action '" + Действие + "'";

	КонецЕсли;

	Возврат Шаг;

КонецФункции

&НаКлиенте
Функция ПолучитьСвойствоЭлемента(Элемент, Свойство)

	Если Свойство = "Видимость" Тогда
		Возврат Элемент.Видимость;
	ИначеЕсли Свойство = "Доступность" Тогда
		Возврат Элемент.Доступность;
	ИначеЕсли Свойство = "Заголовок" Тогда
		Возврат Элемент.Заголовок;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// ========== Серверный слой: чтение командного файла и запись результата ==========
// Все пути строятся от КаталогаОбмена (передаётся аргументом из клиентского кода).

&НаСервереБезКонтекста
Функция ПрочитатьКомандыСНаСервера(КаталогОбмена)

	ПутьКоманд = ОбъединитьПути(КаталогОбмена, "bridge-commands.json");

	ЗаписатьДиагностику("read-enter " + ПутьКоманд, КаталогОбмена);

	Попытка
		Чтение = Новый ЧтениеТекста(ПутьКоманд, КодировкаТекста.UTF8);
		ТекстКоманд = Чтение.Прочитать();
		Чтение.Закрыть();

		ЗаписатьДиагностику("file-read-ok, length=" + Строка(СтрДлина(ТекстКоманд)), КаталогОбмена);

		Парсер = Новый ЧтениеJSON;
		Парсер.УстановитьСтроку(ТекстКоманд);
		Прочитанное = ПрочитатьJSON(Парсер, Ложь);
		Парсер.Закрыть();
	Исключение
		ЗаписатьДиагностику("read-exc: " + ОписаниеОшибки(), КаталогОбмена);
		ЗаписьЖурналаРегистрации("OZON_UI.MVP", УровеньЖурналаРегистрации.Предупреждение,,,
			"Файл команд не прочитан (" + ПутьКоманд + "): " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;

	Если ТипЗнч(Прочитанное) <> Тип("Структура") Тогда
		ЗаписатьДиагностику("read-not-structure: " + Строка(ТипЗнч(Прочитанное)), КаталогОбмена);
		Возврат Неопределено;
	КонецЕсли;

	Если Прочитанное.Свойство("runId") = Ложь ИЛИ Прочитанное.Свойство("commands") = Ложь Тогда
		ЗаписатьДиагностику("read-invalid-shape: нет runId/commands", КаталогОбмена);
		Возврат Неопределено;
	КонецЕсли;

	ЗаписатьДиагностику("read-ok-structure", КаталогОбмена);
	Возврат Прочитанное;

КонецФункции

&НаСервереБезКонтекста
// ---------------------------------------------------------------------
// Запуск конкретного тестового набора через мост (команда "runSet").

&НаКлиенте
Функция ЗапуститьНаборЧерезМост(Команда)
	ИмяТеста = ?(Команда.Свойство("test"), Строка(Команда.test), "");
	ИмяМодуля = Строка(Команда.target);

	// UI-наборы (OZON_UI_Тесты_*Карточка) НЕ гоняем серверным движком: сервер не умеет
	// открывать управляемую форму реального клиента. Их сценарий - спецификация команд
	// моста, которую исполняет агент на РЕАЛЬНОМ слое UI этой сессии (см. ниже). Добавленный
	// набор = новая строка здесь + диспетчер в OZON_UI_Тестирование.КаталогНаборов.
	Если ВРег(ИмяМодуля) = ВРег("OZON_UI_Тесты_КонтрагентыКарточка") Тогда
		Возврат ЗапуститьUIНаборКарточки(ИмяТеста);
	КонецЕсли;

	Возврат ЗапуститьНаборНаСервере(ИмяМодуля, ИмяТеста);
КонецФункции

// Запуск UI-набора карточки: разворачивает СценарийКарточки() в команды моста и исполняет
// их клиентским циклом ВыполнитьКоманду на реальном слое UI (та же сессия, пользователь
// api/1). Возвращает { Итог, Шаги } в формате, который ждёт runSet-контур моста.
&НаКлиенте
Функция ЗапуститьUIНаборКарточки(ИмяТеста)

	Результат = Новый Структура("Итог, Шаги", "failed", Новый Массив);
	СписокШагов = Результат.Шаги;

	// Отбор по имени конкретного теста (панель EDT может запустить один тест набора).
	Если НЕ ПустаяСтрока(ИмяТеста)
		И НРег(ИмяТеста) <> НРег("ОткрытьКарточкуЗаписатьИВыйти") Тогда
		СписокШагов.Добавить(Новый Структура("id, action, status, detail",
			"runSet", "runSet", "failed",
			"Тест набора не найден: " + ИмяТеста));
		Возврат Результат;
	КонецЕсли;

	// Сценарий отдаём серверным вызовом (чистые данные), исполняем на клиенте.
	Команды = OZON_UI_Тесты_КонтрагентыКарточка.СценарийКарточки();
	Для Каждого Команда Из Команды Цикл
		OZON_UI_ОжиданияКлиент.Проветриться();
		СписокШагов.Добавить(ВыполнитьКоманду(Команда));
	КонецЦикла;

	Итог = "passed";
	Для Каждого Шаг Из СписокШагов Цикл
		Если Шаг.status = "failed" Тогда
			Итог = "failed";
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Результат.Итог = Итог;
	Возврат Результат;

КонецФункции

&НаСервере
Функция ЗапуститьНаборНаСервере(ИмяМодуляНабора, ИмяТеста)

	Результат = Новый Структура("Итог, Шаги", "failed", Новый Массив);
	СписокШагов = Результат.Шаги;

	// Сопоставление ИмяМодуля набора -> ИмяНабора (ключ КаталогНаборов движка).
	ИмяНабора = "";
	Каталог = OZON_UI_Тестирование.КаталогНаборов();
	Для Каждого КЗ Из Каталог Цикл
		Если ВРег(Строка(КЗ.Значение.ИмяМодуля)) = ВРег(ИмяМодуляНабора) Тогда
			ИмяНабора = Строка(КЗ.Ключ);
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ПустаяСтрока(ИмяНабора) Тогда
		СписокШагов.Добавить(Новый Структура("id, action, status, detail",
			"runSet", "runSet", "failed",
			"Тестовый набор не найден по модулю " + ИмяМодуляНабора));
		Возврат Результат;
	КонецЕсли;

	Критерии = Новый Структура("Набор, ИмяТеста", ИмяНабора, ИмяТеста);
	Сводка = OZON_UI_Тестирование.Запустить(Критерии); // -> { Набор, Итог, Тесты:[{Имя,Статус,...}] }

	Провалено = 0;
	Для Каждого Тест Из Сводка.Тесты Цикл
		СтатусШага = "failed";
		Если Тест.Статус = OZON_UI_Тестирование.СтатусПройден() Тогда
			СтатусШага = "passed";
		Иначе
			Провалено = Провалено + 1;
		КонецЕсли;
		СписокШагов.Добавить(Новый Структура("id, action, status, detail",
			Строка(Тест.Имя), "test", СтатусШага,
			"[" + Строка(Тест.Статус) + "] " + Строка(Тест.Сообщение)));
	КонецЦикла;

	Результат.Итог = ?(Провалено > 0, "failed", "passed");
	Возврат Результат;

КонецФункции

Процедура ЗаписатьРезультатНаСервер(RunId, Итог, Шаги, КаталогОбмена)

	ПутьРезультата = ОбъединитьПути(КаталогОбмена, "bridge-result-" + RunId + ".json");

	Результат = Новый Структура;
	Результат.Вставить("runId", RunId);
	Результат.Вставить("status", Итог);
	Результат.Вставить("steps", Шаги);

	Поток = Новый ЗаписьJSON;
	Поток.УстановитьСтроку();
	ЗаписатьJSON(Поток, Результат);
	СтрокаJSON = Поток.Закрыть();

	// Атомарная публикация: сначала во временный файл в том же каталоге, затем переименование.
	ВременныйПуть = ОбъединитьПути(КаталогОбмена, "bridge-result-" + RunId + ".tmp");
	Текст = Новый ЗаписьТекста(ВременныйПуть, КодировкаТекста.UTF8);
	Текст.Записать(СтрокаJSON);
	Текст.Закрыть();
	ПереместитьФайл(ВременныйПуть, ПутьРезультата, Истина);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаписатьДиагностику(Сообщение, КаталогОбмена)

	Если ПустаяСтрока(КаталогОбмена) Тогда
		Возврат;
	КонецЕсли;

	ПутьЛога = ОбъединитьПути(КаталогОбмена, "bridge-log.txt");
	Попытка
		Запись = Новый ЗаписьТекста(ПутьЛога, КодировкаТекста.UTF8, Истина); // дописывать в конец
		Запись.ЗаписатьСтроку(Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy HH:mm:ss") + "  " + Сообщение);
		Запись.Закрыть();
	Исключение
		// диагностика не критична
	КонецПопытки;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ОбъединитьПути(БазовыйПуть, ИмяФайла)

	Разделитель = "\";
	Если СтрНайти(БазовыйПуть, "/") > 0 Тогда
		Разделитель = "/";
	КонецЕсли;
	Если Прав(БазовыйПуть, 1) = Разделитель Тогда
		Возврат БазовыйПуть + ИмяФайла;
	Иначе
		Возврат БазовыйПуть + Разделитель + ИмяФайла;
	КонецЕсли;

КонецФункции

// Сериализовать массив структур топологии в JSON-массив и записать в файл каталога обмена.
// Формат: [ { "Имя":.., "Тип":.., "Вид":.., "Видимость":.., "Доступность":..,
//             "Заголовок":.., "Родитель":.., "ЕстьКоманды":.., "Колонки":.. } ].
// Только метаданные элементов, БЕЗ значений данных — безопасно для EDT/MCP.
&НаКлиенте
Процедура ЗаписатьТопологиюJSON(ПутьФайла, Топология)

	Части = Новый Массив;
	Для Каждого Элемент Из Топология Цикл
		Части.Добавить(ЭлементВJSON(Элемент));
	КонецЦикла;

	Текст = "[" + СтрСоединить(Части, ",") + "]";

	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.УстановитьТекст(Текст);
	ТекстовыйДокумент.Записать(ПутьФайла, КодировкаТекста.UTF8);

КонецПроцедуры

// Структура -> JSON-объект (имена полей в кавычках, значения строки).
&НаКлиенте
Функция ЭлементВJSON(Структура)

	К = Символ(34); // кавычка "
	Части = Новый Массив;
	Части.Добавить(К + "Имя" + К + ":" + ЭкранироватьJSON(Строка(Структура.Имя)));
	Части.Добавить(К + "Тип" + К + ":" + ЭкранироватьJSON(Строка(Структура.Тип)));
	Части.Добавить(К + "Вид" + К + ":" + ЭкранироватьJSON(Строка(Структура.Вид)));
	Части.Добавить(К + "Видимость" + К + ":" + ЭкранироватьJSON(Строка(Структура.Видимость)));
	Части.Добавить(К + "Доступность" + К + ":" + ЭкранироватьJSON(Строка(Структура.Доступность)));
	Части.Добавить(К + "Заголовок" + К + ":" + ЭкранироватьJSON(Строка(Структура.Заголовок)));
	Части.Добавить(К + "Родитель" + К + ":" + ЭкранироватьJSON(Строка(Структура.Родитель)));
	Части.Добавить(К + "ЕстьКоманды" + К + ":" + ЭкранироватьJSON(Строка(Структура.ЕстьКоманды)));
	Если Структура.Свойство("Колонки") Тогда
		Части.Добавить(К + "Колонки" + К + ":" + ЭкранироватьJSON(Строка(Структура.Колонки)));
	КонецЕсли;

	Возврат "{" + СтрСоединить(Части, ",") + "}";

КонецФункции

// Экранировать строку для JSON (обратная косая, кавычка, переводы строк, табуляция).
&НаКлиенте
Функция ЭкранироватьJSON(Значение)

	К = Символ(34); // кавычка
	Результат = СтрЗаменить(Значение, "\", "\\");
	Результат = СтрЗаменить(Результат, К, "\" + К);
	Результат = СтрЗаменить(Результат, Символы.ПС, "\n");
	Результат = СтрЗаменить(Результат, Символы.ВК, "\r");
	Результат = СтрЗаменить(Результат, Символы.Таб, "\t");
	Возврат К + Результат + К;

КонецФункции
