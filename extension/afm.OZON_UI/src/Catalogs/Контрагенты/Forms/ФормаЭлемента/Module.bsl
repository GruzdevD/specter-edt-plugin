// =====================================================================
// Экспортный интерфейс карточки Контрагента (ФормаЭлемента) для моста ui-test-platform.
//
// Это НЕ самостоятельный агент и НЕ adopted-обработчик события: это набор &НаКлиенте
// экспортных процедур, которые вызываются агентом моста из ФормаСписка через
// открытую форму карточки (ПолучитьФорму(...).Открыть() → ФормаКарточки.<Метод>).
//
// Ограничение платформы: ВыполнитьКомандуФормы и доступ к Объект/Элементы формы доступны
// ТОЛЬКО в контексте её собственного модуля. Поэтому все UI-действия карточки выполнены
// здесь (реальный слой формы), а агент списка лишь диспетчеризует команды протокола сюда.
//
// Программный (programmatic) контур: изменение значения реквизита формы через
// Объект[Реквизит] и выполнение команды формы — это управление реальной формой 1С
// (не серверная подмена данных). Честно объявлено в capabilities адаптера
// (см. OZON_UI_ТестовыйКлиент.Возможности: setValue programmatic).
// =====================================================================

// Установить значение интерактивного реквизита формы (Объект[Реквизит]).
&НаКлиенте
Процедура УстановитьПоле(ИмяРеквизита, Значение) Экспорт

	Элемент = ОбщегоНазначенияКлиент.НайтиЭлементФормы(ИмяРеквизита);
	// Проверяем только существование и доступность элемента на РЕАЛЬНОМ слое UI:
	// управляемой форме не даём исключение без видимого элемента формы.
	Если Элемент = Неопределено ИЛИ Форма.Элементы.Найти(ИмяРеквизита) = Неопределено Тогда
		ПоказатьОшибку("Реквизит-элемент не найден на карточке: " + ИмяРеквизита);
		Возврат;
	КонецЕсли;

	Попытка
		Объект[ИмяРеквизита] = Значение;
	Исключение
		ПоказатьОшибку("Не удалось установить поле '" + ИмяРеквизита + "': " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Выполнить команду формы (например "Записать", "Записать и закрыть", "Закрыть").
&НаКлиенте
Процедура НажатьКоманду(ИмяКоманды) Экспорт

	// ВыполнитьКомандуФормы доступен в контексте этой формы и исполняет реальную команду.
	ВыполнитьКомандуФормы(ИмяКоманды);

КонецПроцедуры

// Прочитать значение реквизита формы (Объект[Реквизит]).
&НаКлиенте
Функция ПрочитатьПоле(ИмяРеквизита) Экспорт

	Если Объект.Свойство(ИмяРеквизита) Тогда
		Возврат Объект[ИмяРеквизита];
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

// Свойство РЕАЛЬНОГО элемента UI (Видимость / Доступность / Заголовок / Модифицированность).
&НаКлиенте
Функция СвойствоОбъекта(Имя, Свойство) Экспорт

	Если Свойство = "Модифицированность" Тогда
		Возврат ЭтоФорма.Модифицированность;
	КонецЕсли;

	Элемент = Элементы.Найти(Имя);
	Если Элемент = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Свойство = "Видимость" Тогда
		Возврат Элемент.Видимость;
	ИначеЕсли Свойство = "Доступность" Тогда
		Возврат Элемент.Доступность;
	ИначеЕсли Свойство = "Заголовок" Тогда
		Возврат Элемент.Заголовок;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Исследователь формы (роль УИ_Инспектор, Фаза 1): топология РЕАЛЬНОГО слоя управляемой
// формы делегируется общему модулю OZON_UI_ИнспекторКлиент. Собирается массив сериализуемых
// структур { Имя, Тип, Вид, Заголовок, Видимость, Доступность, Родитель, ЕстьКоманды } —
// только метаданные элементов, БЕЗ значений данных (безопасно наружу в EDT/MCP/мост).
&НаКлиенте
Функция СобратьТопологию() Экспорт

	Возврат OZON_UI_ИнспекторКлиент.СобратьТопологию(ЭтаФорма);

КонецФункции

// Вспомогательная: показать ошибку диалоговой панелью не требуется — для моста достаточно
// вернуть честный failure. Ошибки накапливаются в журнал регистрации.
#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПоказатьОшибку(Текст)

	// В мосте не показываем модальные окна пользователю; фиксируем в ЖР для диагностики.
	ЗаписатьВЖурнал(Текст);

КонецПроцедуры

&НаСервере
Процедура ЗаписатьВЖурнал(Текст)

	ЗаписьЖурналаРегистрации("OZON_UI.MVP.Карточка", УровеньЖурналаРегистрации.Предупреждение,,, Текст);

КонецПроцедуры

#КонецОбласти
