//©///////////////////////////////////////////////////////////////////////////©//
//  OZON_UI_Тестирование - расширение afm, ядро BSL-процесса (R2).
//
//  Обнаружение, отбор и запуск тестовых наборов по рабочему процессу в духе YAxUnit,
//  но БЕЗ .epf и без подмены YAxUnit: тесты живут в общих модулях расширения (наборах),
//  каждый набор реализует согласованный интерфейс из двух экспортируемых функций:
//    СписокТестов()                       -> Массив { Имя, Описание, Теги };
//    ЗапуститьНаборТестов(Критерии)       -> Массив результатов тестов (единая модель).
//  Движок держит КАТАЛОГ наборов (стандартный для поставляемой поставки: добавить набор
//  = добавить тест-модуль + строку в каталог и ветку диспетчера). Динамический вызов
//  процедур общего модуля по строковому имени платформа не гарантирует, поэтому вызов
//  набора выполняется явным диспетчером (детерминированно и проверяемо), а НЕ рефлексией.
//
//  АНТИ-МАСКИРОВКА (контракты §): результат теста несёт честный status из белого списка
//  (passed/failed/skipped/aborted); инфраструктурная ошибка набора НЕ превращается в
//  зелёный тест; assert-failure (OZON_UI_Утверждения.ASSERT_FAILED) классифицируется как
//  failed, сбои исполнения — как aborted, отбор по тегам пустой — как skipped.
//
//  НЕ хранит секретов (ADR-006). Директивы: Сервер.
//©///////////////////////////////////////////////////////////////////////////©//

#Область ПрограммныйИнтерфейс

// Белый список статусов (проекция контрактной модели RunState/step.status).
Функция СтатусПройден() Экспорт
	Возврат "passed";
КонецФункции

Функция СтатусПровален() Экспорт
	Возврат "failed";
КонецФункции

Функция СтатусПропущен() Экспорт
	Возврат "skipped";
КонецФункции

Функция СтатусПрерван() Экспорт
	Возврат "aborted";
КонецФункции

// Каталог наборов: Соответствие ИмяНабора -> Структура{ИмяМодуля, Описание}.
// ЕДИНАЯ точка расширения: добавить набор = новый общий модуль-набор + запись здесь + ветка
// в Служебный_ВызватьЗапускНабора.
Функция КаталогНаборов() Экспорт

	Каталог = Новый Соответствие;

	Каталог.Вставить("Контрагенты", Новый Структура(
		"ИмяМодуля, Описание",
		"OZON_UI_Тесты_Контрагенты",
		"UI/данные справочника Контрагенты: подготовка, генерация, проверка полей, очистка"));

	Каталог.Вставить("КонтрагентыКарточка", Новый Структура(
		"ИмяМодуля, Описание",
		"OZON_UI_Тесты_КонтрагентыКарточка",
		"UI-кейс карточки Контрагента мостом на реальном интерфейсе: открыть, изменить ИНН, Записать, закрыть"));

	Возврат Каталог;

КонецФункции

// Список имён наборов.
Функция СписокНаборов() Экспорт

	Каталог = КаталогНаборов();
	Имена = Новый Массив;
	Для Каждого КЗ Из Каталог Цикл
		Имена.Добавить(КЗ.Ключ);
	КонецЦикла;
	Возврат Имена;

КонецФункции

// Обнаружение тестов: массив { Набор, Имя, Описание, Теги } по всем наборам (или одному).
Функция СписокТестов(ИмяНабора = "") Экспорт

	Каталог = КаталогНаборов();
	Результат = Новый Массив;

	Для Каждого КЗ Из Каталог Цикл
		Если НЕ ПустаяСтрока(ИмяНабора) И НРег(ИмяНабора) <> НРег(Строка(КЗ.Ключ)) Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Тесты = Служебный_ПолучитьСписокТестов(КЗ.Значение.ИмяМодуля);
		Исключение
			// Проблема discovery набора — честно маркируем каждый его тест как помеху? Нет:
			// добавляем один маркер недоступного набора (не тихий пропуск discovery).
			Результат.Добавить(Новый Структура(
				"Набор, Имя, Описание, Теги, ОшибкаDiscovery",
				Строка(КЗ.Ключ), "", "Набор недоступен", Новый Массив,
				ОписаниеОшибки()));
			Продолжить;
		КонецПопытки;
		Для Каждого Тест Из Тесты Цикл
			СтруктураТеста = Новый Структура(
				"Набор, Имя, Описание, Теги, ОшибкаDiscovery",
				Строка(КЗ.Ключ), Тест.Имя, ?(Тест.Свойство("Описание"), Тест.Описание, ""),
				?(Тест.Свойство("Теги"), Тест.Теги, Новый Массив), "");
			Результат.Добавить(СтруктураТеста);
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Запустить набор (или все наборы) с отбором по тегам. Критерии: { Набор?, Теги?, ИмяТеста? }.
// Возвращает { Набор, Итог, Тесты } где Тесты — массив результатов (единая модель).
Функция Запустить(Критерии = Неопределено) Экспорт

	ИмяНабора = ЗначениеКритерия(Критерии, "Набор", "");
	ОтборТегов = ЗначениеКритерия(Критерии, "Теги", "");
	ИмяКонкретногоТеста = ЗначениеКритерия(Критерии, "ИмяТеста", "");

	Каталог = КаталогНаборов();
	Сводка = Новый Структура("Набор, Итог, Тесты", ИмяНабора, СтатусПройден(), Новый Массив);

	Для Каждого КЗ Из Каталог Цикл
		Если НЕ ПустаяСтрока(ИмяНабора) И НРег(ИмяНабора) <> НРег(Строка(КЗ.Ключ)) Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			РезультатыНабора = Служебный_ВызватьЗапускНабора(
				КЗ.Значение.ИмяМодуля, ОтборТегов, ИмяКонкретногоТеста);
		Исключение
			// Инфраструктурная ошибка [набора/ВСЕГО прогона] => aborted, НЕ зелёный.
			Прерван = Новый Структура(
				"Имя, Статус, Сообщение, ДлительностьМс, События, Ошибка",
				КЗ.Ключ, СтатусПрерван(),
				"Сбой исполнения набора: " + ОписаниеОшибки(), 0, Новый Массив, ОписаниеОшибки());
			РезультатыНабора = Новый Массив;
			РезультатыНабора.Добавить(Прерван);
		КонецПопытки;

		Для Каждого Рез Из РезультатыНабора Цикл
			Сводка.Тесты.Добавить(Рез);
			Если Рез.Статус = СтатусПровален() ИЛИ Рез.Статус = СтатусПрерван() Тогда
				Сводка.Итог = СтатусПровален();
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Сводка;

КонецФункции

// Компактный отчёт прогона в виде структуры для сериализации (без циклических объектов).
Функция СформироватьОтчёт(Сводка) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("status", Сводка.Итог);
	Результат.Вставить("tests", Новый Массив);

	Для Каждого Тест Из Сводка.Тесты Цикл
		Запись = Новый Структура(
			"name, status, durationMs, message, error",
			Тест.Имя, Тест.Статус, Тест.ДлительностьМс, ОбъединитьСообщения(Тест), Тест.Ошибка);
		Результат.Вставить("tests", Служебный_ДобавитьВМассив(Результат.tests, Запись));
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Единый диспетчер вызова набора. НАБОРЫ ЗАРЕГИСТРИРОВАНЫ ЗДЕСЬ (см. КаталогНаборов).
Функция Служебный_ВызватьЗапускНабора(ИмяМодуля, ОтборТегов, ИмяКонкретногоТеста)

	Если НРег(ИмяМодуля) = НРег("OZON_UI_Тесты_Контрагенты") Тогда
		Критерии = Новый Структура("Теги, ИмяТеста", ОтборТегов, ИмяКонкретногоТеста);
		Возврат OZON_UI_Тесты_Контрагенты.ЗапуститьНаборТестов(Критерии);
	ИначеЕсли НРег(ИмяМодуля) = НРег("OZON_UI_Тесты_КонтрагентыКарточка") Тогда
		// UI-набор: серверный движок форму не откроет, поэтому прогон не передаём сюда -
		// его перехватывает агент моста на клиенте (см. ФормаСписка.ЗапуститьUIНаборКарточки).
		// Здесь - честный ответ для не-мостового вызова (панель/консоль гоняет через агент,
		// этот диспетчер вызывается только при прямом серверном Запустить()).
		Критерии = Новый Структура("Теги, ИмяТеста", ОтборТегов, ИмяКонкретногоТеста);
		Возврат OZON_UI_Тесты_КонтрагентыКарточка.ЗапуститьНаборТестов(Критерии);
	Иначе
		ВызватьИсключение "Неизвестный модуль набора тестов: " + ИмяМодуля;
	КонецЕсли;

КонецФункции

Функция Служебный_ПолучитьСписокТестов(ИмяМодуля)

	Если НРег(ИмяМодуля) = НРег("OZON_UI_Тесты_Контрагенты") Тогда
		Возврат OZON_UI_Тесты_Контрагенты.СписокТестов();
	ИначеЕсли НРег(ИмяМодуля) = НРег("OZON_UI_Тесты_КонтрагентыКарточка") Тогда
		Возврат OZON_UI_Тесты_КонтрагентыКарточка.СписокТестов();
	Иначе
		ВызватьИсключение "Неизвестный модуль набора тестов: " + ИмяМодуля;
	КонецЕсли;

КонецФункции

// Значение критерия запуска из структуры (с учётом пустых/отсутствующих).
Функция ЗначениеКритерия(Критерии, Ключ, ПоУмолчанию = "")

	Если ЗначениеЗаполнено(Критерии) И Критерии.Свойство(Ключ) Тогда
		Значение = Критерии[Ключ];
		Если ЗначениеЗаполнено(Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;
	Возврат ПоУмолчанию;

КонецФункции

// Собрать человекочитаемое сообщение результата (message + ошибка) для отчёта.
Функция ОбъединитьСообщения(Тест)

	Текст = "";
	Если Тест.Свойство("Сообщение") И НЕ ПустаяСтрока(Тест.Сообщение) Тогда
		Текст = Тест.Сообщение;
	КонецЕсли;
	Если Тест.Свойство("Ошибка") И НЕ ПустаяСтрока(Тест.Ошибка) Тогда
		Если НЕ ПустаяСтрока(Текст) Тогда
			Текст = Текст + " | ";
		КонецЕсли;
		Текст = Текст + Тест.Ошибка;
	КонецЕсли;
	Возврат Текст;

КонецФункции

Функция Служебный_ДобавитьВМассив(Массив, Элемент)

	Массив.Добавить(Элемент);
	Возврат Массив;

КонецФункции

#КонецОбласти
