//  OZON_UI_ИнспекторКлиент - расширение afm, роль УИ_Инспектор (R4, Фаза 1 CFE-core).
//
//  Сбор топологии РЕАЛЬНОГО слоя любой управляемой формы в массив сериализуемых
//  структур { Имя, Тип, Вид, Заголовок, Видимость, Доступность, Родитель,
//  ЕстьКоманды, Колонки(для ТаблицаФормы) }.
//
//  Только метаданные элементов - БЕЗ значений реквизитов/данных, чтобы JSON-карту
//  окна можно было безопасно передать наружу (в EDT/MCP/мост) как "карту окна"
//  и использовать для навигации/диагностики (аналог Vanessa-исследования формы).
//
//  Клиентский модуль: инспектируемая форма живёт только в контексте тонкого клиента.
//©///////////////////////////////////////////////////////////////////////////©//

#Область ПрограммныйИнтерфейс

// Собрать топологию формы: массив структур по каждому элементу (один уровень).
// Форма - открытая управляемая форма (ЭтаФорма / ПолучитьФорму(...).Открыть()).
&НаКлиенте
Функция СобратьТопологию(Форма) Экспорт

	ЭлементыМассива = Новый Массив;

	Для Каждого Элемент Из Форма.Элементы Цикл

		СтрокаЭлемента = Новый Структура;
		СтрокаЭлемента.Вставить("Имя", Элемент.Имя);
		СтрокаЭлемента.Вставить("Тип", Строка(ТипЗнч(Элемент)));
		СтрокаЭлемента.Вставить("Вид", Строка(ВидЭлемента(Элемент)));
		СтрокаЭлемента.Вставить("Видимость", СвойствоЭлементаБезопасно(Элемент, "Видимость", Ложь));
		СтрокаЭлемента.Вставить("Доступность", СвойствоЭлементаБезопасно(Элемент, "Доступность", Ложь));
		СтрокаЭлемента.Вставить("Заголовок", СвойствоЭлементаБезопасно(Элемент, "Заголовок", ""));
		СтрокаЭлемента.Вставить("Родитель", ИмяРодителя(Элемент));
		СтрокаЭлемента.Вставить("ЕстьКоманды", Ложь);

		// Для табличных элементов зафиксируем число колонок (без содержимого).
		Если ТипЗнч(Элемент) = Тип("ТаблицаФормы") Тогда
			Колонки = Новый Массив;
			Для Каждого Колонка Из Элемент.Колонки Цикл
				Колонки.Добавить(Колонка.Имя);
			КонецЦикла;
			СтрокаЭлемента.Вставить("Колонки", СтрСоединить(Колонки, ", "));
		КонецЕсли;

		ЭлементыМассива.Добавить(СтрокаЭлемента);

	КонецЦикла;

	Возврат ЭлементыМассива;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Видовой объект элемента формы (имя вида в управляемой форме), безопасно.
&НаКлиенте
Функция ВидЭлемента(Элемент)

	Попытка
		Возврат Элемент.Вид;
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

// Свойство элемента формы через безопасное чтение (не у всех видов есть все поля).
&НаКлиенте
Функция СвойствоЭлементаБезопасно(Элемент, ИмяСвойства, ПоУмолчанию)

	Если Элемент = Неопределено Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Попытка
		Возврат Элемент[ИмяСвойства];
	Исключение
		Возврат ПоУмолчанию;
	КонецПопытки;

КонецФункции

// Имя родительского элемента (пустая строка, если корневой/недоступно).
&НаКлиенте
Функция ИмяРодителя(Элемент)

	Попытка
		Родитель = Элемент.Родитель;
		Если Родитель <> Неопределено Тогда
			Возврат Родитель.Имя;
		КонецЕсли;
	Исключение
		// у некоторых видов родитель недоступен - молчим
	КонецПопытки;
	Возврат "";

КонецФункции

#КонецОбласти
