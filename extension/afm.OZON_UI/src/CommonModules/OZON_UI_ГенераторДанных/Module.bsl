//©///////////////////////////////////////////////////////////////////////////©//
//  OZON_UI_ГенераторДанных - расширение afm, API тестов (R3, генерация тестовых данных).
//
//  Генератор случайных (валидных по формату и контрольным суммам) персональных и
//  реквизитных данных: ИНН (10 — юр., 12 — физ.), КПП, ОГРН, СНИЛС, ФИО, e-mail,
//  телефон. Включён по согласованному объёму матрицы (§E.3, рубеж R3).
//
//  Контрольные суммы — по официальным алгоритмам (ФНС/ЦБ РФ):
//   - ИНН-10: контрольная = (СУММА цифр[1..9] * веса[2,4,10,3,5,9,4,6,8]) mod 11, остаток 10 => 0;
//   - ИНН-12: 11-я = (...)*веса[7,2,4,10,3,5,9,4,6,8] mod 11; 12-я = (...)*веса[3,7,2,4,10,3,5,9,4,6,8] mod 11;
//   - ОГРН: контрольная = (первые 12 цифр как число) mod 11, остаток 10 => 0;
//   - СНИЛС: контрольное = СУММА цифр[1..9] * веса[9..1] mod 101; 100/101 => 00 (не контрольная);
//   - КПП: 9 цифр, первые 2 — код региона (77 = Москва), формат без контрольной.
//
//  Каждая генерация возвращает СТРОКУ; где требуется число — используйте
//  Число(). НЕ хранит секретов (ADR-006). Директивы: Сервер.
//©///////////////////////////////////////////////////////////////////////////©//

#Область ПрограммныйИнтерфейс

// Сгенерировать ИНН. ФизЛицо = Ложь (по умолчанию) — ИНН-10 (юр.); Истина — ИНН-12 (физ.).
Функция СгенерироватьИНН(ФизЛицо = Ложь) Экспорт

	Если ФизЛицо Тогда
		Основа = "";
		Для Сч = 1 По 10 Цикл
			Основа = Основа + СлучайнаяЦифра();
		КонецЦикла;
		К11 = КонтрольнаяСумма(Основа, ВесаИНН12Первая());
		К12 = КонтрольнаяСумма(Основа + Строка(К11), ВесаИНН12Вторая());
		Возврат Основа + Строка(К11) + Строка(К12);
	Иначе
		Основа = "";
		Для Сч = 1 По 9 Цикл
			Основа = Основа + СлучайнаяЦифра();
		КонецЦикла;
		К10 = КонтрольнаяСумма(Основа, ВесаИНН10());
		Возврат Основа + Строка(К10);
	КонецЕсли;

КонецФункции

// Сгенерировать КПП (9 цифр; первые 2 — код региона).
Функция СгенерироватьКПП() Экспорт

	// Фиксируем регион 77 (Москва), остальные 7 цифр — случайные серия+номер.
	КПП = "77";
	Для Сч = 1 По 7 Цикл
		КПП = КПП + СлучайнаяЦифра();
	КонецЦикла;
	Возврат КПП;

КонецФункции

// Сгенерировать ОГРН (13 цифр, контрольная по mod 11).
Функция СгенерироватьОГРН() Экспорт

	Основа = "";
	Для Сч = 1 По 12 Цикл
		Основа = Основа + СлучайнаяЦифра();
	КонецЦикла;
	// Контрольная: остаток от деления числа из 12 цифр на 11; 10 => 0.
	ЧислоОснова = Число(Основа);
	Контр = ЧислоОснова % 11;
	Если Контр = 10 Тогда
		Контр = 0;
	КонецЕсли;
	Возврат Основа + Строка(Контр);

КонецФункции

// Сгенерировать СНИЛС (11 цифр; первые 9 — номер, последние 2 — контрольные).
Функция СгенерироватьСНИЛС() Экспорт

	Номер = "";
	Для Сч = 1 По 9 Цикл
		Номер = Номер + СлучайнаяЦифра();
	КонецЦикла;

	// Контрольное число: СУММА цифра[i] * вес[i], веса от 9 до 1, mod 101.
	Сумма = 0;
	Для Сч = 1 По 9 Цикл
		Сумма = Сумма + Число(Сред(Номер, Сч, 1)) * (10 - Сч);
	КонецЦикла;
	Контр = Сумма % 101;
	Если Контр = 100 ИЛИ Контр = 101 Тогда
		Контр = 0;
	КонецЕсли;
	// Два знака всегда: 05, 12...
	КонтрСтр = Строка(Контр);
	Если СтрДлина(КонтрСтр) = 1 Тогда
		КонтрСтр = "0" + КонтрСтр;
	КонецЕсли;

	Возврат Номер + КонтрСтр;

КонецФункции

// Сгенерировать ФИО. Пол = "М"|"Ж" (по умолчанию случайный).
Функция СгенерироватьФИО(Пол = "") Экспорт

	Если НЕ (Пол = "М" ИЛИ Пол = "Ж") Тогда
		Пол = ?(СлучайноеЧислоВДиапазоне(0, 1) = 0, "М", "Ж");
	КонецЕсли;

	Если Пол = "М" Тогда
		Имя = МассивСлучайный(МужскиеИмена());
		Отчество = МассивСлучайный(МужскиеОтчества());
		Фамилия = МассивСлучайный(МужскиеФамилии());
	Иначе
		Имя = МассивСлучайный(ЖенскиеИмена());
		Отчество = МассивСлучайный(ЖенскиеОтчества());
		Фамилия = МассивСлучайный(ЖенскиеФамилии());
	КонецЕсли;

	Возврат Фамилия + " " + Имя + " " + Отчество;

КонецФункции

// Сгенерировать e-mail (латиница, валидная маска).
Функция СгенерироватьEmail() Экспорт

	Логин = СгенерироватьЛогин(10);
	Домены = Новый Массив;
	Домены.Добавить("test.ru");
	Домены.Добавить("example.com");
	Домены.Добавить("mail.test");
	Возврат НРег(Логин) + "@" + МассивСлучайный(Домены);

КонецФункции

// Сгенерировать телефонный номер в международном формате (11 цифр, 7-й федеральный).
Функция СгенерироватьТелефон() Экспорт

	Телефон = "7";
	Для Сч = 1 По 10 Цикл
		Телефон = Телефон + СлучайнаяЦифра();
	КонецЦикла;
	Возврат Телефон;

КонецФункции

// Сгенерировать «паспорт» (серия 4 + номер 6, только цифры) — без контрольной.
Функция СгенерироватьСерияНомерПаспорта() Экспорт

	Серия = "";
	Для Сч = 1 По 4 Цикл
		Серия = Серия + СлучайнаяЦифра();
	КонецЦикла;
	Номер = "";
	Для Сч = 1 По 6 Цикл
		Номер = Номер + СлучайнаяЦифра();
	КонецЦикла;
	Возврат Серия + " " + Номер;

КонецФункции

// Пакетная генерация данных контрагента. Параметры: { ФизЛицо?, Пол?, ЗаполнитьВсе? }.
// Возвращает структуру готовых значений (строки/числа).
Функция СгенерироватьКонтрагента(Параметры = Неопределено) Экспорт

	ФизЛицо = Ложь;
	Пол = "";
	ЗаполнитьВсе = Истина;
	Если ЗначениеЗаполнено(Параметры) И ТипЗнч(Параметры) = Тип("Структура") Тогда
		Если Параметры.Свойство("ФизЛицо") Тогда
			ФизЛицо = Параметры["ФизЛицо"];
		КонецЕсли;
		Если Параметры.Свойство("Пол") Тогда
			Пол = Строка(Параметры["Пол"]);
		КонецЕсли;
		Если Параметры.Свойство("ЗаполнитьВсе") Тогда
			ЗаполнитьВсе = Параметры["ЗаполнитьВсе"];
		КонецЕсли;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("ФизЛицо", ФизЛицо);
	Результат.Вставить("ИНН", СгенерироватьИНН(ФизЛицо));
	Результат.Вставить("КПП", ?(ФизЛицо, "", СгенерироватьКПП()));
	Результат.Вставить("ОГРН", ?(ФизЛицо, "", СгенерироватьОГРН()));
	Результат.Вставить("ФИО", СгенерироватьФИО(Пол));
	Результат.Вставить("Email", СгенерироватьEmail());
	Результат.Вставить("Телефон", СгенерироватьТелефон());

	Если ЗаполнитьВсе Тогда
		// Имя пользователя для логина (кириллица не подходит — используем транслит ФИО).
		Результат.Вставить("ДатаРождения", СгенерироватьДатуРождения());
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// ГСЧ на уровне модуля (инициализируется один раз).
Перем ГСЧ;

Функция ПолучитьГСЧ()

	Если ГСЧ = Неопределено Тогда
		ГСЧ = Новый ГенераторСлучайныхЧисел;
	КонецЕсли;
	Возврат ГСЧ;

КонецФункции

// Случайная цифра 0..9 (символ строки).
Функция СлучайнаяЦифра()

	Возврат Строка(СлучайноеЧислоВДиапазоне(0, 9));

КонецФункции

// Случайное целое в диапазоне [Нижняя, Верхняя] (включительно).
Функция СлучайноеЧислоВДиапазоне(Нижняя, Верхняя)

	Возврат ПолучитьГСЧ().СлучайноеЧисло(Нижняя, Верхняя);

КонецФункции

// Случайный элемент массива.
Функция МассивСлучайный(Массив)

	Если Массив.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Индекс = СлучайноеЧислоВДиапазоне(0, Массив.Количество() - 1);
	Возврат Массив[Индекс];

КонецФункции

// Контрольная сумма ИНН: СУММА цифр[i]*вес[i] по массиву весов, mod 11, остаток 10 => 0.
Функция КонтрольнаяСумма(СтрокаЦифр, Веса)

	Сумма = 0;
	Для Сч = 1 По СтрДлина(СтрокаЦифр) Цикл
		Сумма = Сумма + Число(Сред(СтрокаЦифр, Сч, 1)) * Веса[Сч - 1];
	КонецЦикла;
	Контр = Сумма % 11;
	Если Контр = 10 Тогда
		Контр = 0;
	КонецЕсли;
	Возврат Контр;

КонецФункции

Функция ВесаИНН10()
	Веса = Новый Массив;
	Веса.Добавить(2); Веса.Добавить(4); Веса.Добавить(10); Веса.Добавить(3);
	Веса.Добавить(5); Веса.Добавить(9); Веса.Добавить(4); Веса.Добавить(6); Веса.Добавить(8);
	Возврат Веса;
КонецФункции

Функция ВесаИНН12Первая()
	Веса = Новый Массив;
	Веса.Добавить(7); Веса.Добавить(2); Веса.Добавить(4); Веса.Добавить(10);
	Веса.Добавить(3); Веса.Добавить(5); Веса.Добавить(9); Веса.Добавить(4); Веса.Добавить(6); Веса.Добавить(8);
	Возврат Веса;
КонецФункции

Функция ВесаИНН12Вторая()
	Веса = Новый Массив;
	Веса.Добавить(3); Веса.Добавить(7); Веса.Добавить(2); Веса.Добавить(4); Веса.Добавить(10);
	Веса.Добавить(3); Веса.Добавить(5); Веса.Добавить(9); Веса.Добавить(4); Веса.Добавить(6); Веса.Добавить(8);
	Возврат Веса;
КонецФункции

// Дата рождения: 18..65 лет от текущей даты.
Функция СгенерироватьДатуРождения()

	Текущая = ТекущаяДата();
	Год = Текущая.Год - СлучайноеЧислоВДиапазоне(18, 65);
	Месяц = СлучайноеЧислоВДиапазоне(1, 12);
	День = СлучайноеЧислоВДиапазоне(1, 28);
	Возврат Дата(Год, Месяц, День);

КонецФункции

// Случайный логин из латинских букв/цифр заданной длины.
Функция СгенерироватьЛогин(Длина)

	Алфавит = "abcdefghijklmnopqrstuvwxyz0123456789";
	Результат = "";
	Для Сч = 1 По Длина Цикл
		Позиция = СлучайноеЧислоВДиапазоне(1, СтрДлина(Алфавит));
		Результат = Результат + Сред(Алфавит, Позиция, 1);
	КонецЦикла;
	Возврат Результат;

КонецФункции

