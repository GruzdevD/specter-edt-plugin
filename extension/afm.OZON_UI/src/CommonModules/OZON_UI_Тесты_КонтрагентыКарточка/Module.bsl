//©///////////////////////////////////////////////////////////////////////////©//
//  OZON_UI_Тесты_КонтрагентыКарточка - расширение afm, UI-тест карточки (R1/R3).
//
//  ОТДЕЛЬНЫЙ набор, специфицирующий UI-сценарий «открыть карточку Контрагента,
//  изменить ИНН, нажать Записать, убедиться что форма не модифицирована, закрыть».
//  В отличие от data-наборов (OZON_UI_Тесты_Контрагенты), этот набор НЕ исполняется
//  серверным движком: сервер не умеет открывать управляемую форму реального клиента.
//  Вместо этого сценарий задаётся КАК МАССИВ КОМАНД МОСТА (канонический протокол
//  UiProtocol, см. агент ФормаСписка), который пошагово исполняет агент моста на
//  реальном слое UI нашей же сессии (пользователь api/1).
//
//  Поток запуска (панель Тесты EDT / запуск набора из редактора / мост):
//    agent.ЗапуститьНаборЧерезМост -> команда runSet {target: этот модуль}
//      -> агент видит UI-набор по имени и вызывает СценарийКарточки()
//      -> исполняет команды клиентским циклом ВыполнитьКоманду (реальный UI)
//      -> пишет bridge-result-<runId>.json (шаги теста + итог).
//
//  Реализует интерфейс набора движка OZON_UI_Тестирование:
//    СписокТестов()            -> Массив { Имя, Описание, Теги };
//    ЗапуститьНаборТестов(...) -> честный результат (серверный вызов формы невозможен,
//                                  поэтому возвращает aborted-оговорку; реальный прогон - мост).
//  Директивы: Сервер (данные сценария отдаём клиенту серверным вызовом).
//©///////////////////////////////////////////////////////////////////////////©//

#Область ПрограммныйИнтерфейс

// Обнаружение: список тестов набора.
Функция СписокТестов() Экспорт

	Тесты = Новый Массив;

	Тесты.Добавить(Новый Структура("Имя, Описание, Теги",
		"ОткрытьКарточкуЗаписатьИВыйти",
		"UI-кейс: войти (api/1), открыть список Контрагентов, открыть карточку, "
			+ "изменить ИНН, нажать «Записать», проверить что форма не модифицирована, закрыть",
		СписокТегов("ui,карточка,справочник")));

	Возврат Тесты;

КонецФункции

// Сценарий карточки как массив команд моста (единый канон R1). Исполняется агентом
// ФормаСписка на реальном слое UI (см. ВыполнитьКоманду). Возврат с клиента — серверный
// вызов (чистые данные, без UI).
Функция СценарийКарточки() Экспорт

	Команды = Новый Массив;

	Команды.Добавить(Новый Структура("id, action, target",
		"c1", "openList", "Список"));
	Команды.Добавить(Новый Структура("id, action, target",
		"c2", "openCard", "Справочник.Контрагенты.ФормаЭлемента"));
	Команды.Добавить(Новый Структура("id, action, target, value",
		"c3", "setValue", "ИНН", "7701234567"));
	Команды.Добавить(Новый Структура("id, action, target, expected",
		"c4", "assertValue", "ИНН", "7701234567"));
	Команды.Добавить(Новый Структура("id, action, target, kind",
		"c5", "click", "Записать", "command"));
	Команды.Добавить(Новый Структура("id, action, subject, target, property, expected",
		"c6", "assert", "card", "Форма", "Модифицированность", "false"));
	Команды.Добавить(Новый Структура("id, action, target, kind",
		"c7", "click", "Закрыть", "command"));

	Возврат Команды;

КонецФункции

// Запуск набора. Критерии: { ИмяТеста? }. Реальный UI-прогон невозможен серверно
// (форма клиента не открывается), поэтому честно помечаем набор как aborted с пояснением:
// исполнять нужно через мост/панель EDT, где агент разворачивает СценарийКарточки().
Функция ЗапуститьНаборТестов(Критерии = Неопределено) Экспорт

	Результаты = Новый Массив;

	ИмяТеста = ЗначениеКритерия(Критерии, "ИмяТеста", "");
	Если ПустаяСтрока(ИмяТеста) Тогда
		ИмяТеста = "ОткрытьКарточкуЗаписатьИВыйти";
	КонецЕсли;

	// Честная классификация: это НЕ зеленый тест и не «неизвестный набор» - это
	// инфраструктурная особенность (серверный вызов не умеет открывать форму).
	Результаты.Добавить(Новый Структура("Имя, Статус, Сообщение, ДлительностьМс, События, Ошибка",
		ИмяТеста, OZON_UI_Тестирование.СтатусПрерван(),
		"UI-набор исполняется мостом на реальном интерфейсе (запустите через панель Тесты EDT / мост), не серверным вызовом",
		0, Новый Массив,
		"Серверный прогон UI-набора не выполняется: реальная форма недоступна с сервера"));

	Возврат Результаты;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Значение критерия запуска из структуры (с учётом пустых/отсутствующих).
Функция ЗначениеКритерия(Критерии, Ключ, ПоУмолчанию = "")

	Если ЗначениеЗаполнено(Критерии) И Критерии.Свойство(Ключ) Тогда
		Значение = Критерии[Ключ];
		Если ЗначениеЗаполнено(Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;
	Возврат ПоУмолчанию;

КонецФункции

Функция СписокТегов(СтрокаТегов)

	Если ПустаяСтрока(СтрокаТегов) Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Возврат СтрРазделить(СтрокаТегов, ",", Ложь);

КонецФункции

#КонецОбласти
