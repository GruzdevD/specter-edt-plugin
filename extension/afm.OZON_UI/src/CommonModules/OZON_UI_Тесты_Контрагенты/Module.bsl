//©///////////////////////////////////////////////////////////////////////////©//
//  OZON_UI_Тесты_Контрагенты - расширение afm, тестовый набор (R2, BSL-процесс).
//
//  Эталонный набор тестов данных/логики справочника Контрагенты в стиле YAxUnit-набора,
//  но БЕЗ .epf и БЕЗ подмены типовых библиотек. Реализует интерфейс набора, который
//  ожидает движок OZON_UI_Тестирование:
//    СписокТестов()            -> Массив { Имя, Описание, Теги };
//    ЗапуститьНаборТестов(Криметрии) -> Массив результатов { Имя, Статус, Сообщение,
//                                       ДлительностьМс, События, Ошибка }.
//  Проверки построены на assert-библиотеке OZON_UI_Утверждения (типизированное сравнение,
//  диагностика mismatch) и на генераторе OZON_UI_ГенераторДанных (валидные контрольные суммы).
//
//  Директивы: Сервер.
//©///////////////////////////////////////////////////////////////////////////©//

#Область ПрограммныйИнтерфейс

// Обнаружение: список тестов набора.
Функция СписокТестов() Экспорт

	Тесты = Новый Массив;

	Тесты.Добавить(Новый Структура("Имя, Описание, Теги",
		"ИННЮридическогоВалиден", "Сгенерированный ИНН юр. лица корректен по контрольной сумме (10 цифр)",
		СписокТегов("")));

	Тесты.Добавить(Новый Структура("Имя, Описание, Теги",
		"ИННФизическогоВалиден", "Сгенерированный ИНН физ. лица корректен по контрольным суммам (12 цифр)",
		СписокТегов("данные,генерация")));

	Тесты.Добавить(Новый Структура("Имя, Описание, Теги",
		"СНИЛСВалиден", "Сгенерированный СНИЛС корректен по контрольному числу",
		СписокТегов("данные,генерация")));

	Тесты.Добавить(Новый Структура("Имя, Описание, Теги",
		"НаборПолейКонтрагентаЗаполнен", "Генератор контрагента заполняет согласованный набор полей",
		СписокТегов("данные")));

	Тесты.Добавить(Новый Структура("Имя, Описание, Теги",
		"УтверждениеРавенстваТипизировано", "assert-библиотека корректно различает типы (числа/строки/булево)",
		СписокТегов("единицы")));

	Возврат Тесты;

КонецФункции

// Запуск набора. Критерии: { Теги?, ИмяТеста? }. Возвращает массив результатов тестов.
Функция ЗапуститьНаборТестов(Критерии = Неопределено) Экспорт

	Результаты = Новый Массив;

	Для Каждого Описание Из СписокТестов() Цикл
		Если НЕ ТестОтобран(Описание, Критерии) Тогда
			Продолжить;
		КонецЕсли;
		Результаты.Добавить(ЗапуститьОдин(Описание.Имя));
	КонецЦикла;

	Возврат Результаты;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Отбор теста по критериям {Теги, ИмяТеста}: по конкретному имени или пересечению тегов.
Функция ТестОтобран(ОписаниеТеста, Критерии)

	ИмяТеста = "";
	Теги = "";
	Если ЗначениеЗаполнено(Критерии) Тогда
		Если Критерии.Свойство("ИмяТеста") Тогда
			ИмяТеста = НРег(Строка(Критерии["ИмяТеста"]));
		КонецЕсли;
		Если Критерии.Свойство("Теги") Тогда
			Теги = НРег(Строка(Критерии["Теги"]));
		КонецЕсли;
	КонецЕсли;

	Если НЕ ПустаяСтрока(ИмяТеста) Тогда
		Возврат НРег(ОписаниеТеста.Имя) = ИмяТеста;
	КонецЕсли;

	Если ПустаяСтрока(Теги) Тогда
		Возврат Истина;
	КонецЕсли;

	// Пересечение: тест подходит, если все перечисленные теги (через ,) присутствуют у теста.
	МассивТегов = СтрРазделить(Теги, ",", Ложь);
	ВсеПопали = Истина;
	ТегиТеста = Строка(ОписаниеТеста.Теги);
	Для Каждого Тег Из МассивТегов Цикл
		Если СтрНайти(НРег("," + ТегиТеста + ","), "," + НРег(Тег) + ",") = 0 Тогда
			ВсеПопали = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат ВсеПопали;

КонецФункции

// Выполнить один тест по имени, классифицировать исход (честно, без маскировки).
Функция ЗапуститьОдин(ИмяТеста)

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	События = Новый Массив;

	Попытка

		Если ИмяТеста = "ИННЮридическогоВалиден" Тогда
			ВыполнитьТестИННЮР(События);
		ИначеЕсли ИмяТеста = "ИННФизическогоВалиден" Тогда
			ВыполнитьТестИННФиз(События);
		ИначеЕсли ИмяТеста = "СНИЛСВалиден" Тогда
			ВыполнитьТестСНИЛС(События);
		ИначеЕсли ИмяТеста = "НаборПолейКонтрагентаЗаполнен" Тогда
			ВыполнитьТестНаборПолей(События);
		ИначеЕсли ИмяТеста = "УтверждениеРавенстваТипизировано" Тогда
			ВыполнитьТестТипизированноеРавенство(События);
		Иначе
			ВызватьИсключение "Неизвестный тест набора: " + ИмяТеста;
		КонецЕсли;

		Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
		Возврат Новый Структура("Имя, Статус, Сообщение, ДлительностьМс, События, Ошибка",
			ИмяТеста, OZON_UI_Тестирование.СтатусПройден(), "OK", Длительность, События, "");

	Исключение

		Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
		ТекстОшибки = ОписаниеОшибки();

		Если СтрНайти(ТекстОшибки, OZON_UI_Утверждения.КодОшибкиУтверждения()) > 0 Тогда
			Статус = OZON_UI_Тестирование.СтатусПровален();
		Иначе
			Статус = OZON_UI_Тестирование.СтатусПрерван(); // инфраструктурный сбой != зелёный
		КонецЕсли;

		Возврат Новый Структура("Имя, Статус, Сообщение, ДлительностьМс, События, Ошибка",
			ИмяТеста, Статус, "Тест завершился с ошибкой", Длительность, События, ТекстОшибки);

	КонецПопытки;

КонецФункции

// Тест: ИНН юр лица валиден (контрольная сумма по первым 9 цифрам = 10-я).
Процедура ВыполнитьТестИННЮР(События)

	Для Итерация = 1 По 5 Цикл // несколько генераций для устойчивости
		ИНН = OZON_UI_ГенераторДанных.СгенерироватьИНН(Ложь);
		OZON_UI_Утверждения.УтверждениеРавенство(10, СтрДлина(ИНН), "длина ИНН юр. лица");
		Основа = Лев(ИНН, 9);
		Контрольная = КонтрольнаяСумма(Основа, ИНН10Веса());
		OZON_UI_Утверждения.УтверждениеРавенство(
			Число(Прав(ИНН, 1)), Контрольная,
			"контрольная цифра ИНН-10");
	КонецЦикла;

	ДобавитьСобытие(События, "INFO", "5 генераций ИНН-10 прошли контроль");

КонецПроцедуры

// Тест: ИНН физ лица валиден (11-я и 12-я контрольные).
Процедура ВыполнитьТестИННФиз(События)

	Для Итерация = 1 По 5 Цикл
		ИНН = OZON_UI_ГенераторДанных.СгенерироватьИНН(Истина);
		OZON_UI_Утверждения.УтверждениеРавенство(12, СтрДлина(ИНН), "длина ИНН физ. лица");

		Ожид11 = КонтрольнаяСумма(Лев(ИНН, 10), ИНН12ПерваяВеса());
		Ожид12 = КонтрольнаяСумма(Лев(ИНН, 11), ИНН12ВтораяВеса());

		OZON_UI_Утверждения.УтверждениеРавенство(Число(Сред(ИНН, 11, 1)), Ожид11, "11-я контрольная ИНН-12");
		OZON_UI_Утверждения.УтверждениеРавенство(Число(Сред(ИНН, 12, 1)), Ожид12, "12-я контрольная ИНН-12");
	КонецЦикла;

	ДобавитьСобытие(События, "INFO", "5 генераций ИНН-12 прошли контроль");

КонецПроцедуры

// Тест: СНИЛС валиден (контрольное число).
Процедура ВыполнитьТестСНИЛС(События)

	Для Итерация = 1 По 5 Цикл
		СНИЛС = OZON_UI_ГенераторДанных.СгенерироватьСНИЛС();
		OZON_UI_Утверждения.УтверждениеРавенство(11, СтрДлина(СНИЛС), "длина СНИЛС");

		Номер = Лев(СНИЛС, 9);
		Ожид = КонтрольноеЧислоСНИЛС(Номер);
		ОжидСтр = Строка(Ожид);
		Если СтрДлина(ОжидСтр) = 1 Тогда
			ОжидСтр = "0" + ОжидСтр;
		КонецЕсли;
		OZON_UI_Утверждения.УтверждениеРавенство(ОжидСтр, Прав(СНИЛС, 2), "контрольное число СНИЛС");
	КонецЦикла;

	ДобавитьСобытие(События, "INFO", "5 генераций СНИЛС прошли контроль");

КонецПроцедуры

// Тест: генератор контрагента заполняет согласованный набор полей.
Процедура ВыполнитьТестНаборПолей(События)

	Данные = OZON_UI_ГенераторДанных.СгенерироватьКонтрагента(Новый Структура("ФизЛицо", Ложь));

	OZON_UI_Утверждения.УтверждениеЗаполнено(Данные.ИНН, "ИНН заполнен");
	OZON_UI_Утверждения.УтверждениеЗаполнено(Данные.КПП, "КПП заполнен (юр.)");
	OZON_UI_Утверждения.УтверждениеЗаполнено(Данные.ОГРН, "ОГРН заполнен (юр.)");
	OZON_UI_Утверждения.УтверждениеЗаполнено(Данные.ФИО, "ФИО заполнено");
	OZON_UI_Утверждения.УтверждениеЗаполнено(Данные.Email, "email заполнен");
	OZON_UI_Утверждения.УтверждениеЗаполнено(Данные.Телефон, "телефон заполнен");

	// Типовая проверка соответствия отдельных полей.
	OZON_UI_Утверждения.УтверждениеРавенство(10, СтрДлина(Данные.ИНН), "юр. ИНН — 10 цифр");
	OZON_UI_Утверждения.УтверждениеРавенство(9, СтрДлина(Данные.КПП), "КПП — 9 цифр");
	OZON_UI_Утверждения.УтверждениеРавенство(13, СтрДлина(Данные.ОГРН), "ОГРН — 13 цифр");

	ДобавитьСобытие(События, "INFO", "Набор полей контрагента заполнен корректно");

КонецПроцедуры

// Тест: типизированное сравнение работает (числа, булевы, строки, НЕ-булево из строки).
Процедура ВыполнитьТестТипизированноеРавенство(События)

	// Числа: 1.0 = 1; пробельные строки чисел равны как числа.
	OZON_UI_Утверждения.УтверждениеРавенство(Число(1), Число(1.0), "числа равны");
	OZON_UI_Утверждения.УтверждениеРавенство(Истина, Истина, "булево равно");
	OZON_UI_Утверждения.УтверждениеРавенство("abc", "abc", "строки равны");

	// Должно отличать: "1" (строка) НЕ равно числу 1? — по умолчанию строковое сравнение,
	// поэтому Строка(1)="1" равно "1". Проверяем различимое: число от булева.
	OZON_UI_Утверждения.УтверждениеНеРавенство(Истина, Ложь, "булевы различаются");
	OZON_UI_Утверждения.УтверждениеНеРавенство(1, 2, "числа различаются");

	// Диагностика mismatch присутствует в тексте исключения.
	Поймал = Ложь;
	Попытка
		OZON_UI_Утверждения.УтверждениеРавенство("ожидал", "получил", "контроль диагностики");
	Исключение
		Поймал = Истина;
		Текст = ОписаниеОшибки();
		OZON_UI_Утверждения.УтверждениеИстина(
			СтрНайти(Текст, "ожидал") > 0 И СтрНайти(Текст, "получил") > 0,
			"диагностика mismatch содержит обе стороны");
	КонецПопытки;
	OZON_UI_Утверждения.УтверждениеИстина(Поймал, "assert бросил исключение при mismatch");

	ДобавитьСобытие(События, "INFO", "Типизированное равенство и диагностика mismatch корректны");

КонецПроцедуры

// ========== Проверочные вспомогательные (контрольные суммы) ==========

Функция КонтрольнаяСумма(СтрокаЦифр, Веса)

	Сумма = 0;
	Для Сч = 1 По СтрДлина(СтрокаЦифр) Цикл
		Сумма = Сумма + Число(Сред(СтрокаЦифр, Сч, 1)) * Веса[Сч - 1];
	КонецЦикла;
	Контр = Сумма % 11;
	Если Контр = 10 Тогда
		Контр = 0;
	КонецЕсли;
	Возврат Контр;

КонецФункции

Функция ИНН10Веса()
	Веса = Новый Массив;
	Веса.Добавить(2); Веса.Добавить(4); Веса.Добавить(10); Веса.Добавить(3);
	Веса.Добавить(5); Веса.Добавить(9); Веса.Добавить(4); Веса.Добавить(6); Веса.Добавить(8);
	Возврат Веса;
КонецФункции

Функция ИНН12ПерваяВеса()
	Веса = Новый Массив;
	Веса.Добавить(7); Веса.Добавить(2); Веса.Добавить(4); Веса.Добавить(10);
	Веса.Добавить(3); Веса.Добавить(5); Веса.Добавить(9); Веса.Добавить(4); Веса.Добавить(6); Веса.Добавить(8);
	Возврат Веса;
КонецФункции

Функция ИНН12ВтораяВеса()
	Веса = Новый Массив;
	Веса.Добавить(3); Веса.Добавить(7); Веса.Добавить(2); Веса.Добавить(4); Веса.Добавить(10);
	Веса.Добавить(3); Веса.Добавить(5); Веса.Добавить(9); Веса.Добавить(4); Веса.Добавить(6); Веса.Добавить(8);
	Возврат Веса;
КонецФункции

Функция КонтрольноеЧислоСНИЛС(Номер)

	Сумма = 0;
	Для Сч = 1 По 9 Цикл
		Сумма = Сумма + Число(Сред(Номер, Сч, 1)) * (10 - Сч);
	КонецЦикла;
	Контр = Сумма % 101;
	Если Контр = 100 ИЛИ Контр = 101 Тогда
		Контр = 0;
	КонецЕсли;
	Возврат Контр;

КонецФункции

// Вспомогательные.
Процедура ДобавитьСобытие(События, Уровень, Текст)

	События.Добавить(Новый Структура("Момент, Уровень, Текст",
		Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd'T'HH:mm:ss"), Уровень, Текст));

КонецПроцедуры

Функция СписокТегов(СтрокаТегов)

	Если ПустаяСтрока(СтрокаТегов) Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Возврат СтрРазделить(СтрокаТегов, ",", Ложь);

КонецФункции

#КонецОбласти
