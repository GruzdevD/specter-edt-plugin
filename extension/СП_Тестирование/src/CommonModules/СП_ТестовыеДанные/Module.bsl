//
//  Серверный API подготовки/очистки данных (setup/teardown op из capabilities.dataOps).
//  Обрабатывает серверные директивы DataDirective { op, params } контракта.
//  Секретов/строк подключения не хранит (ADR-006). Директивы: Сервер.
//©///////////////////////////////////////////////////////////////////////////©//

#Область ПрограммныйИнтерфейс

// Обработать серверную директиву setup/teardown.
// Возвращает результат пакетом: массив результатов по каждой директиве.
//
// Параметры:
//  Директивы - Массив - коллекция серверных директив { op, params } (DataDirective).
//
//@skip-check doc-comment-collection-item-type
// Возвращаемое значение:
//  Массив - результаты по каждой директиве (структуры { op, ok, message, ref }):
//   * op - Строка - код выполненной операции (prepareContractor, cleanupContractor).
//   * ok - Булево - признак успешного выполнения директивы.
//   * message - Строка - сообщение о результате (в т.ч. текст ошибки при сбое).
//   * ref - Строка - строковое представление ссылки на объект (для prepareContractor).
Функция ВыполнитьДирективы(Директивы) Экспорт

	Результаты = Новый Массив;

	Для Каждого Директива Из Директивы Цикл

		//@skip-check structure-consructor-too-many-keys
		Результат = Новый Структура("op, ok, message, ref", "", Ложь, "", "");

		Попытка

			Операнд = Директива.op;
			Если Операнд = "prepareContractor" Тогда
				Ссылка = ПодготовитьКонтрагента(Директива.params);
				Результат.op = Операнд;
				Результат.ok = Истина;
				Результат.ref = Строка(Ссылка);
				Результат.message = "Контрагент подготовлен";
			ИначеЕсли Операнд = "cleanupContractor" Тогда
				ОчиститьКонтрагента(Директива.params);
				Результат.op = Операнд;
				Результат.ok = Истина;
				Результат.message = "Контрагент очищен";
			Иначе
				Результат.op = Операнд;
				Результат.message = "Незарегистрированный op: " + Операнд;
			КонецЕсли;

		Исключение
			Результат.op = Директива.op;
			Результат.message = ОписаниеОшибки();
		КонецПопытки;

		Результаты.Добавить(Результат);

	КонецЦикла;

	Возврат Результаты;

КонецФункции

// Список поддерживаемых серверных op (для capabilities.dataOps).
//
//@skip-check doc-comment-collection-item-type
// Возвращаемое значение:
//  Массив - имена поддерживаемых операций (prepareContractor, cleanupContractor).
Функция ДоступныеОперации() Экспорт

	Массив = Новый Массив;
	Массив.Добавить("prepareContractor");
	Массив.Добавить("cleanupContractor");
	Возврат Массив;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Подготовить тестового контрагента по коду и виду (kind='legal'|'physical').
Функция ПодготовитьКонтрагента(Параметры)

	Код = ЗначениеПараметра(Параметры, "code", "");
	Вид  = ЗначениеПараметра(Параметры, "kind", "legal");

	Если НЕ ЗначениеЗаполнено(Код) Тогда
		ВызватьИсключение "СП_ТестовыеДанные: не указан code для prepareContractor";
	КонецЕсли;

	Ссылка = НайтиПоКоду(Код);
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Объект = Справочники.Контрагенты.СоздатьЭлемент();
	Иначе
		Объект = Ссылка.ПолучитьОбъект();
	КонецЕсли;

	Объект.Код = Код;
	Объект.Наименование = "Тестовый контрагент " + Код;
	Объект.НаименованиеСокращенное = "Тест " + Код;

	Если Вид = "physical" Тогда
		Объект.ЮрФизЛицо = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо;
	Иначе
		Объект.ЮрФизЛицо = Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо;
	КонецЕсли;

	Объект.Записать();

	Возврат Объект.Ссылка;

КонецФункции

// Очистить тестового контрагента по коду (пометка на удаление + запись).
Процедура ОчиститьКонтрагента(Параметры)

	Код = ЗначениеПараметра(Параметры, "code", "");
	Если НЕ ЗначениеЗаполнено(Код) Тогда
		Возврат;
	КонецЕсли;

	Ссылка = НайтиПоКоду(Код);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Объект = Ссылка.ПолучитьОбъект();
		Объект.УстановитьПометкуУдаления(Истина);
		Объект.Записать();
	КонецЕсли;

КонецПроцедуры

Функция НайтиПоКоду(Код)

	Возврат Справочники.Контрагенты.НайтиПоКоду(Код, Истина);

КонецФункции

Функция ЗначениеПараметра(Параметры, Ключ, ПоУмолчанию = Неопределено)

	Если ЗначениеЗаполнено(Параметры) И Параметры.Свойство(Ключ) Тогда
		Значение = Параметры[Ключ];
		Если ЗначениеЗаполнено(Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;

	Возврат ПоУмолчанию;

КонецФункции

#КонецОбласти
