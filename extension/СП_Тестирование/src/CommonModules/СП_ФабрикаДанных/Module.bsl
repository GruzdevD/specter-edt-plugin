//©///////////////////////////////////////////////////////////////////////////©//
//  СП_ФабрикаДанных - объектная фабрика данных (P3, по образу DataBuilder YaxUnit).
//
//  ORM-подобный слой поверх генератора случайных данных СП_ГенераторДанных: вместо
//  десятков строк «Документы.Заявка.СоздатьДокумент() ... Записать()» разработчик пишет:
//    Ссылка = СП_ФабрикаДанных.СоздатьДокумент(Новый Структура("ИмяДокумента, Провести",
//             "Заявка", Истина));
//  Созданные объекты отслеживаются в сессии и удаляются одной командой УдалитьСозданное()
//  (вызывается из ПослеЗавершенияТеста).
//
//  Единая сигнатура {ok, message, value} - для вызова через мост СП_ВызовСервера.
//©///////////////////////////////////////////////////////////////////////////©//

Перем СозданныеОбъекты; // Массив ссылок, созданных фабрикой за сессию.

#Область ПрограммныйИнтерфейс

// Создаёт документ по имени и возвращает ссылку.
//
// Параметры:
//   Параметры - Структура:
//     ИмяДокумента - Строка - имя вида документа (обязательно).
//     Реквизиты - Структура - значения реквизитов: Ключ = имя реквизита, Значение = значение.
//     Провести - Булево - проводить документ после записи (по умолчанию Ложь).
//     Дата - Дата - дата документа (по умолчанию текущая дата).
//
// Возвращаемое значение:
//   Структура("ok, message, value") - value = ДокументСсылка.*.
Функция СоздатьДокумент(Параметры) Экспорт

	Результат = Новый Структура("ok, message, value", Ложь, "", Неопределено);
	ИмяДокумента = ЗначениеСвойстваПараметра(Параметры, "ИмяДокумента", "");
	Если ПустаяСтрока(ИмяДокумента) Тогда
		Результат.message = "Не задано ИмяДокумента";
		Возврат Результат;
	КонецЕсли;

	Попытка
		ДокументОбъект = Документы[ИмяДокумента].СоздатьДокумент();
		Если Параметры.Свойство("Дата") Тогда
			ДокументОбъект.Дата = Параметры.Дата;
		КонецЕсли;
		ПрименитьРеквизиты(ДокументОбъект, Параметры.Реквизиты);
		ДокументОбъект.Записать();
		Если ЗначениеСвойстваПараметра(Параметры, "Провести", Ложь) И ДокументОбъект.Проведен <> Истина Тогда
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;
		Ссылка = ДокументОбъект.Ссылка;
		ЗапомнитьОбъект(Ссылка);
		Результат.ok = Истина;
		Результат.value = Ссылка;
	Исключение
		Результат.message = "Ошибка создания документа '" + ИмяДокумента + "': " + ОписаниеОшибки();
	КонецПопытки;
	Возврат Результат;

КонецФункции

// Создаёт элемент справочника по имени и возвращает ссылку.
//
// Параметры:
//   ИмяСправочника - Строка - имя справочника (обязательно).
//   Реквизиты - Структура - значения реквизитов (включая, при необходимости, Наименование).
//   Код - Строка/Число - код элемента (необязательно).
Функция СоздатьСправочник(Параметры) Экспорт

	Результат = Новый Структура("ok, message, value", Ложь, "", Неопределено);
	ИмяСправочника = ЗначениеСвойстваПараметра(Параметры, "ИмяСправочника", "");
	Если ПустаяСтрока(ИмяСправочника) Тогда
		Результат.message = "Не задано ИмяСправочника";
		Возврат Результат;
	КонецЕсли;

	Попытка
		Элемент = Справочники[ИмяСправочника].СоздатьЭлемент();
		Если Параметры.Свойство("Код") Тогда
			Элемент.Код = Параметры.Код;
		КонецЕсли;
		ПрименитьРеквизиты(Элемент, Параметры.Реквизиты);
		Если ПустаяСтрока(Элемент.Наименование) И Параметры.Свойство("Реквизиты")
			И Параметры.Реквизиты.Свойство("Наименование") Тогда
			Элемент.Наименование = Параметры.Реквизиты.Наименование;
		КонецЕсли;
		Элемент.Записать();
		Ссылка = Элемент.Ссылка;
		ЗапомнитьОбъект(Ссылка);
		Результат.ok = Истина;
		Результат.value = Ссылка;
	Исключение
		Результат.message = "Ошибка создания справочника '" + ИмяСправочника + "': " + ОписаниеОшибки();
	КонецПопытки;
	Возврат Результат;

КонецФункции

// Создаёт контрагента с автогенерацией данных (ИНН/КПП/наименование) из СП_ГенераторДанных.
//
// Параметры:
//   ИмяСправочника - Строка - имя справочника контрагента (по умолчанию "Контрагенты").
//   ПараметрыГенерации - Структура - параметры для СП_ГенераторДанных.СгенерироватьКонтрагента.
//   Реквизиты - Структура - дополнительные реквизиты (перекрывают сгенерированные).
Функция СоздатьКонтрагента(Параметры = Неопределено) Экспорт

	ИмяСправочника = ЗначениеСвойстваПараметра(Параметры, "ИмяСправочника", "Контрагенты");
	Сгенерированный = СП_ГенераторДанных.СгенерироватьКонтрагента(
		ЗначениеСвойстваПараметра(Параметры, "ПараметрыГенерации", Неопределено));

	Реквизиты = Новый Структура;
	Если ЗначениеЗаполнено(Сгенерированный) Тогда
		Для Каждого КлючЗначение Из Сгенерированный Цикл
			Реквизиты.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЦикла;
	КонецЕсли;
	Если ЗначениеЗаполнено(Параметры) И Параметры.Свойство("Реквизиты") Тогда
		Для Каждого КлючЗначение Из Параметры.Реквизиты Цикл
			Реквизиты.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЦикла;
	КонецЕсли;

	Возврат СоздатьСправочник(Новый Структура("ИмяСправочника, Реквизиты", ИмяСправочника, Реквизиты));

КонецФункции

// Удаляет все объекты, созданные фабрикой за текущую сессию (очистка данных).
//
// Параметры:
//   Параметры - Структура (не используется; для единой сигнатуры моста).
//
// Возвращаемое значение:
//   Структура("ok, message, value") - value = количество удалённых объектов.
Функция УдалитьСозданное(Параметры = Неопределено) Экспорт

	Результат = Новый Структура("ok, message, value", Истина, "", 0);
	Количество = 0;
	Если ЗначениеЗаполнено(СозданныеОбъекты) Тогда
		Для Каждого Ссылка Из СозданныеОбъекты Цикл
			Попытка
				Объект = Ссылка.ПолучитьОбъект();
				Если НЕ Объект.ПометкаУдаления Тогда
					Объект.УстановитьПометкуУдаления(Истина);
				КонецЕсли;
				Количество = Количество + 1;
			Исключение
				// объект мог быть удалён вручную - пропускаем
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;
	СозданныеОбъекты = Новый Массив;
	Результат.value = Количество;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Применяет структуру реквизитов к объекту (простые типы, даты, ссылки).
Процедура ПрименитьРеквизиты(Объект, Реквизиты)

	Если НЕ ЗначениеЗаполнено(Реквизиты) Тогда
		Возврат;
	КонецЕсли;
	Для Каждого КлючЗначение Из Реквизиты Цикл
		Попытка
			Объект[КлючЗначение.Ключ] = КлючЗначение.Значение;
		Исключение
			// несуществующий/недоступный реквизит - игнорируем, чтобы не ронять всю фабрику
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

// Запоминает созданную ссылку для последующей очистки.
Процедура ЗапомнитьОбъект(Ссылка)

	Если Ссылка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(СозданныеОбъекты) Тогда
		СозданныеОбъекты = Новый Массив;
	КонецЕсли;
	СозданныеОбъекты.Добавить(Ссылка);

КонецПроцедуры

// Безопасно читает свойство параметра со значением по умолчанию.
Функция ЗначениеСвойстваПараметра(Параметры, Ключ, ПоУмолчанию)

	Если Параметры = Неопределено Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Если Параметры.Свойство(Ключ) Тогда
		Возврат Параметры[Ключ];
	КонецЕсли;
	Возврат ПоУмолчанию;

КонецФункции

#КонецОбласти
