//©///////////////////////////////////////////////////////////////////////////©//
//  СП_Ожидаем - Fluent-ассерты (P1, по образу YaxUnit «Ожидаем.Что().Равно()»).
//
//  Обёртка над процедурными ассертами СП_Утверждения/СП_УтвержденияКлиент с двумя
//  улучшениями:
//   1) Лаконичный двухаргументный вызов без обязательного текста сообщения:
//        СП_Ожидаем.Равно(СП_Ожидаем.Что(Цена), 100);
//        СП_Ожидаем.СодержитСтроку(СП_Ожидаем.Что(Таблица), Новый Структура("Код","001"));
//      Сообщение формируется автоматически с диагностикой «ожидал | получил».
//   2) Дамп фактического значения при падении: структура/соответствие/таблица
//      сериализуются в сообщение, а не глухо «не совпало».
//
//  ОГРАНИЧЕНИЕ BSL: в 1С нет пользовательских типов с методами, поэтому литеральная
//  цепочка «Что(...).Равно(...)» невозможна (нельзя вызвать метод на возвращённой
//  Структуре). Достижимый fluent-эквивалент - «Что(факт)» возвращает контекст-объект,
//  который дальше передаётся методу-матову первым параметром. Читается так же естественно
//  и не требует таскать сообщение об ошибке по каждому вызову.
//
//  Контур: модуль серверный (client-managed НЕ помечен), чтобы работать и в серверных
//  data-проверках (P2), и клиентские проверки делегируют сюда серверным вызовом.
//©///////////////////////////////////////////////////////////////////////////©//

#Область ПрограммныйИнтерфейс

// Создаёт контекст ожидания для фактического значения.
//
// Параметры:
//   Факт - Произвольный - фактическое значение (число, строка, структура, таблица...).
//   Сообщение - Строка - необязательный текст для сообщения об ошибке.
//
// Возвращаемое значение:
//   Структура - контекст ожидания (Значение, Сообщение), передаётся в методы-матовы.
Функция Что(Факт, Сообщение = "") Экспорт

	Контекст = Новый Структура("Значение, Сообщение");
	Контекст.Значение = Факт;
	Контекст.Сообщение = Сообщение;
	Возврат Контекст;

КонецФункции

// Ожидаем: фактическое значение равно эталону.
Процедура Равно(Контекст, Ожидаемое, Сообщение = "") Экспорт

	Если ЗначенияРавны(Контекст.Значение, Ожидаемое) Тогда
		Возврат;
	КонецЕсли;
	Нарушить(Контекст, "значения не равны", Ожидаемое, ДопСообщение(Сообщение));

КонецПроцедуры

// Ожидаем: фактическое значение НЕ равно эталону.
Процедура НеРавно(Контекст, Ожидаемое, Сообщение = "") Экспорт

	Если НЕ ЗначенияРавны(Контекст.Значение, Ожидаемое) Тогда
		Возврат;
	КонецЕсли;
	Нарушить(Контекст, "значения не должны быть равны", Ожидаемое, ДопСообщение(Сообщение));

КонецПроцедуры

// Ожидаем: значение Истина.
Процедура Истина(Контекст, Сообщение = "") Экспорт

	Если Контекст.Значение = Истина Тогда
		Возврат;
	КонецЕсли;
	Нарушить(Контекст, "условие должно быть истинным", Истина, ДопСообщение(Сообщение));

КонецПроцедуры

// Ожидаем: значение Ложь.
Процедура Ложь(Контекст, Сообщение = "") Экспорт

	Если Контекст.Значение = Ложь Тогда
		Возврат;
	КонецЕсли;
	Нарушить(Контекст, "условие должно быть ложным", Ложь, ДопСообщение(Сообщение));

КонецПроцедуры

// Ожидаем: значение заполнено (НЕ пусто/Неопределено/0/" ").
Процедура Заполнено(Контекст, Сообщение = "") Экспорт

	Если ЗначениеЗаполнено(Контекст.Значение) Тогда
		Возврат;
	КонецЕсли;
	Нарушить(Контекст, "значение должно быть заполнено", "<заполнено>", ДопСообщение(Сообщение));

КонецПроцедуры

// Ожидаем: значение пусто.
Процедура Пусто(Контекст, Сообщение = "") Экспорт

	Если НЕ ЗначениеЗаполнено(Контекст.Значение) Тогда
		Возврат;
	КонецЕсли;
	Нарушить(Контекст, "значение должно быть пустым", "<пусто>", ДопСообщение(Сообщение));

КонецПроцедуры

// Ожидаем: фактическое значение больше эталона.
Процедура Больше(Контекст, Эталон, Сообщение = "") Экспорт

	Если Контекст.Значение > Эталон Тогда
		Возврат;
	КонецЕсли;
	Нарушить(Контекст, "значение должно быть больше эталона", Эталон, ДопСообщение(Сообщение));

КонецПроцедуры

// Ожидаем: фактическое значение меньше эталона.
Процедура Меньше(Контекст, Эталон, Сообщение = "") Экспорт

	Если Контекст.Значение < Эталон Тогда
		Возврат;
	КонецЕсли;
	Нарушить(Контекст, "значение должно быть меньше эталона", Эталон, ДопСообщение(Сообщение));

КонецПроцедуры

// Ожидаем: таблица значений содержит строку, соответствующую Отбору (Структура).
// Рендерит дамп таблицы (первые строки) в сообщение при отсутствии совпадения.
Процедура СодержитСтроку(Контекст, Отбор, Сообщение = "") Экспорт

	Таблица = Контекст.Значение;
	Если ТипЗнч(Таблица) <> Тип("ТаблицаЗначений")
		И ТипЗнч(Таблица) <> Тип("ТабличнаяЧасть") Тогда
		// Если контекст - уже структура/соответствие, проверяем поля напрямую.
		ПроверитьСодержитПоСтруктуре(Контекст, Отбор, Сообщение);
		Возврат;
	КонецЕсли;

	Найдено = НайтиСтрокуВТаблице(Таблица, Отбор);
	Если Найдено Тогда
		Возврат;
	КонецЕсли;

	Нарушить(Контекст, "таблица не содержит строку с отбором", СтрокаПредставлениеОтбора(Отбор),
		ДопСообщение(Сообщение) + " Таблица: " + ДампироватьТаблицу(Таблица));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Единая точка нарушения: бросает ASSERT_FAILED с дампом фактического значения.
Процедура Нарушить(Контекст, ТипОшибки, Ожидаемое, Сообщение)

	Текст = "ASSERT_FAILED: " + ТипОшибки;
	Если НЕ ПустаяСтрока(Сообщение) Тогда
		Текст = Текст + ". " + Сообщение;
	КонецЕсли;
	Текст = Текст + ". Ожидал: '" + ДампироватьЗначение(Ожидаемое)
		+ "' | Получил: '" + ДампироватьЗначение(Контекст.Значение) + "'";
	ВызватьИсключение(Текст);

КонецПроцедуры

// Сообщение вызова (приоритет у контекста, заданного в Что).
Функция ДопСообщение(Сообщение)

	Возврат Сообщение;

КонецФункции

// Сравнение значений с нормализацией чисел/булево/строк.
Функция ЗначенияРавны(Факт, Ожид)

	// Числовое сравнение без потери точности (5 = 5,00).
	Если ТипЗнч(Ожид) = Тип("Число") Тогда
		Если ТипЗнч(Факт) <> Тип("Число") Тогда
			Возврат Ложь;
		КонецЕсли;
		Если Факт = Ожид Тогда
			Возврат Истина;
		КонецЕсли;
		// Дробное сравнение с малой погрешностью.
		Возврат НЕ (Факт - Ожид > 0.0000001) И НЕ (Ожид - Факт > 0.0000001);
	КонецЕсли;

	Если ТипЗнч(Ожид) = Тип("Булево") Тогда
		Возврат Факт = Ожид;
	КонецЕсли;

	Если ТипЗнч(Ожид) = Тип("Дата") И ТипЗнч(Факт) = Тип("Дата") Тогда
		Возврат Факт = Ожид;
	КонецЕсли;

	// Ссылки/объекты/прочее - по строковому представлению.
	Возврат Строка(Факт) = Строка(Ожид);

КонецФункции

// Поиск строки в таблице по всем полям структуры отбора (точное совпадение).
Функция НайтиСтрокуВТаблице(Таблица, Отбор)

	//@skip-check bsl-legacy-check-avoid-indexing
	Для Каждого Стр Из Таблица Цикл
		Совпала = Истина;
		Для Каждого КлючЗначение Из Отбор Цикл
			Если НЕ Стр.Свойство(КлючЗначение.Ключ) Тогда
				Совпала = Ложь;
				Прервать;
			КонецЕсли;
			Если НЕ ЗначенияРавны(Стр[КлючЗначение.Ключ], КлючЗначение.Значение) Тогда
				Совпала = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Совпала Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Содержит-проверка, когда контекст - Структура/Соответствие (не таблица).
Процедура ПроверитьСодержитПоСтруктуре(Контекст, Отбор, Сообщение)

	Если ТипЗнч(Контекст.Значение) <> Тип("Структура") И ТипЗнч(Контекст.Значение) <> Тип("Соответствие") Тогда
		Нарушить(Контекст, "ожидалась таблица/структура для проверки содержит",
			СтрокаПредставлениеОтбора(Отбор), ДопСообщение(Сообщение));
		Возврат;
	КонецЕсли;

	Совпала = Истина;
	Для Каждого КлючЗначение Из Отбор Цикл
		Если НЕ Контекст.Значение.Свойство(КлючЗначение.Ключ) Тогда
			Совпала = Ложь;
			Прервать;
		КонецЕсли;
		Если НЕ ЗначенияРавны(Контекст.Значение[КлючЗначение.Ключ], КлючЗначение.Значение) Тогда
			Совпала = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Совпала Тогда
		Возврат;
	КонецЕсли;

	Нарушить(Контекст, "структура не содержит заданные поля",
		СтрокаПредставлениеОтбора(Отбор), ДопСообщение(Сообщение) + " Факт: " + ДампироватьЗначение(Контекст.Значение));

КонецПроцедуры

// Строковое представление структуры-отбора вида "К1=Зн1; К2=Зн2".
Функция СтрокаПредставлениеОтбора(Отбор)

	Части = Новый Массив;
	Для Каждого КлючЗначение Из Отбор Цикл
		Части.Добавить(КлючЗначение.Ключ + "=" + ДампироватьЗначение(КлючЗначение.Значение));
	КонецЦикла;
	Возврат СтрСоединить(Части, "; ");

КонецФункции

// Сериализация значения в строку для дампа в сообщении об ошибке.
Функция ДампироватьЗначение(Значение)

	Если Значение = Неопределено Тогда
		Возврат "<Неопределено>";
	КонецЕсли;

	ТипЗнач = ТипЗнч(Значение);
	Если ТипЗнач = Тип("Структура") ИЛИ ТипЗнач = Тип("Соответствие") Тогда
		Части = Новый Массив;
		Для Каждого КлючЗначение Из Значение Цикл
			Части.Добавить(КлючЗначение.Ключ + "=" + Строка(КлючЗначение.Значение));
		КонецЦикла;
		Возврат "{" + СтрСоединить(Части, "; ") + "}";
	КонецЕсли;

	Если ТипЗнач = Тип("ТаблицаЗначений") ИЛИ ТипЗнач = Тип("ТабличнаяЧасть") Тогда
		Возврат ДампироватьТаблицу(Значение);
	КонецЕсли;

	Если ТипЗнач = Тип("Массив") Тогда
		Части = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Части.Добавить(Строка(Элемент));
		КонецЦикла;
		Возврат "[" + СтрСоединить(Части, "; ") + "]";
	КонецЕсли;

	Возврат Строка(Значение);

КонецФункции

// Дамп таблицы значений: количество строк и первые строки (поля=значение).
Функция ДампироватьТаблицу(Таблица)

	Части = Новый Массив;
	Части.Добавить("строк: " + Строка(Таблица.Количество()));
	Лимит = 5;
	//@skip-check bsl-legacy-check-avoid-indexing
	Для Каждого Стр Из Таблица Цикл
		Лимит = Лимит - 1;
		Если Лимит < 0 Тогда
			Прервать;
		КонецЕсли;
		Поля = Новый Массив;
		Для Каждого Колонка Из Таблица.Колонки Цикл
			Поля.Добавить(Колонка.Имя + "=" + Строка(Стр[Колонка.Имя]));
		КонецЦикла;
		Части.Добавить("{" + СтрСоединить(Поля, "; ") + "}");
	КонецЦикла;
	Возврат СтрСоединить(Части, " ");

КонецФункции

#КонецОбласти
