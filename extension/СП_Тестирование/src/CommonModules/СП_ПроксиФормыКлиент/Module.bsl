//©///////////////////////////////////////////////////////////////////////////©//
//  СП_ПроксиФормыКлиент - расширение afm, клиентский прокси открытой формы (R3, УИ_Прокси).
//
//  Решает проблему stale-элементов Vanessa: НЕ копить ссылки на элементы между шагами,
//  а каждый раз действовать через открытую форму-источник (карточку). Управляемая форма
//  экспортирует &НаКлиенте методы-обёртки (УстановитьПоле/НажатьКоманду/ПрочитатьПоле/
//  СвойствоОбъекта/СобратьТопологию) - ВыполнитьКомандуФормы и доступ к Элементы/Объект
//  возможны только в контексте модуля самой формы.
//
//  Здесь эти экспортные методы формы инкапсулируются в единый клиентский интерфейс
//  + UI-предикаты (УИ_Ожидаем): утверждения над РЕАЛЬНЫМ слоем UI (видимость/доступность/
//  модифицированность/значение). Живут на клиенте, поэтому код ошибки ASSERT_FAILED и
//  сравнение значений - ЛОКАЛЬНЫЕ клиентские копии (серверный СП_Утверждения с
//  клиента недоступен). FAILED не зависит от движка: протокол совпадает по строке-коду.
//
//  Директива: Клиент (управляемое приложение) - форма живёт только на клиенте.
//  НЕ хранит секретов (ADR-006).
//©///////////////////////////////////////////////////////////////////////////©//

#Область ПрограммныйИнтерфейс

// Код ошибки утверждения (клиентская копия; совпадает с СП_Утверждения.КодОшибкиУтверждения).
//
// Возвращаемое значение:
//  Строка - код ошибки утверждения ("ASSERT_FAILED").
Функция КодОшибкиУтверждения() Экспорт
	Возврат "ASSERT_FAILED";
КонецФункции

// Установить значение реквизита открытой формы через её экспортный метод УстановитьПоле.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - открытая управляемая форма (проксируемая карточка).
//  ИмяРеквизита - Строка - имя реквизита на форме.
//  Значение - Произвольный - устанавливаемое значение реквизита.
Процедура УстановитьПоле(Форма, ИмяРеквизита, Значение) Экспорт

	ПроверитьФорму(Форма);
	Попытка
		Форма.УстановитьПоле(ИмяРеквизита, Значение);
	Исключение
		ВызватьИсключение "СП_Тестирование.Прокси: не удалось установить поле '" + ИмяРеквизита
			+ "': " + ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

// Выполнить команду формы (Записать, Закрыть, ...) через её экспортный метод НажатьКоманду.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - открытая управляемая форма (проксируемая карточка).
//  ИмяКоманды - Строка - имя команды формы.
Процедура НажатьКоманду(Форма, ИмяКоманды) Экспорт

	ПроверитьФорму(Форма);
	Попытка
		Форма.НажатьКоманду(ИмяКоманды);
	Исключение
		ВызватьИсключение "СП_Тестирование.Прокси: команда формы '" + ИмяКоманды + "' не выполнена: "
			+ ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

// Прочитать значение реквизита формы через её экспортный метод ПрочитатьПоле.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - открытая управляемая форма (проксируемая карточка).
//  ИмяРеквизита - Строка - имя реквизита на форме.
//
// Возвращаемое значение:
//  Произвольный - значение реквизита формы.
Функция ПрочитатьПоле(Форма, ИмяРеквизита) Экспорт

	ПроверитьФорму(Форма);
	Попытка
		Возврат Форма.ПрочитатьПоле(ИмяРеквизита);
	Исключение
		ВызватьИсключение "СП_Тестирование.Прокси: не удалось прочитать поле '" + ИмяРеквизита
			+ "': " + ОписаниеОшибки();
	КонецПопытки;

КонецФункции

// Свойство реального элемента UI формы (Видимость/Доступность/Заголовок/Модифицированность).
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - открытая управляемая форма (проксируемая карточка).
//  ИмяЭлемента - Строка - имя элемента формы.
//  ИмяСвойства - Строка - имя свойства элемента (Видимость/Доступность/Заголовок/Модифицированность).
//
// Возвращаемое значение:
//  Произвольный - значение запрошенного свойства элемента.
Функция СвойствоЭлемента(Форма, ИмяЭлемента, ИмяСвойства) Экспорт

	ПроверитьФорму(Форма);
	Попытка
		Возврат Форма.СвойствоОбъекта(ИмяЭлемента, ИмяСвойства);
	Исключение
		ВызватьИсключение "СП_Тестирование.Прокси: свойство '" + ИмяСвойства + "' элемента '"
			+ ИмяЭлемента + "' недоступно: " + ОписаниеОшибки();
	КонецПопытки;

КонецФункции

// Собрать топологию (карта окна) открытой формы через её экспортный метод СобратьТопологию.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - открытая управляемая форма (проксируемая карточка).
//
// Возвращаемое значение:
//  Структура - карта окна (топология элементов формы).
Функция СобратьТопологию(Форма) Экспорт

	ПроверитьФорму(Форма);
	Попытка
		Возврат Форма.СобратьТопологию();
	Исключение
		ВызватьИсключение "СП_Тестирование.Прокси: не удалось собрать топологию формы: "
			+ ОписаниеОшибки();
	КонецПопытки;

КонецФункции

// --- UI-предикаты (УИ_Ожидаем, R3): утверждения над РЕАЛЬНЫМ слоем UI формы. ---

// Утвердить видимость элемента формы (факт из реального слоя UI).
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - открытая управляемая форма (проксируемая карточка).
//  ИмяЭлемента - Строка - имя элемента формы.
//  Ожидается - Булево - ожидаемая видимость (Истина - видим, Ложь - скрыт).
Процедура УтвердитьВидимость(Форма, ИмяЭлемента, Ожидается = Истина) Экспорт

	Факт = СвойствоЭлемента(Форма, ИмяЭлемента, "Видимость");
	Если КакБулево(Факт) <> КакБулево(Ожидается) Тогда
		ВызватьИсключение(КодОшибкиУтверждения()
			+ ": элемент '" + ИмяЭлемента + "' должен быть "
			+ ?(КакБулево(Ожидается), "видимым", "скрытым")
			+ ". Фактически видимость=" + Строка(Факт));
	КонецЕсли;

КонецПроцедуры

// Утвердить доступность элемента формы (факт из реального слоя UI).
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - открытая управляемая форма (проксируемая карточка).
//  ИмяЭлемента - Строка - имя элемента формы.
//  Ожидается - Булево - ожидаемая доступность (Истина - доступен, Ложь - недоступен).
Процедура УтвердитьДоступность(Форма, ИмяЭлемента, Ожидается = Истина) Экспорт

	Факт = СвойствоЭлемента(Форма, ИмяЭлемента, "Доступность");
	Если КакБулево(Факт) <> КакБулево(Ожидается) Тогда
		ВызватьИсключение(КодОшибкиУтверждения()
			+ ": элемент '" + ИмяЭлемента + "' должен быть "
			+ ?(КакБулево(Ожидается), "доступным", "недоступным")
			+ ". Фактически доступность=" + Строка(Факт));
	КонецЕсли;

КонецПроцедуры

// Утвердить, что форма не модифицирована (все данные записаны).
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - открытая управляемая форма (проксируемая карточка).
Процедура УтвердитьНеМодифицирована(Форма) Экспорт

	Факт = СвойствоЭлемента(Форма, "Форма", "Модифицированность");
	Если КакБулево(Факт) Тогда
		ВызватьИсключение(КодОшибкиУтверждения()
			+ ": форма модифицирована, ожидалось, что данные записаны");
	КонецЕсли;

КонецПроцедуры

// Утвердить равенство значения реквизита формы фактическому (через ПрочитатьПоле).
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - открытая управляемая форма (проксируемая карточка).
//  ИмяРеквизита - Строка - имя реквизита на форме.
//  Ожидаемое - Произвольный - ожидаемое значение реквизита.
Процедура УтвердитьЗначение(Форма, ИмяРеквизита, Ожидаемое) Экспорт

	Факт = ПрочитатьПоле(Форма, ИмяРеквизита);
	Если НЕ ЗначенияРавны(Ожидаемое, Факт) Тогда
		ВызватьИсключение(КодОшибкиУтверждения()
			+ ": значение реквизита '" + ИмяРеквизита + "'. Ожидал: '"
			+ Строка(Ожидаемое) + "' | Получил: '" + Строка(Факт) + "'");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Проверка живости ссылки на форму: не пуста (stale-ссылка на закрытую форму даст
// честную ошибку при самом вызове метода ниже - не маскируем).
Процедура ПроверитьФорму(Форма)

	Если Форма = Неопределено Тогда
		ВызватьИсключение "СП_Тестирование.Прокси: ссылка на форму пуста (форма не открыта или stale)";
	КонецЕсли;

КонецПроцедуры

// Клиентская копия типизированного сравнения (серверный СП_Утверждения.ЗначенияРавны
// с клиента недоступен). Числа/булевы - строго, прочее - по строковому представлению.
Функция ЗначенияРавны(Ожидаемое, Фактическое)

	Если Ожидаемое = Неопределено И Фактическое = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Если Ожидаемое = Неопределено ИЛИ Фактическое = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	ТипОжидаемого = ТипЗнч(Ожидаемое);
	ТипФактического = ТипЗнч(Фактическое);

	Если ТипОжидаемого = Тип("Число") И ТипФактического = Тип("Число") Тогда
		Возврат Ожидаемое = Фактическое;
	КонецЕсли;
	Если ТипОжидаемого = Тип("Булево") И ТипФактического = Тип("Булево") Тогда
		Возврат Ожидаемое = Фактическое;
	КонецЕсли;

	Возврат НРег(СокрЛП(Строка(Фактическое))) = НРег(СокрЛП(Строка(Ожидаемое)));

КонецФункции

// Надёжная проверка булева: Ложь/Истина/Неопределено/число 0|1.
Функция КакБулево(Значение)

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение <> 0;
	Иначе
		Возврат ЗначениеЗаполнено(Значение);
	КонецЕсли;

КонецФункции

#КонецОбласти
