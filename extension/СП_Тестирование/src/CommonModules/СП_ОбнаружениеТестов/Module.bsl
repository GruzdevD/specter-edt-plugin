//©///////////////////////////////////////////////////////////////////////////©//
//  СП_ОбнаружениеТестов - Annotation Discovery (P0, по образу YaxUnit).
//
//  Находит тесты в модуле по аннотациям-комментариям, а не по явному контракту
//  СписокТестов()/ЗапуститьНаборТестов(). Это освобождает рукописный модуль от
//  boilerplate-кода: разработчик помечает экспортную процедуру аннотацией
//  //&Тест - движок сам соберёт её в список для запуска.
//
//  Поддерживаемые аннотации (комментарии над объявлением метода):
//    //&Тест                     - тест по умолчанию (имя = имя метода)
//    //&Тест("Описание")         - с описанием
//    //&Тест("Описание", "тег1,тег2") - с описанием и тегами
//    //&ПараметрыТеста("Ключ=Значение;Ключ2=Значение2") - параметры теста
//    //&ОтключаемыйТест("причина") - тест помечается отключённым
//  Объявление метода: "Процедура Имя(...) Экспорт" или "Функция Имя(...) Экспорт".
//
//  ЧПК REPLANT: 1С не умеет читать собственный исходник на рантайме, поэтому
//  источник BSL подаётся снаружи (плагин EDT / конвертер на build-time), либо
//  разработчик держит исходник в макете. Парсинг чистый текстовый.
//©///////////////////////////////////////////////////////////////////////////©//

#Область ПрограммныйИнтерфейс

// Собирает тесты по аннотациям //&Тест в переданном исходнике модуля.
//
// Параметры:
//   Исходник - Строка - текст BSL-модуля.
//   ИмяМодуля - Строка - имя модуля (программное), попадает в поле Имя, если метод
//    не задан; по умолчанию пусто.
//
// Возвращаемое значение:
//   Массив - структуры тестов:
//     Имя - Строка - имя теста (для запуска по имени)
//     Метод - Строка - имя метода (обычно равно Имя)
//     Описание - Строка - описание из аннотации
//     Теги - Строка - теги через запятую
//     Параметры - Структура - параметры из //&ПараметрыТеста
//     Отключен - Булево - тест отключён аннотацией //&ОтключаемыйТест
//     ПричинаОтключения - Строка - причина отключения
Функция СобратьТесты(Исходник, ИмяМодуля = "") Экспорт

	Результат = Новый Массив;
	Если ПустаяСтрока(Исходник) Тогда
		Возврат Результат;
	КонецЕсли;

	ТекущаяАннотация = Неопределено; // Структура аннотации ещё без имени метода
	Строки = СтрРазделить(Исходник, Символы.ПС, Ложь);

	Для Каждого Стр Из Строки Цикл
		Сокр = СокрЛП(Стр);
		Если Сокр = "" Тогда
			Продолжить;
		КонецЕсли;

		// Строка-аннотация: накапливаем на текущий (ещё безымянный) тест.
		Если СтрНачинаетсяС(Сокр, "//&") Тогда
			ОбработатьАннотацию(Сокр, ТекущаяАннотация);
			Продолжить;
		КонецЕсли;

		// Не аннотация и нет накопленной аннотации - тест ещё не начинался.
		Если ТекущаяАннотация = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		// Ищем объявление метода - оно завершает текущий тест.
		ИмяМетода = ИмяМетодаИзСтроки(Сокр);
		Если ПустаяСтрока(ИмяМетода) Тогда
			Продолжить;
		КонецЕсли;

		НовыйТест = Новый Структура("Имя, Метод, Описание, Теги, Параметры, Отключен, ПричинаОтключения");
		НовыйТест.Имя       = ИмяМетода;
		НовыйТест.Метод     = ИмяМетода;
		НовыйТест.Описание  = ТекущаяАннотация.Описание;
		НовыйТест.Теги      = ТекущаяАннотация.Теги;
		НовыйТест.Параметры = ТекущаяАннотация.Параметры;
		НовыйТест.Отключен  = ТекущаяАннотация.Отключен;
		НовыйТест.ПричинаОтключения = ТекущаяАннотация.Причина;
		Результат.Добавить(НовыйТест);

		ТекущаяАннотация = Неопределено;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Запускает тесты модуля, найденные по аннотациям //&Тест, и формирует результаты.
// Единая сигнатура {ok, message, value} - для вызова через мост СП_ВызовСервера.
//
// Параметры:
//   Параметры - Структура:
//     ИмяМодуля - Строка - программное имя модуля с тестами (обязательно).
//     ИсходникМодуля - Строка - BSL-исходник модуля (подаётся снаружи: EDT/конвертер/макет).
//     ИмяТеста - Строка - выбрать и запустить только один тест (необязательно).
//
// Возвращаемое значение:
//   Структура("ok, message, value") - value = Массив структур результатов
//   (единая модель Specter: Имя, Статус, Сообщение, ДлительностьМс, События, Ошибка).
Функция ЗапуститьТесты(Параметры) Экспорт

	Результат = Новый Структура("ok, message, value", Ложь, "", Неопределено);
	Если НЕ ЗначениеЗаполнено(Параметры) ИЛИ НЕ Параметры.Свойство("ИмяМодуля") Тогда
		Результат.message = "Не задан ИмяМодуля";
		Возврат Результат;
	КонецЕсли;

	ИмяМодуля = СокрЛП(Параметры.ИмяМодуля);
	Исходник = ?(Параметры.Свойство("ИсходникМодуля"), Строка(Параметры.ИсходникМодуля), "");
	ИмяТеста = ?(Параметры.Свойство("ИмяТеста"), Строка(Параметры.ИмяТеста), "");

	Тесты = СобратьТесты(Исходник, ИмяМодуля);
	Результаты = Новый Массив;
	Для Каждого Тест Из Тесты Цикл
		Если НЕ ПустаяСтрока(ИмяТеста) И Тест.Имя <> ИмяТеста Тогда
			Продолжить;
		КонецЕсли;
		Результаты.Добавить(ВыполнитьАннотированныйТест(ИмяМодуля, Тест));
	КонецЦикла;

	Результат.ok = Истина;
	Результат.value = Результаты;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выполняет один аннотированный тест в текущем (серверном) контексте.
Функция ВыполнитьАннотированныйТест(ИмяМодуля, Тест)

	ДатаНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Если Тест.Отключен Тогда
		Причина = ?(ПустаяСтрока(Тест.ПричинаОтключения), "Тест отключён аннотацией", Тест.ПричинаОтключения);
		Возврат Новый Структура(
			"Имя, Статус, Сообщение, ДлительностьМс, События, Ошибка",
			Тест.Имя, "skipped", Причина, 0, Новый Массив, "");
	КонецЕсли;

	Попытка
		//@skip-check bsl-legacy-check-execute-statement
		Выполнить(ИмяМодуля + "." + Тест.Метод + "()");
		Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - ДатаНачала;
		Возврат Новый Структура(
			"Имя, Статус, Сообщение, ДлительностьМс, События, Ошибка",
			Тест.Имя, "passed", "Тест выполнен успешно", Длительность, Новый Массив, "");
	Исключение
		Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - ДатаНачала;
		ТекстОшибки = ОписаниеОшибки();
		Статус = ?(СтрНайти(ТекстОшибки, "ASSERT_FAILED") > 0, "failed", "aborted");
		Возврат Новый Структура(
			"Имя, Статус, Сообщение, ДлительностьМс, События, Ошибка",
			Тест.Имя, Статус, ТекстОшибки, Длительность, Новый Массив, ТекстОшибки);
	КонецПопытки;

КонецФункции

// Обрабатывает одну строку аннотации, накапливая состояние в ТекущаяАннотация.

// Обрабатывает одну строку аннотации, накапливая состояние в ТекущаяАннотация.
Процедура ОбработатьАннотацию(Строка, ТекущаяАннотация)

	Если ТекущаяАннотация = Неопределено Тогда
		ТекущаяАннотация = Новый Структура("Описание, Теги, Параметры, Отключен, Причина", "", "", Неопределено, Ложь, "");
	КонецЕсли;

	Если СтрНачинаетсяС(Строка, "//&Тест") Тогда
		РазобратьАннотациюТест(Строка, ТекущаяАннотация);
	ИначеЕсли СтрНачинаетсяС(Строка, "//&ПараметрыТеста") Тогда
		ТекущаяАннотация.Параметры = РазобратьПараметры(Строка);
	ИначеЕсли СтрНачинаетсяС(Строка, "//&ОтключаемыйТест") ИЛИ СтрНачинаетсяС(Строка, "//&ОтключенныйТест") Тогда
		ТекущаяАннотация.Отключен = Истина;
		ТекущаяАннотация.Причина = ПервыйСтроковыйАргумент(Строка);
	КонецЕсли;

КонецПроцедуры

// Разбирает "//&Тест(...)" - извлекает (опционально) описание и теги в кавычках.
Процедура РазобратьАннотациюТест(Строка, Аннотация)

	Аргументы = АргументыВСкобках(Строка);
	Если Аргументы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Список = ЗначенияВКавычках(Аргументы);
	Если Список.Количество() > 0 Тогда
		Аннотация.Описание = Список[0];
	КонецЕсли;
	Если Список.Количество() > 1 Тогда
		Аннотация.Теги = Список[1];
	КонецЕсли;

КонецПроцедуры

// Разбирает "//&ПараметрыТеста("К1=Зн1;К2=Зн2")" в Структуру.
Функция РазобратьПараметры(Строка)

	Аргументы = АргументыВСкобках(Строка);
	Если Аргументы = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Значение = ЗначенияВКавычках(Аргументы);
	Если Значение.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Параметры = Новый Структура;
	Части = СтрРазделить(Значение[0], ";", Ложь);
	Для Каждого Часть Из Части Цикл
		ПозицияРавно = СтрНайти(Часть, "=");
		Если ПозицияРавно = 0 Тогда
			Продолжить;
		КонецЕсли;
		Ключ = СокрЛП(Лев(Часть, ПозицияРавно - 1));
		ЗначениеПараметра = СокрЛП(Сред(Часть, ПозицияРавно + 1));
		Если НЕ ПустаяСтрока(Ключ) Тогда
			Параметры.Вставить(Ключ, ЗначениеПараметра);
		КонецЕсли;
	КонецЦикла;

	Возврат Параметры;

КонецФункции

// Извлекает текст в скобках после имени аннотации; если скобок нет - Неопределено.
Функция АргументыВСкобках(Строка)

	Скобка = СтрНайти(Строка, "(");
	Если Скобка = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	КонецСкобки = СтрНайти(Строка, ")");
	Если КонецСкобки <= Скобка Тогда
		Возврат "";
	КонецЕсли;
	Возврат Сред(Строка, Скобка + 1, КонецСкобки - Скобка - 1);

КонецФункции

// Извлекает все значения, обёрнутые в двойные кавычки, из текста (без кавычек).
Функция ЗначенияВКавычках(Текст)

	Результат = Новый Массив;
	Позиция = 1;
	Пока Истина Цикл
		Откр = СтрНайти(Текст, """",, Позиция);
		Если Откр = 0 Тогда
			Прервать;
		КонецЕсли;
		Закр = СтрНайти(Текст, """",, Откр + 1);
		Если Закр = 0 Тогда
			Прервать;
		КонецЕсли;
		Результат.Добавить(Сред(Текст, Откр + 1, Закр - Откр - 1));
		Позиция = Закр + 1;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Возвращает первый строковый аргумент в аннотации (причину отключения и т.п.).
Функция ПервыйСтроковыйАргумент(Строка)

	Аргументы = АргументыВСкобках(Строка);
	Если Аргументы = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Список = ЗначенияВКавычках(Аргументы);
	Если Список.Количество() > 0 Тогда
		Возврат Список[0];
	КонецЕсли;
	Возврат "";

КонецФункции

// Из строки объявления метода возвращает имя метода, иначе пустую строку.
Функция ИмяМетодаИзСтроки(Строка)

	Правка = СокрЛП(Строка);
	Префикс = "";
	Если СтрНачинаетсяС(Правка, "Процедура ") Тогда
		Префикс = "Процедура ";
	ИначеЕсли СтрНачинаетсяС(Правка, "Функция ") Тогда
		Префикс = "Функция ";
	Иначе
		Возврат "";
	КонецЕсли;

	Хвост = СокрЛП(Сред(Правка, СтрДлина(Префикс) + 1));
	// Имя до первой '(' или пробела (сигнатура может быть без скобок).
	ПерваяСкобка = СтрНайти(Хвост, "(");
	ПервыйПробел = СтрНайти(Хвост, " ");
	Имя = "";
	Если ПерваяСкобка > 0 Тогда
		Имя = Лев(Хвост, ПерваяСкобка - 1);
	ИначеЕсли ПервыйПробел > 0 Тогда
		Имя = Лев(Хвост, ПервыйПробел - 1);
	Иначе
		Имя = Хвост;
	КонецЕсли;

	// Служебные методы движка тестами не считаем.
	Если Имя = "СписокТестов" ИЛИ Имя = "ЗапуститьНаборТестов"
		ИЛИ Имя = "ПередЗапускомТеста" ИЛИ Имя = "ПослеЗавершенияТеста" Тогда
		Возврат "";
	КонецЕсли;

	Возврат Имя;

КонецФункции

#КонецОбласти
