//©///////////////////////////////////////////////////////////////////////////©//
//  СП_ПроверкиДанныхСервер - серверные data-проверки (P2, парный серверный модуль).
//
//  Позволяет клиентскому E2E-тесту проверить влияние UI-действий НА БАЗУ: проведён ли
//  документ, появилась ли запись в регистре, каков остаток. Проверки выполняются на
//  сервере, но вызываются из клиентского шага прозрачно (серверный вызов), поэтому
//  разработчику не нужно писать «Серверные вызовы без контекста».
//
//  ЕДИНАЯ СИГНАТУРА: каждая проверка принимает один параметр Параметры (Структура с
//  простыми значениями/ссылками - сериализуем) и возвращает
//  Структура("ok, message, value"). Это даёт возможность универсального диспетчера
//  СП_ВызовСервера.Выполнить(...) вызывать любую проверку по имени.
//©///////////////////////////////////////////////////////////////////////////©//

#Область ПрограммныйИнтерфейс

// Проверка: документ проведён (или, если Проведен=Ложь, не проведён).
//
// Параметры:
//   Параметры - Структура:
//     Ссылка - ДокументСсылка.* - проверяемый документ (обязателен).
//     Проведен - Булево - ожидаемое состояние проведения (по умолчанию Истина).
//
// Возвращаемое значение:
//   Структура("ok, message, value").
Функция ПроверитьДокументПроведен(Параметры) Экспорт

	Результат = Новый Структура("ok, message, value", Ложь, "", Неопределено);
	Ссылка = ?(ЗначениеЗаполнено(Параметры) И Параметры.Свойство("Ссылка"), Параметры.Ссылка, Неопределено);
	Ожидаемое = ?(ЗначениеЗаполнено(Параметры) И Параметры.Свойство("Проведен"), Параметры.Проведен, Истина);

	Если ТипЗнч(Ссылка) <> Тип("ДокументСсылка") Тогда
		Результат.message = "Не передана ссылка на документ в Параметры.Ссылка";
		Возврат Результат;
	КонецЕсли;

	Факт = Ссылка.Проведен;
	Результат.ok = (Факт = Ожидаемое);
	Результат.value = Факт;
	Результат.message = ?(Результат.ok, "", "Проведение документа '" + Строка(Ссылка)
		+ "': ожидал '" + Строка(Ожидаемое) + "', получил '" + Строка(Факт) + "'");
	Возврат Результат;

КонецФункции

// Проверка: в регистре существует запись, удовлетворяющая отбору.
//
// Параметры:
//   Параметры - Структура:
//     ИмяРегистра - Строка - имя регистра (без "РегистрСведений." и т.п.).
//     Вид - Строка - "Сведения" (по умолчанию), "Остатки" или "Обороты".
//     Ресурс - Строка - имя ресурса/измерения для остатков (по умолчанию первый ресурс).
//     Отбор - Структура - условия: Ключ = имя поля (измерения/реквизита), Значение = значение.
//     ЕстьЗапись - Булево - ожидаемое наличие (по умолчанию Истина).
//
// Возвращаемое значение:
//   Структура("ok, message, value") - value = Ложь/Истина (запись существует).
Функция ПроверитьЗаписьРегистра(Параметры) Экспорт

	Результат = Новый Структура("ok, message, value", Ложь, "", Ложь);
	ИмяРегистра = ЗначениеСвойстваПараметра(Параметры, "ИмяРегистра", "");
	Вид = НРег(ЗначениеСвойстваПараметра(Параметры, "Вид", "Сведения"));
	ЕстьЗапись = ?(ЗначениеЗаполнено(Параметры) И Параметры.Свойство("ЕстьЗапись"), Параметры.ЕстьЗапись, Истина);

	Если ПустаяСтрока(ИмяРегистра) Тогда
		Результат.message = "Не задано ИмяРегистра";
		Возврат Результат;
	КонецЕсли;

	Попытка
		Факт = ЕстьЗаписьВРегистре(ИмяРегистра, Вид, Параметры.Отбор);
	Исключение
		Результат.message = "Ошибка проверки регистра '" + ИмяРегистра + "': " + ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;

	Результат.ok = (Факт = ЕстьЗапись);
	Результат.value = Факт;
	Результат.message = ?(Результат.ok, "", "Регистр '" + ИмяРегистра + "': запись с отбором "
		+ СтрокаОтбора(Параметры.Отбор) + " ожидалась '" + Строка(ЕстьЗапись) + "', получено '" + Строка(Факт) + "'");
	Возврат Результат;

КонецФункции

// Проверка числового значения (остаток/сумма) ресурса регистра по отбору.
//
// Параметры:
//   ИмяРегистра - Строка - имя регистра.
//   Вид - Строка - "Остатки" (по умолчанию) или "Сведения".
//   Ресурс - Строка - имя ресурса.
//   Отбор - Структура - условия по измерениям/реквизитам.
//   Ожидаемое - Число - ожидаемое значение.
//
// Возвращаемое значение:
//   Структура("ok, message, value") - value = фактическое значение.
Функция ПроверитьЗначениеРегистра(Параметры) Экспорт

	Результат = Новый Структура("ok, message, value", Ложь, "", 0);
	ИмяРегистра = ЗначениеСвойстваПараметра(Параметры, "ИмяРегистра", "");
	Вид = НРег(ЗначениеСвойстваПараметра(Параметры, "Вид", "Остатки"));
	Ресурс = ЗначениеСвойстваПараметра(Параметры, "Ресурс", "");
	Ожидаемое = ЗначениеСвойстваПараметра(Параметры, "Ожидаемое", 0);

	Если ПустаяСтрока(ИмяРегистра) ИЛИ ПустаяСтрока(Ресурс) Тогда
		Результат.message = "Не заданы ИмяРегистра и/или Ресурс";
		Возврат Результат;
	КонецЕсли;

	Попытка
		Факт = ЗначениеРегистраПоОтбору(ИмяРегистра, Вид, Ресурс, Параметры.Отбор);
	Исключение
		Результат.message = "Ошибка чтения регистра '" + ИмяРегистра + "': " + ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;

	Результат.value = Факт;
	Результат.ok = (Факт = Ожидаемое);
	Результат.message = ?(Результат.ok, "", "Регистр '" + ИмяРегистра + "'.Ресурс '" + Ресурс
		+ "' по отбору " + СтрокаОтбора(Параметры.Отбор) + ": ожидал '" + Строка(Ожидаемое)
		+ "', получил '" + Строка(Факт) + "'");
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Безопасно читает свойство параметра со значением по умолчанию.
Функция ЗначениеСвойстваПараметра(Параметры, Ключ, ПоУмолчанию)

	Если Параметры = Неопределено Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Если Параметры.Свойство(Ключ) Тогда
		Возврат Параметры[Ключ];
	КонецЕсли;
	Возврат ПоУмолчанию;

КонецФункции

// Есть ли запись в регистре по отбору (Сведения/Остатки/Обороты).
Функция ЕстьЗаписьВРегистре(ИмяРегистра, Вид, Отбор)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", ТекущаяДата());
	Условия = УсловияОтбора(Запрос, Отбор, "Т");

	Если Вид = "СВЕДЕНИЯ" Тогда
		Источник = "РегистрСведений." + ИмяРегистра + " КАК Т";
	ИначеЕсли Вид = "ОБОРОТЫ" Тогда
		Источник = "РегистрНакопления." + ИмяРегистра + ".Обороты(&Период,,) КАК Т";
	Иначе // ОСТАТКИ и по умолчанию
		Источник = "РегистрНакопления." + ИмяРегистра + ".Остатки(&Период,) КАК Т";
	КонецЕсли;

	Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 1 КАК Есть ИЗ " + Источник;
	Если НЕ ПустаяСтрока(Условия) Тогда
		Текст = Текст + " ГДЕ " + Условия;
	КонецЕсли;
	Запрос.Текст = Текст;

	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат НЕ Выборка.Пустая();

КонецФункции

// Числовое значение ресурса регистра по отбору (Сведения/Остатки).
Функция ЗначениеРегистраПоОтбору(ИмяРегистра, Вид, Ресурс, Отбор)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", ТекущаяДата());
	Условия = УсловияОтбора(Запрос, Отбор, "Т");

	Если Вид = "СВЕДЕНИЯ" Тогда
		Источник = "РегистрСведений." + ИмяРегистра + " КАК Т";
		Выражение = "Т." + Ресурс;
	Иначе
		Источник = "РегистрНакопления." + ИмяРегистра + ".Остатки(&Период,) КАК Т";
		Выражение = "СУММА(Т." + Ресурс + ")";
	КонецЕсли;

	Текст = "ВЫБРАТЬ " + Выражение + " КАК Значение ИЗ " + Источник;
	Если НЕ ПустаяСтрока(Условия) Тогда
		Текст = Текст + " ГДЕ " + Условия;
	КонецЕсли;
	Запрос.Текст = Текст;

	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	РезультатЗапроса.Следующий();
	Если РезультатЗапроса.Пустая() ИЛИ НЕ РезультатЗапроса.Свойство("Значение") Тогда
		Возврат 0;
	КонецЕсли;
	Значение = РезультатЗапроса.Значение;
	Возврат ?(Значение = Неопределено, 0, Значение);

КонецФункции

// Строит текст условий отбора и регистрирует параметры запроса. Префикс - "Т".
Функция УсловияОтбора(Запрос, Отбор, Префикс)

	Если НЕ ЗначениеЗаполнено(Отбор) Тогда
		Возврат "";
	КонецЕсли;

	Части = Новый Массив;
	Индекс = 0;
	Для Каждого КлючЗначение Из Отбор Цикл
		Индекс = Индекс + 1;
		ИмяПараметра = "Отбор" + Формат(Индекс, "ЧЦ=3; ЧВН=");
		Запрос.УстановитьПараметр(ИмяПараметра, КлючЗначение.Значение);
		Части.Добавить(Префикс + "." + КлючЗначение.Ключ + " = &" + ИмяПараметра);
	КонецЦикла;
	Возврат СтрСоединить(Части, " И ");

КонецФункции

// Строковое представление отбора для сообщения об ошибке.
Функция СтрокаОтбора(Отбор)

	Если НЕ ЗначениеЗаполнено(Отбор) Тогда
		Возврат "<без отбора>";
	КонецЕсли;
	Части = Новый Массив;
	Для Каждого КлючЗначение Из Отбор Цикл
		Части.Добавить(КлючЗначение.Ключ + "=" + Строка(КлючЗначение.Значение));
	КонецЦикла;
	Возврат "{" + СтрСоединить(Части, "; ") + "}";

КонецФункции

#КонецОбласти
