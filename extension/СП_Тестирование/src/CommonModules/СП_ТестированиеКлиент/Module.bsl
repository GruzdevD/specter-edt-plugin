// Модульное поле клиентского модуля (Перем объявляется только вне областей).
//@skip-check bsl-legacy-check-library-module
Перем ПамятьСценария;

#Область ПрограммныйИнтерфейс

//@skip-check doc-comment-collection-item-type
// Запуск набора или отдельного теста на клиенте (UI Context).
//
// Параметры:
//  ИмяМодуля - Строка - имя тестового модуля.
//  Критерии - Структура, Неопределено - критерии запуска; могут содержать
//   свойство "ИмяТеста" с именем отдельного теста.
//
// Возвращаемое значение:
//  Массив - массив структур результатов (единая модель Specter).
//@skip-check form-module-pragma
&НаКлиенте
Функция ЗапуститьНаборТестовКлиент(ИмяМодуля, Критерии = Неопределено) Экспорт

	Результаты = Новый Массив;
	ИмяТеста = ?(ЗначениеЗаполнено(Критерии) И Критерии.Свойство("ИмяТеста"), Критерии.ИмяТеста, "");

	// Инициализация контекстной памяти сценария (переменные $$X$$)
	ИнициализироватьКонтекстСценария();

	Попытка
		// Вариант 1: Модуль экспортирует ЗапуститьНаборТестов(Критерии)
		//@skip-check module-unused-local-variable
		КритерииВызова = Новый Структура("ИмяТеста, КлиентскийКонтекст", ИмяТеста, Истина);
		Возврат Вычислить(ИмяМодуля + ".ЗапуститьНаборТестов(КритерииВызова)");
	Исключение
		// Вариант 2: Прямой вызов процедуры теста
		Если ЗначениеЗаполнено(ИмяТеста) Тогда
			ДатаНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
			Попытка
				//@skip-check bsl-legacy-check-execute-statement
			Выполнить(ИмяМодуля + "." + ИмяТеста + "()");
				Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - ДатаНачала;
				//@skip-check structure-consructor-too-many-keys
				Рез = Новый Структура(
					"Имя, Статус, Сообщение, ДлительностьМс, События, Ошибка",
					ИмяТеста, "passed", "Тест выполнен успешно в UI-контексте", Длительность, Новый Массив, "");
			Исключение
				Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - ДатаНачала;
				ТекстОшибки = ОписаниеОшибки();
				Статус = ?(СтрНайти(ТекстОшибки, "ASSERT_FAILED") > 0, "failed", "aborted");
				СкриншотBase64 = "";
				//@skip-check empty-except-statement
				Попытка
					//@skip-check bsl-legacy-check-dynamic-feature-access
					СкриншотBase64 = СП_ПротоколВызовСервера.СформироватьСкриншотBase64();
				Исключение
				КонецПопытки;
				//@skip-check structure-consructor-too-many-keys
				Рез = Новый Структура(
					"Имя, Статус, Сообщение, ДлительностьМс, События, Ошибка, screenshotBase64",
					ИмяТеста, Статус, ТекстОшибки, Длительность, Новый Массив, ТекстОшибки, СкриншотBase64);
			КонецПопытки;

			Результаты.Добавить(Рез);
			Возврат Результаты;
		Иначе
			ВызватьИсключение "Модуль " + ИмяМодуля + " не может быть запущен на клиенте: " + ОписаниеОшибки();
		КонецЕсли;
	КонецПопытки;

КонецФункции

// Запускает тесты модуля по аннотациям //&Тест (Annotation Discovery, P0).
//
// В отличие от ЗапуститьНаборТестовКлиент, не требует рукописных СписокТестов()/
// ЗапуститьНаборТестов(): тесты находятся разбором исходника серверным модулем
// СП_ОбнаружениеТестов. Тестовый модуль должен быть серверным (вызов через мост
// СП_ВызовСервера в серверном контексте).
//
// Параметры:
//   ИмяМодуля - Строка - программное имя модуля с тестами.
//   ИсходникМодуля - Строка - BSL-исходник модуля (подаётся снаружи/макетом).
//   Критерии - Структура, Неопределено - опционально свойство "ИмяТеста".
//
// Возвращаемое значение:
//   Массив - массив структур результатов (единая модель Specter).
//@skip-check form-module-pragma
&НаКлиенте
Функция ЗапуститьМодульПоАннотациям(ИмяМодуля, ИсходникМодуля, Критерии = Неопределено) Экспорт

	Параметры = Новый Структура("ИмяМодуля, ИсходникМодуля", ИмяМодуля, ИсходникМодуля);
	Если ЗначениеЗаполнено(Критерии) И Критерии.Свойство("ИмяТеста") Тогда
		Параметры.Вставить("ИмяТеста", Критерии.ИмяТеста);
	КонецЕсли;

	Рез = ЗапуститьТестыПоАннотациямНаСервере(Параметры);
	Если ТипЗнч(Рез) <> Тип("Структура") ИЛИ НЕ Рез.Свойство("value") Тогда
		ВызватьИсключение "ASSERT_FAILED: модуль по аннотациям '" + ИмяМодуля + "' не вернул результаты";
	КонецЕсли;
	Возврат Рез.value;

КонецФункции

// Серверная обёртка запуска тестов по аннотациям через мост СП_ВызовСервера.
//@skip-check form-module-pragma
&НаСервере
Функция ЗапуститьТестыПоАннотациямНаСервере(Параметры)

	Возврат СП_ВызовСервера.ВыполнитьМетод("ЗапуститьТесты", Параметры, "СП_ОбнаружениеТестов");

КонецФункции

// Запускает тесты по явному списку целей, переданному от EDT-плагина (Annotation
// Discovery: плагин собирает цели парсингом //&Тест на build-time и присылает их
// в командах моста — движок больше не полагается на контракт СписокТестов/
// ЗапуститьНаборТестов в тестовом модуле).
//
// Параметры:
//   Цели - Массив - массив структур {Модуль, Метод} для динамического запуска.
//
// Возвращаемое значение:
//   Массив - массив структур результатов (единая модель Specter).
//@skip-check form-module-pragma
&НаКлиенте
Функция ЗапуститьМодульПоЦелям(Цели) Экспорт

	Результаты = Новый Массив;
	Если НЕ ЗначениеЗаполнено(Цели) Тогда
		Возврат Результаты;
	КонецЕсли;

	Для Каждого Цель Из Цели Цикл
		ИмяМодуля = ?(Цель.Свойство("Модуль"), Строка(Цель.Модуль), "");
		ИмяМетода = ?(Цель.Свойство("Метод"), Строка(Цель.Метод), "");
		Если ПустаяСтрока(ИмяМодуля) ИЛИ ПустаяСтрока(ИмяМетода) Тогда
			Продолжить;
		КонецЕсли;
		Результаты.Добавить(ВыполнитьЦель(ИмяМодуля, ИмяМетода));
	КонецЦикла;

	Возврат Результаты;

КонецФункции

// Выполняет одну цель {ИмяМодуля, ИмяМетода} в защитном блоке с опциональными
// хуками ПередЗапускомТеста/ПослеЗавершенияТеста (проверка через МетодСуществует).
//@skip-check form-module-pragma
&НаКлиенте
Функция ВыполнитьЦель(ИмяМодуля, ИмяМетода)

	ДатаНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Рез = Новый Структура("Имя, Статус, Сообщение, ДлительностьМс, События, Ошибка");

	Попытка
		// Опциональный хук подготовки (может отсутствовать у рукописного модуля —
		// «Метод не обнаружен» от Выполнить() глотаем в Исключение).
		Попытка
			//@skip-check bsl-legacy-check-execute-statement
			Выполнить(ИмяМодуля + ".ПередЗапускомТеста()");
		Исключение
			// сломанный/отсутствующий хук не роняет тест (успех теста важнее подготовки)
		КонецПопытки;

		//@skip-check bsl-legacy-check-execute-statement
		Выполнить(ИмяМодуля + "." + ИмяМетода + "()");

		Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - ДатаНачала;
		Рез.Имя = ИмяМетода;
		Рез.Статус = "passed";
		Рез.Сообщение = "Тест выполнен успешно";
		Рез.ДлительностьМс = Длительность;
		Рез.События = Новый Массив;
		Рез.Ошибка = "";
	Исключение
		Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - ДатаНачала;
		ТекстОшибки = ОписаниеОшибки();
		Рез.Имя = ИмяМетода;
		Рез.Статус = ?(СтрНайти(ТекстОшибки, "ASSERT_FAILED") > 0, "failed", "aborted");
		Рез.Сообщение = ТекстОшибки;
		Рез.ДлительностьМс = Длительность;
		Рез.События = Новый Массив;
		Рез.Ошибка = ТекстОшибки;
	КонецПопытки;

	// Гарантированный teardown на уровне движка (в 1С нет finally): вызываем
	// ПослеЗавершенияТеста И при падении, и при успехе. Собственный Попытка
	// внутри каждой ветки гарантирует, что ошибка очистки не маскирует результат.
	Попытка
		//@skip-check bsl-legacy-check-execute-statement
		Выполнить(ИмяМодуля + ".ПослеЗавершенияТеста()");
	Исключение
		// не маскируем первопричину ошибкой очистки
	КонецПопытки;

	Возврат Рез;

КонецФункции

// Универсальное открытие формы по навигационной ссылке e1cib или имени метаданных.
// Поддерживает:
//  - e1cib/list/Документ.ЗаказПокупателя -> Документ.ЗаказПокупателя.ФормаСписка
//  - e1cib/data/Справочник.Номенклатура?ref=... -> Справочник.Номенклатура.ФормаОбъекта
//  - Прямые пути: Документ.Заявка.Форма.ФормаДокумента, Справочник.Контрагенты.ФормаСписка
//
// Параметры:
//  ПутьИлиСсылка - Строка - e1cib-ссылка или имя метаданных формы.
//  ПараметрыФормы - Структура, Неопределено - параметры открываемой формы.
//  Владелец - Форма, Неопределено - форма-владелец.
//
// Возвращаемое значение:
//  Форма - открытая форма, либо Неопределено при отсутствии результата.
//@skip-check form-module-pragma
&НаКлиенте
Функция ОткрытьФормуУниверсально(ПутьИлиСсылка, ПараметрыФормы = Неопределено, Владелец = Неопределено) Экспорт

	ИмяФормы = РазрешитьИмяФормы(ПутьИлиСсылка);
	
	Параметры = ?(ПараметрыФормы <> Неопределено, ПараметрыФормы, Новый Структура);

	Попытка
		//@skip-check use-non-recommended-method
		Форма = ПолучитьФорму(ИмяФормы, Параметры, Владелец);
		Если Форма = Неопределено Тогда
			ВызватьИсключение "Платформа 1С вернула Неопределено для формы '" + ИмяФормы + "'";
		КонецЕсли;

		Форма.Открыть();
		Возврат Форма;
	Исключение
		// Честное пробрасывание ошибки открытия формы без маскировки
		ВызватьИсключение "Ошибка открытия формы '" + ИмяФормы + "': " + ОписаниеОшибки();
	КонецПопытки;

КонецФункции

// Разрешение e1cib ссылок и коротких алиасов в полное имя формы 1С
//
// Параметры:
//  ПутьИлиСсылка - Строка - e1cib-ссылка, короткий алиас или имя формы.
//
// Возвращаемое значение:
//  Строка - полное имя формы 1С.
//@skip-check form-module-pragma
&НаКлиенте
Функция РазрешитьИмяФормы(ПутьИлиСсылка) Экспорт

	Путь = СокрЛП(ПутьИлиСсылка);

	// 1. Ссылки e1cib/list/<Метаданное>
	Если СтрНачинаетсяС(НРег(Путь), "e1cib/list/") Тогда
		ИмяОбъекта = Сред(Путь, 12);
		// Отрезаем возможные параметры query string
		ПозВопроса = СтрНайти(ИмяОбъекта, "?");
		Если ПозВопроса > 0 Тогда
			ИмяОбъекта = Лев(ИмяОбъекта, ПозВопроса - 1);
		КонецЕсли;
		Возврат ИмяОбъекта + ".ФормаСписка";
	КонецЕсли;

	// 2. Ссылки e1cib/data/<Метаданное>
	Если СтрНачинаетсяС(НРег(Путь), "e1cib/data/") Тогда
		ИмяОбъекта = Сред(Путь, 12);
		ПозВопроса = СтрНайти(ИмяОбъекта, "?");
		Если ПозВопроса > 0 Тогда
			ИмяОбъекта = Лев(ИмяОбъекта, ПозВопроса - 1);
		КонецЕсли;
		Возврат ИмяОбъекта + ".ФормаОбъекта";
	КонецЕсли;

	// 3. Ссылки e1cib/app/<ИмяОбработки>
	Если СтрНачинаетсяС(НРег(Путь), "e1cib/app/") Тогда
		ИмяОбъекта = Сред(Путь, 11);
		Возврат ИмяОбъекта + ".Форма";
	КонецЕсли;

	// 4. Проверка через реестр СП_СправочникИменКлиент (если это короткий алиас)
	//@skip-check empty-except-statement
	Попытка
		РеестрФорм = СП_СправочникИменКлиент.Формы();
		Если РеестрФорм.Свойство(Путь) Тогда
			Возврат РеестрФорм[Путь].Форма;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат Путь;

КонецФункции

// =========================================================================
// КОНТЕКСТНАЯ ПАМЯТЬ СЦЕНАРИЯ (Переменные $$X$$ и $X$)
// =========================================================================

// Инициализация контекстной памяти сценария (переменные $$X$$).
//@skip-check form-module-pragma
&НаКлиенте
Процедура ИнициализироватьКонтекстСценария() Экспорт
	ПамятьСценария = Новый Соответствие;
КонецПроцедуры

// Сохранение значения в контекстную память сценария.
//
// Параметры:
//  ИмяПеременной - Строка - имя переменной (плейсхолдера).
//  Значение - Произвольный - сохраняемое значение.
//@skip-check form-module-pragma
&НаКлиенте
Процедура СохранитьВПамять(ИмяПеременной, Значение) Экспорт
	Если ПамятьСценария = Неопределено Тогда
		ПамятьСценария = Новый Соответствие;
	КонецЕсли;
	ЧистоеИмя = ОчиститьИмяПеременной(ИмяПеременной);
	ПамятьСценария.Вставить(ЧистоеИмя, Значение);
КонецПроцедуры

// Получение значения из контекстной памяти сценария по имени переменной.
//
// Параметры:
//  ИмяПеременной - Строка - имя переменной (плейсхолдера).
//  ЗначениеПоУмолчанию - Произвольный - значение, возвращаемое при отсутствии
//   переменной в памяти.
//
// Возвращаемое значение:
//  Произвольный - сохранённое значение, либо ЗначениеПоУмолчанию.
//@skip-check form-module-pragma
&НаКлиенте
Функция ПолучитьИзПамяти(ИмяПеременной, ЗначениеПоУмолчанию = "") Экспорт
	Если ПамятьСценария = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	ЧистоеИмя = ОчиститьИмяПеременной(ИмяПеременной);
	Если ПамятьСценария.Свойство(ЧистоеИмя) Тогда
		Возврат ПамятьСценария[ЧистоеИмя];
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;
КонецФункции

// Удаление одной переменной из контекстной памяти сценария.
//
// Параметры:
//  ИмяПеременной - Строка - имя переменной (плейсхолдера) для удаления.
//@skip-check form-module-pragma
&НаКлиенте
Процедура ОчиститьПеременную(ИмяПеременной) Экспорт
	Если ПамятьСценария = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЧистоеИмя = ОчиститьИмяПеременной(ИмяПеременной);
	Если ПамятьСценария.Свойство(ЧистоеИмя) Тогда
		ПамятьСценария.Удалить(ЧистоеИмя);
	КонецЕсли;
КонецПроцедуры

// Полная очистка контекстной памяти сценария (все переменные).
//@skip-check form-module-pragma
&НаКлиенте
Процедура ОчиститьПеременныеСценария() Экспорт
	ПамятьСценария = Новый Соответствие;
КонецПроцедуры

// Подстановка плейсхолдеров $$Имя$$ или $Имя$ из памяти
//
// Параметры:
//  ИсходноеЗначение - Произвольный - обрабатываемое значение; строковые
//   плейсхолдеры подставляются из памяти сценария.
//
// Возвращаемое значение:
//  Произвольный - значение с подставленными плейсхолдерами.
//@skip-check form-module-pragma
&НаКлиенте
Функция ВычислитьЗначениеСПамятью(ИсходноеЗначение) Экспорт

	Если ТипЗнч(ИсходноеЗначение) <> Тип("Строка") Тогда
		Возврат ИсходноеЗначение;
	КонецЕсли;

	СтрокаЗнач = ИсходноеЗначение;
	
	// Если это единичный плейсхолдер $$Имя$$
	Если СтрНачинаетсяС(СтрокаЗнач, "$$") И Прав(СтрокаЗнач, 2) = "$$" И СтрДлина(СтрокаЗнач) > 4 Тогда
		ИмяВар = Сред(СтрокаЗнач, 3, СтрДлина(СтрокаЗнач) - 4);
		Возврат ПолучитьИзПамяти(ИмяВар, СтрокаЗнач);
	КонецЕсли;

	// Если это $Имя$
	Если СтрНачинаетсяС(СтрокаЗнач, "$") И Прав(СтрокаЗнач, 1) = "$" И СтрДлина(СтрокаЗнач) > 2 Тогда
		ИмяВар = Сред(СтрокаЗнач, 2, СтрДлина(СтрокаЗнач) - 2);
		Возврат ПолучитьИзПамяти(ИмяВар, СтрокаЗнач);
	КонецЕсли;

	Возврат СтрокаЗнач;

КонецФункции

// Установить описание текущего сценария (сохраняется в контексте для отчёта).
Функция УстановитьОписаниеСценария(Описание) Экспорт

	Результат = Новый Структура("ok, message", Ложь, "");
	Попытка
		СохранитьВПамять("ОписаниеСценария", Описание);
		Результат.ok = Истина;
		Результат.message = "Описание сценария сохранено";
	Исключение
		Результат.message = "Не удалось сохранить описание сценария: " + ОписаниеОшибки();
	КонецПопытки;
	//@skip-check constructor-function-return-section
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Очистка имени переменной от обрамляющих символов '$'.
//@skip-check form-module-pragma
&НаКлиенте
Функция ОчиститьИмяПеременной(ИмяПеременной)
	Рез = СокрЛП(ИмяПеременной);
	Пока СтрНачинаетсяС(Рез, "$") Цикл
		Рез = Сред(Рез, 2);
	КонецЦикла;
	Пока Прав(Рез, 1) = "$" Цикл
		Рез = Лев(Рез, СтрДлина(Рез) - 1);
	КонецЦикла;
	Возврат Рез;
КонецФункции

#КонецОбласти
