// Модульное поле клиентского модуля (Перем объявляется только вне областей).
Перем мПамятьСценария;

#Область ПрограммныйИнтерфейс

// Запуск набора или отдельного теста на клиенте (UI Context).
// Возвращает массив структур результатов (единая модель Specter).
&НаКлиенте
Функция ЗапуститьНаборТестовКлиент(ИмяМодуля, Критерии = Неопределено) Экспорт

	Результаты = Новый Массив;
	ИмяТеста = ?(ЗначениеЗаполнено(Критерии) И Критерии.Свойство("ИмяТеста"), Критерии.ИмяТеста, "");

	// Инициализация контекстной памяти сценария (переменные $$X$$)
	ИнициализироватьКонтекстСценария();

	Попытка
		// Вариант 1: Модуль экспортирует ЗапуститьНаборТестов(Критерии)
		КритерииВызова = Новый Структура("ИмяТеста, КлиентскийКонтекст", ИмяТеста, Истина);
		Возврат Вычислить(ИмяМодуля + ".ЗапуститьНаборТестов(КритерииВызова)");
	Исключение
		// Вариант 2: Прямой вызов процедуры теста
		Если ЗначениеЗаполнено(ИмяТеста) Тогда
			ДатаНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
			Попытка
				Выполнить(ИмяМодуля + "." + ИмяТеста + "()");
				Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - ДатаНачала;
				Рез = Новый Структура(
					"Имя, Статус, Сообщение, ДлительностьМс, События, Ошибка",
					ИмяТеста, "passed", "Тест выполнен успешно в UI-контексте", Длительность, Новый Массив, "");
			Исключение
				Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - ДатаНачала;
				ТекстОшибки = ОписаниеОшибки();
				Статус = ?(СтрНайти(ТекстОшибки, "ASSERT_FAILED") > 0, "failed", "aborted");
				Рез = Новый Структура(
					"Имя, Статус, Сообщение, ДлительностьМс, События, Ошибка",
					ИмяТеста, Статус, ТекстОшибки, Длительность, Новый Массив, ТекстОшибки);
			КонецПопытки;

			Результаты.Добавить(Рез);
			Возврат Результаты;
		Иначе
			ВызватьИсключение "Модуль " + ИмяМодуля + " не может быть запущен на клиенте: " + ОписаниеОшибки();
		КонецЕсли;
	КонецПопытки;

КонецФункции

// Универсальное открытие формы по навигационной ссылке e1cib или имени метаданных.
// Поддерживает:
//  - e1cib/list/Документ.ЗаказПокупателя -> Документ.ЗаказПокупателя.ФормаСписка
//  - e1cib/data/Справочник.Номенклатура?ref=... -> Справочник.Номенклатура.ФормаОбъекта
//  - Прямые пути: Документ.Заявка.Форма.ФормаДокумента, Справочник.Контрагенты.ФормаСписка
&НаКлиенте
Функция ОткрытьФормуУниверсально(ПутьИлиСсылка, ПараметрыФормы = Неопределено, Владелец = Неопределено) Экспорт

	ИмяФормы = РазрешитьИмяФормы(ПутьИлиСсылка);
	
	Параметры = ?(ПараметрыФормы <> Неопределено, ПараметрыФормы, Новый Структура);

	Попытка
		Форма = ПолучитьФорму(ИмяФормы, Параметры, Владелец);
		Если Форма = Неопределено Тогда
			ВызватьИсключение "Платформа 1С вернула Неопределено для формы '" + ИмяФормы + "'";
		КонецЕсли;

		Форма.Открыть();
		Возврат Форма;
	Исключение
		// Честное пробрасывание ошибки открытия формы без маскировки
		ВызватьИсключение "Ошибка открытия формы '" + ИмяФормы + "': " + ОписаниеОшибки();
	КонецПопытки;

КонецФункции

// Разрешение e1cib ссылок и коротких алиасов в полное имя формы 1С
&НаКлиенте
Функция РазрешитьИмяФормы(ПутьИлиСсылка) Экспорт

	Путь = СокрЛП(ПутьИлиСсылка);

	// 1. Ссылки e1cib/list/<Метаданное>
	Если СтрНачинаетсяС(НРег(Путь), "e1cib/list/") Тогда
		ИмяОбъекта = Сред(Путь, 12);
		// Отрезаем возможные параметры query string
		ПозВопроса = СтрНайти(ИмяОбъекта, "?");
		Если ПозВопроса > 0 Тогда
			ИмяОбъекта = Лев(ИмяОбъекта, ПозВопроса - 1);
		КонецЕсли;
		Возврат ИмяОбъекта + ".ФормаСписка";
	КонецЕсли;

	// 2. Ссылки e1cib/data/<Метаданное>
	Если СтрНачинаетсяС(НРег(Путь), "e1cib/data/") Тогда
		ИмяОбъекта = Сред(Путь, 12);
		ПозВопроса = СтрНайти(ИмяОбъекта, "?");
		Если ПозВопроса > 0 Тогда
			ИмяОбъекта = Лев(ИмяОбъекта, ПозВопроса - 1);
		КонецЕсли;
		Возврат ИмяОбъекта + ".ФормаОбъекта";
	КонецЕсли;

	// 3. Ссылки e1cib/app/<ИмяОбработки>
	Если СтрНачинаетсяС(НРег(Путь), "e1cib/app/") Тогда
		ИмяОбъекта = Сред(Путь, 11);
		Возврат ИмяОбъекта + ".Форма";
	КонецЕсли;

	// 4. Проверка через реестр СП_СправочникИменКлиент (если это короткий алиас)
	Попытка
		РеестрФорм = СП_СправочникИменКлиент.Формы();
		Если РеестрФорм.Свойство(Путь) Тогда
			Возврат РеестрФорм[Путь].Форма;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат Путь;

КонецФункции

// =========================================================================
// КОНТЕКСТНАЯ ПАМЯТЬ СЦЕНАРИЯ (Переменные $$X$$ и $X$)
// =========================================================================

&НаКлиенте
Процедура ИнициализироватьКонтекстСценария() Экспорт
	мПамятьСценария = Новый Соответствие;
КонецПроцедуры

&НаКлиенте
Процедура СохранитьВПамять(ИмяПеременной, Значение) Экспорт
	Если мПамятьСценария = Неопределено Тогда
		мПамятьСценария = Новый Соответствие;
	КонецЕсли;
	ЧистоеИмя = ОчиститьИмяПеременной(ИмяПеременной);
	мПамятьСценария.Вставить(ЧистоеИмя, Значение);
КонецПроцедуры

&НаКлиенте
Функция ПолучитьИзПамяти(ИмяПеременной, ЗначениеПоУмолчанию = "") Экспорт
	Если мПамятьСценария = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	ЧистоеИмя = ОчиститьИмяПеременной(ИмяПеременной);
	Если мПамятьСценария.Свойство(ЧистоеИмя) Тогда
		Возврат мПамятьСценария[ЧистоеИмя];
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;
КонецФункции

// Подстановка плейсхолдеров $$Имя$$ или $Имя$ из памяти
&НаКлиенте
Функция ВычислитьЗначениеСПамятью(ИсходноеЗначение) Экспорт

	Если ТипЗнч(ИсходноеЗначение) <> Тип("Строка") Тогда
		Возврат ИсходноеЗначение;
	КонецЕсли;

	СтрокаЗнач = ИсходноеЗначение;
	
	// Если это единичный плейсхолдер $$Имя$$
	Если СтрНачинаетсяС(СтрокаЗнач, "$$") И Прав(СтрокаЗнач, 2) = "$$" И СтрДлина(СтрокаЗнач) > 4 Тогда
		ИмяВар = Сред(СтрокаЗнач, 3, СтрДлина(СтрокаЗнач) - 4);
		Возврат ПолучитьИзПамяти(ИмяВар, СтрокаЗнач);
	КонецЕсли;

	// Если это $Имя$
	Если СтрНачинаетсяС(СтрокаЗнач, "$") И Прав(СтрокаЗнач, 1) = "$" И СтрДлина(СтрокаЗнач) > 2 Тогда
		ИмяВар = Сред(СтрокаЗнач, 2, СтрДлина(СтрокаЗнач) - 2);
		Возврат ПолучитьИзПамяти(ИмяВар, СтрокаЗнач);
	КонецЕсли;

	Возврат СтрокаЗнач;

КонецФункции

&НаКлиенте
Функция ОчиститьИмяПеременной(ИмяПеременной)
	Рез = СокрЛП(ИмяПеременной);
	Пока СтрНачинаетсяС(Рез, "$") Цикл
		Рез = Сред(Рез, 2);
	КонецЦикла;
	Пока Прав(Рез, 1) = "$" Цикл
		Рез = Лев(Рез, СтрДлина(Рез) - 1);
	КонецЦикла;
	Возврат Рез;
КонецФункции

#КонецОбласти
