//  СП_ТестовыйКлиент - расширение afm, UI-адаптер (Фаза A).
//
//  BSL-адаптер поверх механизма UI-автоматизации: «Клиент тестирования /
//  Менеджер тестирования» (полный test-client контур) ПЛЮС программный
//  (programmatic) контур, где работаем по управляемым формам afm напрямую.
//  Реализует примитивы канонической границы UiAdapter: click / setValue / select /
//  waitFor / assert / read / check / inspect / resolveLocator, с трёхзначным исходом
//  команды (ADR-004) и честной инспекцией.
//
//  ВНИМАНИЕ по API платформы: нативные человекоподобные click/select поверх
//  «Менеджера тестирования» на macOS-связке afm НЕ проверялись реальным прогоном -
//  такие члены собраны в отдельной области и помечены [НЕ ПРОВЕРЕНО на 1С до фазы B].
//  Секретов/строк подключения не хранит (ADR-006). Директивы: Сервер.
//©///////////////////////////////////////////////////////////////////////////©//

#Область ПрограммныйИнтерфейс

// Версия протокола адаптера (сверяется с packages/contracts/versions.json).
Функция ВерсияПротокола() Экспорт
	Возврат "1.0.0";
КонецФункции

// Механизм адаптера (ADR-002): 'test-client' - полный UI поверх Менеджера тестирования.
Функция Механизм() Экспорт

	Возврат "test-client";

КонецФункции

// Capabilities адаптера (проекция packages/1c-extension/src/capabilities.ts).
Функция Возможности() Экспорт

	Возможности = Новый Структура;

	Возможности.Вставить("Протокол",      ВерсияПротокола());
	Возможности.Вставить("Механизм",      Механизм());
	Возможности.Вставить("Конфигурация",  "afm");

	// Единый источник правды об исполнимости действий. Различаем:
	//  - programmatic-безопасные: реальное чтение слоя UI (Видимость/значение по реестру имён),
	//    waitFor/read/check/assert, и setValue как ЗАПИСЬ ПО ОБЪЕКТУ ФОРМЫ (НЕ равночестный
	//    UI-ввод: это programmatic контур, не симуляция ввода пользователя);
	//  - человеко-подобные click/select: требуют «Клиента тестирования/Менеджера тестирования»,
	//    на afm недоступны (НативныеДействияДоступны()=Ложь) -> честно объявлены НЕ поддерживаемыми.
	Действия = Новый Массив;
	Действия.Добавить("waitFor");
	Действия.Добавить("read");
	Действия.Добавить("check");
	Действия.Добавить("assert");
	Действия.Добавить("setValue"); // programmatic-запись по объекту формы; НЕ симуляция ввода

	Возможности.Вставить("Действия", Действия);

	Области = Новый Массив;
	Области.Добавить("form");
	Области.Добавить("table");
	Области.Добавить("list");
	Возможности.Вставить("Области", Области);

	Возможности.Вставить("ОперацииДанных", СП_ТестовыеДанные.ДоступныеОперации());

	Проверено = Новый Массив;
	Проверено.Добавить("programmatic: программное открытие форм (afm.Smoke-паттерн)");
	Проверено.Добавить("read/waitFor/assert по реальному слою UI (ЭтаФорма.Элементы.Найти(...).Видимость)");
	Проверено.Добавить("names: Catalog.Контрагенты / ФормаСписка / ФормаЭлемента / ИНН / НаименованиеСокращенное");
	Возможности.Вставить("Проверено", Проверено);

	// Честный блокер: человеко-подобный ввод на afm НЕ подтверждён. Фиктивный успех не возвращаем.
	НеПоддерживается = Новый Структура;
	ДействияНеПоддерж = Новый Массив;
	ДействияНеПоддерж.Добавить("click");
	ДействияНеПоддерж.Добавить("select");
	НеПоддерживается.Вставить("actions", ДействияНеПоддерж);
	НеПоддерживается.Вставить("reason",
		"click/select требуют платформенного «Клиента тестирования / Менеджера тестирования»; "
		+ "на afm НативныеДействияДоступны()=Ложь (не прогнано). Включите режим тестирования 1С "
		+ "или используйте programmatic-контур (не является симуляцией пользовательского ввода).");
	Возможности.Вставить("НеПоддерживается", НеПоддерживается);

	Возврат Возможности;

КонецФункции

// Подключение к живому UI (сессия SUT). НЕ возвращает фиктивный успех.
// ПараметрыСоединения - структура { mode : "test-client"|"programmatic" } (реальные строки
// подключения — от Runner'а через SecretStore/ref, ADR-006, в репозиторий не пишутся).
// Режим по умолчанию - programmatic (доступен на afm без тестового клиента).
Функция Подключиться(ПараметрыСоединения = Неопределено) Экспорт

	Режим = "programmatic";
	Если ЗначениеЗаполнено(ПараметрыСоединения) И ТипЗнч(ПараметрыСоединения) = Тип("Структура") Тогда
		Если ПараметрыСоединения.Свойство("mode") Тогда
			Режим = НРег(Строка(ПараметрыСоединения.mode));
		КонецЕсли;
	КонецЕсли;

	Если Режим = "test-client" Тогда
		// Честная проверка доступности «Клиента тестирования/Менеджера тестирования».
		Если НЕ НативныеДействияДоступны() Тогда
			ВызватьИсключение "UNSUPPORTED_ACTION: тестовый клиент на afm недоступен (НативныеДействияДоступны()=Ложь). "
				+ "Человеко-подобные click/select невозможны без включённого режима тестирования 1С. "
				+ "Используйте mode=programmatic (не является симуляцией пользовательского ввода).";
		КонецЕсли;
		// [НЕ ПРОВЕРЕНО на 1С до фазы B] ТМПодключитьсяКТестовомуКлиенту(ПараметрыСоединения);
		ИдСессии = Строка(Новый УникальныйИдентификатор);
		Возврат Новый Структура("Подключено, Сессия, Механизм", Истина, ИдСессии, "test-client");
	ИначеЕсли Режим = "programmatic" Тогда
		// programmatic-контур: работа по открытым управляемым формам (без ТМ). «Сессия» —
		// маркер программного контура, а не id соединения тестового клиента.
		ИдСессии = "programmatic:afm";
		Возврат Новый Структура("Подключено, Сессия, Механизм", Истина, ИдСессии, "programmatic");
	Иначе
		ВызватьИсключение "UNSUPPORTED_CONNECTION_MODE: неизвестный режим подключения '" + Режим + "'";
	КонецЕсли;

КонецФункции

// Отключение от живого UI и best-effort очистка.
Процедура Отключиться(Сессия) Экспорт

	// [НЕ ПРОВЕРЕНО на 1С до фазы B] ТМОтключитьсяОтТестовогоКлиента(Сессия);
	// programmatic-контур локальной очистки не требует (формы закрываются Runner'ом).

КонецПроцедуры

// Жёсткое разрешение локатора: ровно один / нет / несколько (НЕ выбирает первый молча).
Функция РазрешитьЛокатор(Локатор) Экспорт

	Вид = Локатор.kind;

	Если Вид = "form" Тогда
		Возврат РазрешитьФорму(Локатор);
	ИначеЕсли Вид = "name" Тогда
		Возврат РазрешитьИмя(Локатор);
	Иначе
		Возврат РезультатРазрешения("none", 0, Неопределено,
			"Вид локатора не поддерживается реестром имён afm: " + Вид);
	КонецЕсли;

КонецФункции

// Инспекция структуры UI (для отладки/ассертов). Значения полей по умолчанию НЕ раскрываются.
Функция Инспектировать(Локатор = Неопределено, Параметры = Неопределено) Экспорт

	Лимит = 100;
	Если ЗначениеЗаполнено(Параметры) И Параметры.Свойство("Лимит") Тогда
		Лимит = Параметры.Лимит;
	КонецЕсли;
	ВключатьЗначения = Ложь;
	Если ЗначениеЗаполнено(Параметры) И Параметры.Свойство("Значения") Тогда
		ВключатьЗначения = Параметры.Значения;
	КонецЕсли;

	Узлы = Новый Массив;

	Если Локатор = Неопределено Тогда
		Для Каждого Имя Из СП_СправочникИмен.ВсеИменаЭлементов() Цикл
			Если Узлы.Количество() >= Лимит Тогда
				Прервать;
			КонецЕсли;
			Узлы.Добавить(УзелИзЗаписи(Имя, СП_СправочникИмен.Элементы()[Имя], ВключатьЗначения));
		КонецЦикла;
	Иначе
		Результат = РазрешитьЛокатор(Локатор);
		Если Результат.Исход = "found" Тогда
			Узлы.Добавить(УзелИзЗаписи(Локатор.value, Результат.Кандидаты[0], ВключатьЗначения));
		КонецЕсли;
	КонецЕсли;

	Возврат Новый Структура("ok, limit, valuesOmitted, nodes", Истина, Лимит, НЕ ВключатьЗначения, Узлы);

КонецФункции

// Действие (высокоуровневое): click/setValue/select/waitFor/assert/read/check.
// Возвращает результат по ADR-004: { Disposition, ok, value, matched, error }.
Функция ВыполнитьДействие(Действие, Локатор, Значение = Неопределено, Свойство = "value",
	Ожидаемое = Неопределено, Состояние = "visible", ТаймаутМс = 15000) Экспорт

	Попытка

		Если Действие = "read" Тогда
			ЗначениеПрочитано = Прочитать(Локатор, Свойство);
			Возврат Новый Структура("Disposition, ok, value, matched", "executed", Истина, ЗначениеПрочитано, Истина);

		ИначеЕсли Действие = "check" Тогда
			Фактическое = Прочитать(Локатор, Свойство);
			Совпало = ПеремПроверитьПредикат(Ожидаемое, Фактическое);
			Возврат Новый Структура("Disposition, ok, value, matched", "executed", Совпало, Фактическое, Совпало);

		ИначеЕсли Действие = "assert" Тогда
			Фактическое = Прочитать(Локатор, Свойство);
			Совпало = СравнитьЗначения(Фактическое, Ожидаемое);
			Возврат Новый Структура("Disposition, ok, value, matched", "executed", Совпало, Фактическое, Совпало);

		ИначеЕсли Действие = "waitFor" Тогда
			Матрица = ОжидатьСостояние(Локатор, Состояние, ТаймаутМс);
			Возврат Новый Структура("Disposition, ok, value, matched",
				"executed", Матрица.matched, Матрица.value, Матрица.matched);

		ИначеЕсли Действие = "setValue" Тогда
			// programmatic-контур: запись значения в поле формы.
			УстановитьЗначение(Локатор, Значение);
			Возврат Новый Структура("Disposition, ok, value, matched", "executed", Истина, Значение, Истина);

		ИначеЕсли Действие = "click" Тогда
			// нативный тестовый клиент; на afm НЕ прогнан.
			Результат = НативныеДействияДоступны();
			Если НЕ Результат Тогда
				Возврат Новый Структура("Disposition, ok, value, matched, error",
					"not-sent", Ложь, Неопределено, Ложь,
					"UNSUPPORTED_ACTION: click не заявлен до Фазы B (тестовый клиент afm не прогнан)");
			КонецЕсли;
			НажатьЭлемент(Локатор);
			Возврат Новый Структура("Disposition, ok, value, matched", "executed", Истина, Неопределено, Истина);

		ИначеЕсли Действие = "select" Тогда
			Результат = НативныеДействияДоступны();
			Если НЕ Результат Тогда
				Возврат Новый Структура("Disposition, ok, value, matched, error",
					"not-sent", Ложь, Неопределено, Ложь,
					"UNSUPPORTED_ACTION: select не заявлен до Фазы B (тестовый клиент afm не прогнан)");
			КонецЕсли;
			ВыбратьЭлемент(Локатор, Строка(Значение));
			Возврат Новый Структура("Disposition, ok, value, matched", "executed", Истина, Строка(Значение), Истина);

		Иначе
			Возврат Новый Структура("Disposition, ok, value, matched, error",
				"not-sent", Ложь, Неопределено, Ложь,
				"UNSUPPORTED_ACTION: неизвестное действие '" + Действие + "'");
		КонецЕсли;

	Исключение
		Возврат Новый Структура("Disposition, ok, value, matched, error",
			"not-sent", Ложь, Неопределено, Ложь, ОписаниеОшибки());
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область ПоискИРазрешение

Функция РазрешитьФорму(Локатор)

	ЗаписиФорм = СП_СправочникИмен.Формы();
	Имя = Локатор.value;

	Если НЕ ЗаписиФорм.Свойство(Имя) Тогда
		Возврат РезультатРазрешения("none", 0, Неопределено, "LOCATOR_NOT_FOUND: форма '" + Имя + "' не зарегистрирована");
	КонецЕсли;

	Запись = ЗаписиФорм[Имя];
	Если ЗначениеЗаполнено(Локатор.area) И Запись.Область <> Локатор.area Тогда
		Возврат РезультатРазрешения("none", 0, Неопределено,
			"LOCATOR_NOT_FOUND: форма '" + Имя + "' есть, но не в области '" + Локатор.area + "'");
	КонецЕсли;

	Кандидат = УзелФормы(Имя, Запись);
	Кандидаты = Новый Массив;
	Кандидаты.Добавить(Кандидат);
	Возврат РезультатРазрешения("found", 1, Кандидаты, "");

КонецФункции

Функция РазрешитьИмя(Локатор)

	Записи = СП_СправочникИмен.Элементы();
	Имя = Локатор.value;

	Если НЕ Записи.Свойство(Имя) Тогда
		Возврат РезультатРазрешения("none", 0, Неопределено, "LOCATOR_NOT_FOUND: элемент '" + Имя + "' не зарегистрирован");
	КонецЕсли;

	// Различимость по area: одно имя в нескольких областях -> ambiguous без area.
	Кандидаты = Новый Массив;
	Для Каждого КлючЗначение Из Записи Цикл
		Если КлючЗначение.Ключ = Имя Тогда
			Запись = СП_СправочникИмен.Элементы()[Имя];
			Если НЕ ЗначениеЗаполнено(Локатор.area) ИЛИ Запись.Область = Локатор.area Тогда
				Кандидаты.Добавить(УзелИзЗаписи(Имя, Запись, Ложь));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Если Кандидаты.Количество() = 1 Тогда
		Возврат РезультатРазрешения("found", 1, Кандидаты, "");
	ИначеЕсли Кандидаты.Количество() > 1 Тогда
		Возврат РезультатРазрешения("ambiguous", Кандидаты.Количество(), Кандидаты,
			"LOCATOR_AMBIGUOUS: уточните area для '" + Имя + "'");
	Иначе
		Возврат РезультатРазрешения("none", 0, Неопределено,
			"LOCATOR_NOT_FOUND: элемент '" + Имя + "' не найден в области '" + Строка(Локатор.area) + "'");
	КонецЕсли;

КонецФункции

Функция РезультатРазрешения(Исход, Сопоставлено, Кандидаты, Ошибка)

	Если Кандидаты = Неопределено Тогда
		Кандидаты = Новый Массив;
	КонецЕсли;
	Возврат Новый Структура("Исход, Сопоставлено, Кандидаты, Ошибка", Исход, Сопоставлено, Кандидаты, Ошибка);

КонецФункции

Функция УзелФормы(Имя, Запись)

	Supports = Новый Массив;
	Supports.Добавить("waitFor");
	Supports.Добавить("setValue");
	Supports.Добавить("assert");
	Возврат Новый Структура("id, name, path, area, interactive, supports",
		"form:" + Имя, Имя, Запись.Форма, Запись.Область, Ложь, Supports);

КонецФункции

Функция УзелИзЗаписи(Имя, Запись, ВключатьЗначения)

	Supports = Новый Массив;
	Supports.Добавить("waitFor");
	Supports.Добавить("read");
	Supports.Добавить("check");
	Supports.Добавить("assert");
	Если Запись.Интерактивный Тогда
		Supports.Добавить("setValue");
	КонецЕсли;

	Узел = Новый Структура("id, name, kind, path, area, interactive, supports, truncated",
		"name:" + Имя, Имя, "field", Строка(Запись.Реквизит), Строка(Запись.Область),
		Запись.Интерактивный, Supports, Ложь);

	Если ВключатьЗначения Тогда
		Попытка
			Узел.Вставить("value", ПрочитатьПоЗаписи(Запись));
		Исключение
			Узел.Вставить("value", Неопределено);
		КонецПопытки;
	КонецЕсли;

	Возврат Узел;

КонецФункции

#КонецОбласти

#Область ЧтениеИПроверка

// Чтение значения свойства элемента (read).
Функция Прочитать(Локатор, Свойство = "value")

	Результат = РазрешитьЛокатор(Локатор);
	Если Результат.Исход <> "found" Тогда
		ВызватьИсключение Результат.Ошибка;
	КонецЕсли;

	Запись = СП_СправочникИмен.Элементы()[Локатор.value];
	Если Свойство = "value" Тогда
		Возврат ПрочитатьПоЗаписи(Запись);
	ИначеЕсли Свойство = "visible" Тогда
		Возврат ЭлементВидим(Запись);
	ИначеЕсли Свойство = "existence" Тогда
		Возврат Истина;
	ИначеЕсли Свойство = "state" Тогда
		Если ЭлементВидим(Запись) Тогда
			Возврат "visible";
		Иначе
			Возврат "hidden";
		КонецЕсли;
	Иначе
		ВызватьИсключение "UNSUPPORTED_PROPERTY: '" + Свойство + "'";
	КонецЕсли;

КонецФункции

// Чтение значения реквизита по записи реестра имён (переход к открытой форме).
Функция ПрочитатьПоЗаписи(Запись)

	Форма = ПолучитьФормуОбработки(Запись);
	Если Форма = Неопределено Тогда
		ВызватьИсключение "Элемент недоступен (форма не открыта): '" + Запись.Реквизит + "'";
	КонецЕсли;

	ОсновнойРеквизит = ОсновнойРеквизитФормы(Запись.Форма);
	Если Запись.Область = "table" Тогда
		Таблица = Форма[ОсновнойРеквизит];
		Если Таблица.ТекущиеДанные <> Неопределено И Таблица.ТекущиеДанные.Свойство(Запись.Реквизит) Тогда
			Возврат Таблица.ТекущиеДанные[Запись.Реквизит];
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	Иначе
		ОбъектФормы = Форма[ОсновнойРеквизит];
		Если ОбъектФормы <> Неопределено И ОбъектФормы.Свойство(Запись.Реквизит) Тогда
			Возврат ОбъектФормы[Запись.Реквизит];
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;

КонецФункции

// Запись значения в поле формы (programmatic setValue).
Процедура УстановитьЗначение(Локатор, Значение)

	Результат = РазрешитьЛокатор(Локатор);
	Если Результат.Исход <> "found" Тогда
		ВызватьИсключение Результат.Ошибка;
	КонецЕсли;

	Запись = СП_СправочникИмен.Элементы()[Локатор.value];
	Если Не Запись.Интерактивный Тогда
		ВызватьИсключение "Элемент не доступен для изменения: '" + Локатор.value + "'";
	КонецЕсли;

	Форма = ПолучитьФормуОбработки(Запись);
	Если Форма = Неопределено Тогда
		ВызватьИсключение "Элемент недоступен (форма не открыта): '" + Локатор.value + "'";
	КонецЕсли;

	ОсновнойРеквизит = ОсновнойРеквизитФормы(Запись.Форма);
	ОбъектФормы = Форма[ОсновнойРеквизит];
	Если ОбъектФормы <> Неопределено И ОбъектФормы.Свойство(Запись.Реквизит) Тогда
		ОбъектФормы[Запись.Реквизит] = Значение;
	Иначе
		ВызватьИсключение "Реквизит не найден на форме: '" + Запись.Реквизит + "'";
	КонецЕсли;

КонецПроцедуры

Функция ЭлементВидим(Запись)

	Форма = ПолучитьФормуОбработки(Запись);
	Если Форма = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		Элемент = Форма.Элементы.Найти(Запись.Реквизит);
		Если Элемент = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат Элемент.Видимость;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Поллинг ожидания состояния элемента (waitFor) с таймаутом.
Функция ОжидатьСостояние(Локатор, Состояние, ТаймаутМс)

	ДатаСтарт = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Интервал = 500;
	ЧислоПопыток = Макс(1, Цел(ТаймаутМс / Интервал));

	Для Индекс = 1 По ЧислоПопыток Цикл

		Попытка
			Фактическое = Прочитать(Локатор, "state");
		Исключение
			Фактическое = "none";
		КонецПопытки;

		Если Состояние = "exists" Тогда
			Результат = РазрешитьЛокатор(Локатор);
			Совпало = (Результат.Исход = "found");
		ИначеЕсли Состояние = "hidden" Тогда
			Совпало = (Фактическое = "hidden");
		Иначе
			Совпало = (Фактическое = "visible");
		КонецЕсли;

		Если Совпало Тогда
			Возврат Новый Структура("matched, value", Истина, Фактическое);
		КонецЕсли;

		Если Индекс < ЧислоПопыток Тогда
			Приостановить(Интервал);
		КонецЕсли;

	КонецЦикла;

	Возврат Новый Структура("matched, value", Ложь, Фактическое);

КонецФункции

Функция СравнитьЗначения(Фактическое, Ожидаемое)

	Если ЗначениеЗаполнено(Фактическое) И ТипЗнч(Фактическое) = Тип("СправочникСсылка.Контрагенты") Тогда
		Возврат Строка(Фактическое) = Строка(Ожидаемое);
	КонецЕсли;

	Если ТипЗнч(Фактическое) = Тип("Дата") И НЕ Строка(Ожидаемое) = "" Тогда
		Возврат Формат(Фактическое, "ДФ='yyyyMMdd'") = Ожидаемое;
	КонецЕсли;

	Возврат Строка(Фактическое) = Строка(Ожидаемое);

КонецФункции

// check: предикат передаётся как структура { Ожидание (Строка код), Эталон (произв.) }.
Функция ПеремПроверитьПредикат(Предикат, Фактическое)

	Если Предикат = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Ожидание = "равно";
	Если Предикат.Свойство("Ожидание") Тогда
		Ожидание = Предикат.Ожидание;
	КонецЕсли;

	Если Ожидание = "равно" Тогда
		Возврат СравнитьЗначения(Фактическое, Предикат.Эталон);
	ИначеЕсли Ожидание = "заполнено" Тогда
		Возврат ЗначениеЗаполнено(Фактическое);
	ИначеЕсли Ожидание = "неЗаполнено" Тогда
		Возврат НЕ ЗначениеЗаполнено(Фактическое);
	Иначе
		Возврат Ложь;
	КонецЕсли;

КонецФункции

// Получение открытой формы обработки по записи реестра имён (кэш по алиасу).
Функция ПолучитьФормуОбработки(Запись)

	Алиас = Строка(Запись.Форма);
	Если Алиас = "Контрагенты" Тогда
		Возврат СП_УправлениеФормами.НайтиОткрытуюФормуСписок("Контрагенты");
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

Функция ОсновнойРеквизитФормы(АлиасФормы)

	Записи = СП_СправочникИмен.Формы();
	Если Записи.Свойство(АлиасФормы) Тогда
		Возврат Записи[АлиасФормы].ОсновнойРеквизит;
	КонецЕсли;
	Возврат "Список";

КонецФункции

