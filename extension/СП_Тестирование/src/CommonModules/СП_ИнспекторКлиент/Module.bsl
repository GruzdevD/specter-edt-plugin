//
//  Сбор топологии РЕАЛЬНОГО слоя управляемой формы для AI / MCP (ui.inspect).
//  Защищен от переполнения контекста AI:
//   - Строгая фильтрация невидимых элементов (Видимость = Ложь)
//   - Настраиваемое ограничение глубины рекурсии (по умолчанию до 4 уровней)
//   - Лимит максимального числа элементов (по умолчанию 150)
//   - Компактная структура метаданных (Имя, Тип, Вид, Заголовок, Доступность)
//
//  Клиентский модуль: инспектируемая форма живёт только в контексте тонкого клиента.
//©///////////////////////////////////////////////////////////////////////////©//

#Область ПрограммныйИнтерфейс

//@skip-check doc-comment-collection-item-type
// Собрать топологию формы: массив структур элементов для MCP (ui.inspect).
// Параметры:
//   Форма - ФормаКлиентскогоПриложения - открытая управляемая форма
//   ПараметрыИнспекции - Структура - Структура параметров инспекции:
//     * МаксГлубина - Число - (по умолчанию 4)
//     * ВключатьНевидимые - Булево - (по умолчанию Ложь)
//     * ЛимитЭлементов - Число - (по умолчанию 150)
//     * Иерархия - Булево - (по умолчанию Ложь, плоский список с указанием глубины и родителя)
// Возвращаемое значение:
//   Массив - Массив структур элементов управляемой формы
Функция СобратьТопологию(Форма, ПараметрыИнспекции = Неопределено) Экспорт

	Если Форма = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;

	// Параметры по умолчанию
	МаксГлубина = 4;
	ВключатьНевидимые = Ложь;
	ЛимитЭлементов = 150;

	Если ТипЗнч(ПараметрыИнспекции) = Тип("Структура") ИЛИ ТипЗнч(ПараметрыИнспекции) = Тип("Соответствие") Тогда
		Если ПараметрыИнспекции.Свойство("МаксГлубина") И Число(ПараметрыИнспекции.МаксГлубина) > 0 Тогда
			МаксГлубина = Число(ПараметрыИнспекции.МаксГлубина);
		ИначеЕсли ПараметрыИнспекции.Свойство("depth") И Число(ПараметрыИнспекции.depth) > 0 Тогда
			МаксГлубина = Число(ПараметрыИнспекции.depth);
		КонецЕсли;

		Если ПараметрыИнспекции.Свойство("ВключатьНевидимые") Тогда
			ВключатьНевидимые = Булево(ПараметрыИнспекции.ВключатьНевидимые);
		ИначеЕсли ПараметрыИнспекции.Свойство("includeInvisible") Тогда
			ВключатьНевидимые = Булево(ПараметрыИнспекции.includeInvisible);
		КонецЕсли;

		Если ПараметрыИнспекции.Свойство("ЛимитЭлементов") И Число(ПараметрыИнспекции.ЛимитЭлементов) > 0 Тогда
			ЛимитЭлементов = Число(ПараметрыИнспекции.ЛимитЭлементов);
		ИначеЕсли ПараметрыИнспекции.Свойство("limit") И Число(ПараметрыИнспекции.limit) > 0 Тогда
			ЛимитЭлементов = Число(ПараметрыИнспекции.limit);
		КонецЕсли;
	КонецЕсли;

	Результат = Новый Массив;
	ПосещенныеЭлементы = Новый Соответствие;
	СчетчикЭлементов = Новый Структура("Всего", 0);

	// Начинаем рекурсивный обход корневой коллекции элементов формы с глубины 1
	ОбойтиЭлементыРекурсивно(
		Форма.Элементы,
		Результат,
		ПосещенныеЭлементы,
		1,
		МаксГлубина,
		ВключатьНевидимые,
		ЛимитЭлементов,
		СчетчикЭлементов,
		""
	);

	Возврат Результат;

КонецФункции

// Собрать иерархический JSON-дамп дерева формы для AI-агентов (MCP ui.inspect).
// Параметры:
//   Форма - ФормаКлиентскогоПриложения - открытая управляемая форма
//   ПараметрыИнспекции - Структура - Структура параметров инспекции (см. СобратьТопологию)
// Возвращаемое значение:
//   Структура - Структура с полями: заголовок, имяФормы, всегоЭлементов, элементы
Функция СобратьДеревоЭлементов(Форма, ПараметрыИнспекции = Неопределено) Экспорт

	Топология = СобратьТопологию(Форма, ПараметрыИнспекции);

	Дамп = Новый Структура;
	Дамп.Вставить("заголовок", ?(Форма <> Неопределено, Форма.Заголовок, ""));
	Дамп.Вставить("имяФормы", ?(Форма <> Неопределено, Форма.ИмяФормы, ""));
	Дамп.Вставить("всегоЭлементов", Топология.Количество());
	Дамп.Вставить("элементы", Топология);

	//@skip-check constructor-function-return-section
	Возврат Дамп;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Рекурсивный обход элементов формы с фильтрацией по видимости и контролем глубины
//@skip-check method-too-many-params
Процедура ОбойтиЭлементыРекурсивно(Коллекция, Результат, Посещенные, ТекущаяГлубина, МаксГлубина, ВключатьНевидимые, ЛимитЭлементов, Счетчик, ИмяРодителя)

	Если Коллекция = Неопределено ИЛИ ТекущаяГлубина > МаксГлубина ИЛИ Счетчик.Всего >= ЛимитЭлементов Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Элемент Из Коллекция Цикл

		Если Счетчик.Всего >= ЛимитЭлементов Тогда
			Прервать;
		КонецЕсли;

		// Защита от зацикливания
		ИмяЭлемента = "";
		Попытка
			ИмяЭлемента = Элемент.Имя;
		Исключение
			Продолжить;
		КонецПопытки;

		Если Посещенные.Свойство(ИмяЭлемента) Тогда
			Продолжить;
		КонецЕсли;
		Посещенные.Вставить(ИмяЭлемента, Истина);

		// 1. ФИЛЬТРАЦИЯ НЕВИДИМЫХ ЭЛЕМЕНТОВ (Строго для AI MCP)
		Видимость = СвойствоЭлементаБезопасно(Элемент, "Видимость", Истина);
		Если НЕ ВключатьНевидимые И НЕ Видимость Тогда
			// Невидимые элементы и их дочерние ветки пропускаются
			Продолжить;
		КонецЕсли;

		Доступность = СвойствоЭлементаБезопасно(Элемент, "Доступность", Истина);
		Заголовок = СвойствоЭлементаБезопасно(Элемент, "Заголовок", "");
		ПутьКДанным = СвойствоЭлементаБезопасно(Элемент, "ПутьКДанным", "");
		ТипЭлемента = Строка(ТипЗнч(Элемент));
		Вид = Строка(ВидЭлемента(Элемент));

		СтрокаЭлемента = Новый Структура;
		СтрокаЭлемента.Вставить("Имя", ИмяЭлемента);
		СтрокаЭлемента.Вставить("Тип", ТипЭлемента);
		Если ЗначениеЗаполнено(Вид) Тогда
			СтрокаЭлемента.Вставить("Вид", Вид);
		КонецЕсли;
		Если ЗначениеЗаполнено(Заголовок) Тогда
			СтрокаЭлемента.Вставить("Заголовок", Заголовок);
		КонецЕсли;
		Если ЗначениеЗаполнено(ПутьКДанным) Тогда
			СтрокаЭлемента.Вставить("ПутьКДанным", ПутьКДанным);
		КонецЕсли;
		СтрокаЭлемента.Вставить("Видимость", Видимость);
		СтрокаЭлемента.Вставить("Доступность", Доступность);
		СтрокаЭлемента.Вставить("Глубина", ТекущаяГлубина);
		Если ЗначениеЗаполнено(ИмяРодителя) Тогда
			СтрокаЭлемента.Вставить("Родитель", ИмяРодителя);
		КонецЕсли;

		// Для таблиц собираем компактный список видимых колонок
		Если ТипЗнч(Элемент) = Тип("ТаблицаФормы") Тогда
			Колонки = Новый Массив;
			//@skip-check empty-except-statement
			Попытка
				Для Каждого Колонка Из Элемент.ПодчиненныеЭлементы Цикл
					Если ВключатьНевидимые ИЛИ СвойствоЭлементаБезопасно(Колонка, "Видимость", Истина) Тогда
						Колонки.Добавить(Колонка.Имя);
					КонецЕсли;
				КонецЦикла;
			Исключение
			КонецПопытки;
			Если Колонки.Количество() > 0 Тогда
				СтрокаЭлемента.Вставить("Колонки", СтрСоединить(Колонки, ", "));
			КонецЕсли;
		КонецЕсли;

		Результат.Добавить(СтрокаЭлемента);
		Счетчик.Всего = Счетчик.Всего + 1;

		// 2. Рекурсивный спуск в дочерние группы / панели / страницы / таблицы
		Если ТекущаяГлубина < МаксГлубина Тогда
			Подчиненные = Неопределено;
			//@skip-check empty-except-statement
			Попытка
				Если Элемент.Свойство("ПодчиненныеЭлементы") Тогда
					Подчиненные = Элемент.ПодчиненныеЭлементы;
				КонецЕсли;
			Исключение
			КонецПопытки;

			Если Подчиненные <> Неопределено И Подчиненные.Количество() > 0 Тогда
				ОбойтиЭлементыРекурсивно(
					Подчиненные,
					Результат,
					Посещенные,
					ТекущаяГлубина + 1,
					МаксГлубина,
					ВключатьНевидимые,
					ЛимитЭлементов,
					Счетчик,
					ИмяЭлемента
				);
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Видовой объект элемента формы (имя вида в управляемой форме), безопасно.
Функция ВидЭлемента(Элемент)

	Попытка
		Возврат Элемент.Вид;
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

// Свойство элемента формы через безопасное чтение (не у всех видов есть все поля).
Функция СвойствоЭлементаБезопасно(Элемент, ИмяСвойства, ПоУмолчанию)

	Если Элемент = Неопределено Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Попытка
		Возврат Элемент[ИмяСвойства];
	Исключение
		Возврат ПоУмолчанию;
	КонецПопытки;

КонецФункции

#КонецОбласти
