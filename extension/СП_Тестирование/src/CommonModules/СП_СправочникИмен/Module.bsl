//
//  Реестр стабильных имён (kind='name'/'form') для семантического автопоиска.
//  Единый источник «стабильное имя → реквизит/элемент/форма» afm. Заполнен
//  РЕАЛЬНЫМИ именами afm, подтверждёнными read-only разведкой edt-afm.
//©///////////////////////////////////////////////////////////////////////////©//

#Область ПрограммныйИнтерфейс

// Возвращает реестр доступных «форм-алиасов»: стабильное имя формы -> запись-структуру.
Функция Формы() Экспорт

	Формы = Новый Соответствие;

	Формы.Вставить("Контрагенты", Новый Структура(
		"Форма, Область, ОсновнойРеквизит",
		"Справочник.Контрагенты.ФормаСписка", "list", "Список"));

	Формы.Вставить("ФормаЭлементаКонтрагенты", Новый Структура(
		"Форма, Область, ОсновнойРеквизит",
		"Справочник.Контрагенты.ФормаЭлемента", "form", "Объект"));

	Возврат Формы;

КонецФункции

// Возвращает реестр стабильных имён элементов (kind='name').
Функция Элементы() Экспорт

	Элементы = Новый Соответствие;

	Элементы.Вставить("Наименование", Новый Структура(
		"МетаОбъект, Реквизит, Форма, Область, Интерактивный",
		"Catalog.Контрагенты", "Description", "Контрагенты", "table", Истина));

	Элементы.Вставить("Код", Новый Структура(
		"МетаОбъект, Реквизит, Форма, Область, Интерактивный",
		"Catalog.Контрагенты", "Code", "Контрагенты", "table", Истина));

	Элементы.Вставить("ИНН", Новый Структура(
		"МетаОбъект, Реквизит, Форма, Область, Интерактивный",
		"Catalog.Контрагенты", "ИНН", "ФормаЭлементаКонтрагенты", "form", Истина));

	Элементы.Вставить("НаименованиеСокращенное", Новый Структура(
		"МетаОбъект, Реквизит, Форма, Область, Интерактивный",
		"Catalog.Контрагенты", "НаименованиеСокращенное", "ФормаЭлементаКонтрагенты", "form", Истина));

	Элементы.Вставить("НаименованиеПолное", Новый Структура(
		"МетаОбъект, Реквизит, Форма, Область, Интерактивный",
		"Catalog.Контрагенты", "НаименованиеПолное", "ФормаЭлементаКонтрагенты", "form", Истина));

	Элементы.Вставить("КПП", Новый Структура(
		"МетаОбъект, Реквизит, Форма, Область, Интерактивный",
		"Catalog.Контрагенты", "КПП", "ФормаЭлементаКонтрагенты", "form", Истина));

	Возврат Элементы;

КонецФункции

// Сопоставление стандартного реквизита -> стабильное имя (для read/assert по value).
Функция СинонимыСтандартныхРеквизитов() Экспорт

	Синонимы = Новый Соответствие;
	Синонимы.Вставить("Description", "Наименование");
	Синонимы.Вставить("Code", "Код");
	Возврат Синонимы;

КонецФункции

// Поиск записи элемента по стабильному имени с учётом area.
Функция НайтиЭлемент(Имя, Область = "") Экспорт

	Реестр = Элементы();
	Если НЕ Реестр.Свойство(Имя) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запись = Реестр[Имя];
	Если ЗначениеЗаполнено(Область) И Запись.Область <> Область Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Запись;

КонецФункции

// Все стабильные имена элемента (для инспекции/автопоиска).
Функция ВсеИменаЭлементов() Экспорт

	Имена = Новый Массив;
	Для Каждого КлючЗначение Из Элементы() Цикл
		Имена.Добавить(КлючЗначение.Ключ);
	КонецЦикла;
	Возврат Имена;

КонецФункции

#КонецОбласти
