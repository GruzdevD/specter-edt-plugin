КонецПроцедуры

// =========================================================================
// НАВИГАЦИЯ ПО КОМАНДНОМУ ИНТЕРФЕЙСУ, ГИПЕРССЫЛКИ, ОКНА (Vanessa UI-pattern)
// =========================================================================

// Универсальное чтение значения колонки: и табличная часть объекта формы,
// и динамический список (по текущей записи). Анти-маскировка: {ok,message}.
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, содержащая таблицу
//  ИмяТаблицы - Строка - имя табличной части или динамического списка
//  НомерСтроки - Число - индекс строки (для ТЧ); для списка игнорируется
//  ИмяКолонки - Строка - имя колонки / реквизита
// Возвращаемое значение:
//  Структура - результат операции: {ok, message, Значение}
Функция ЗначениеТаблицы(Форма, ИмяТаблицы, НомерСтроки, ИмяКолонки) Экспорт

	Результат = Новый Структура("ok, message, Значение", Ложь, "", Неопределено);
	Если Форма = Неопределено Тогда
		Результат.message = "Форма не определена";
		//@skip-check constructor-function-return-section
		Возврат Результат;
	КонецЕсли;

	// 1. Табличная часть объекта формы
	//@skip-check empty-except-statement
	Попытка
		Таблица = Форма.Объект[ИмяТаблицы];
		Если НомерСтроки >= 0 И НомерСтроки < Таблица.Количество()
			И Таблица[НомерСтроки].Свойство(ИмяКолонки) Тогда
			Результат.ok = Истина;
			Результат.Значение = Таблица[НомерСтроки][ИмяКолонки];
			Результат.message = "Прочитана колонка '" + ИмяКолонки + "' таблицы '" + ИмяТаблицы + "'";
			//@skip-check constructor-function-return-section
			Возврат Результат;
		КонецЕсли;
	Исключение
	КонецПопытки;

	// 2. Динамический список формы (текущая запись)
	//@skip-check empty-except-statement
	Попытка
		Если Форма.Свойство(ИмяТаблицы) И ТипЗнч(Форма[ИмяТаблицы]) = Тип("ДинамическийСписок")
			И Форма[ИмяТаблицы].ТекущиеДанные <> Неопределено
			И Форма[ИмяТаблицы].ТекущиеДанные.Свойство(ИмяКолонки) Тогда
			Результат.ok = Истина;
			Результат.Значение = Форма[ИмяТаблицы].ТекущиеДанные[ИмяКолонки];
			Результат.message = "Прочитан реквизит '" + ИмяКолонки + "' текущей записи списка '" + ИмяТаблицы + "'";
			//@skip-check constructor-function-return-section
			Возврат Результат;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Результат.message = "Таблица '" + ИмяТаблицы + "' не найдена (ни ТЧ, ни динамический список формы)";
	//@skip-check constructor-function-return-section
	Возврат Результат;

КонецФункции

// Активизировать (поставить курсор в) поле колонки таблицы.
// Ищет элемент формы по именам "<Таблица>.<Колонка>", "<Таблица>_<Колонка>", "<Колонка>".
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, содержащая таблицу
//  ИмяТаблицы - Строка - имя элемента таблицы
//  ИмяКолонки - Строка - имя колонки
// Возвращаемое значение:
//  Структура - результат операции: {ok, message}
Функция АктивизироватьПолеВТаблице(Форма, ИмяТаблицы, ИмяКолонки) Экспорт

	Результат = Новый Структура("ok, message", Ложь, "");
	Если Форма = Неопределено Тогда
		Результат.message = "Форма не определена";
		//@skip-check constructor-function-return-section
		Возврат Результат;
	КонецЕсли;

	Попытка
		Элемент = Неопределено;
		//@skip-check empty-except-statement
		Попытка
			Элемент = Форма.Элементы.Найти(ИмяТаблицы + "." + ИмяКолонки);
		Исключение
		КонецПопытки;
		Если Элемент = Неопределено Тогда
			//@skip-check empty-except-statement
			Попытка
				Элемент = Форма.Элементы.Найти(ИмяТаблицы + "_" + ИмяКолонки);
			Исключение
			КонецПопытки;
		КонецЕсли;
		Если Элемент = Неопределено Тогда
			//@skip-check empty-except-statement
			Попытка
				Элемент = Форма.Элементы.Найти(ИмяКолонки);
			Исключение
			КонецПопытки;
		КонецЕсли;

		Если Элемент <> Неопределено Тогда
			Форма.ТекущийЭлемент = Элемент;
			Результат.ok = Истина;
			Результат.message = "Активизировано поле '" + ИмяКолонки + "' таблицы '" + ИмяТаблицы + "'";
			//@skip-check constructor-function-return-section
			Возврат Результат;
		КонецЕсли;
	Исключение
		Результат.message = ОписаниеОшибки();
	КонецПопытки;

	// Фолбэк: активизация строки таблицы (курсор в таблицу)
	Возврат АктивизироватьСтрокуТаблицы(Форма, ИмяТаблицы, 0);

КонецФункции

// Завершить редактирование строки/ячейки таблицы (перевод фокуса на саму таблицу).
// Параметры:
