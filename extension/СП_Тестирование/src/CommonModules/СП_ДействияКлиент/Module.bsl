// Выполнить команду командного интерфейса формы по имени или заголовку.
Функция ВыбратьКомандуИнтерфейса(Форма, ИмяИлиЗаголовок) Экспорт

	Результат = Новый Структура("ok, message", Ложь, "");
	Если Форма = Неопределено Тогда
		Результат.message = "Форма не определена";
		//@skip-check constructor-function-return-section
		Возврат Результат;
	КонецЕсли;

	Команда = Неопределено;
	// По имени команды
	Попытка
		Образец = Форма.Команды[ИмяИлиЗаголовок];
		Если Образец <> Неопределено Тогда
			Команда = Образец;
		КонецЕсли;
	Исключение
	КонецПопытки;
	// По заголовку / имени элемента
	Если Команда = Неопределено Тогда
		Попытка
			Для Каждого Канд Из Форма.Команды Цикл
				Если СокрЛП(Канд.Заголовок) = СокрЛП(ИмяИлиЗаголовок)
					ИЛИ СокрЛП(Канд.Имя) = СокрЛП(ИмяИлиЗаголовок) Тогда
					Команда = Канд;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		Исключение
		КонецПопытки;
	КонецЕсли;

	Если Команда = Неопределено Тогда
		Результат.message = "Команда интерфейса '" + ИмяИлиЗаголовок + "' не найдена";
		//@skip-check constructor-function-return-section
		Возврат Результат;
	КонецЕсли;

	Попытка
		Форма.ВыполнитьКоманду(Команда);
		Результат.ok = Истина;
		Результат.message = "Выполнена команда интерфейса '" + ИмяИлиЗаголовок + "'";
	Исключение
		Результат.message = "Ошибка выполнения команды '" + ИмяИлиЗаголовок + "': " + ОписаниеОшибки();
	КонецПопытки;
	//@skip-check constructor-function-return-section
	Возврат Результат;

КонецФункции

// Прочитать значение ячейки табличного документа, привязанного к форме.
// Источник - реквизит формы типа ТабличныйДокумент (форма привязана к тем же данным);
// иначе - текущая выделенная область поля табличного документа.
Функция ПолучитьЗначениеЯчейкиТабличногоДокумента(Форма, ИмяПоляДок, НомерСтроки, НомерКолонки) Экспорт

	Результат = Новый Структура("ok, message", Ложь, "");
	Результат.Вставить("Значение", Неопределено);
	Если Форма = Неопределено Тогда
		Результат.message = "Форма не определена";
		//@skip-check constructor-function-return-section
		Возврат Результат;
	КонецЕсли;

	Попытка
		ЗначениеДокумента = Неопределено;
		Если ОбъектФормыСодержит(Форма, ИмяПоляДок) Тогда
			ЗначениеДокумента = Форма.Объект[ИмяПоляДок];
		КонецЕсли;
		Если ЗначениеДокумента <> Неопределено И ТипЗнч(ЗначениеДокумента) = Тип("ТабличныйДокумент") Тогда
			Результат.Значение = ЗначениеДокумента.Область(НомерСтроки, НомерКолонки).Текст;
			Результат.ok = Истина;
			Результат.message = "Прочитана ячейка (" + Строка(НомерСтроки) + "," + Строка(НомерКолонки)
				+ ") табличного документа '" + ИмяПоляДок + "'";
		Иначе
			Элемент = Форма.Элементы.Найти(ИмяПоляДок);
			Если Элемент <> Неопределено И Элемент.Свойство("ТекущаяОбласть") Тогда
				Область = Элемент.ТекущаяОбласть;
				Если Область <> Неопределено Тогда
					Результат.Значение = Область.Текст;
					Результат.ok = Истина;
					Результат.message = "Прочитана текущая область табличного документа '" + ИмяПоляДок + "'";
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если НЕ Результат.ok Тогда
			Результат.message = "Не удалось прочитать ячейку: поле '" + ИмяПоляДок
				+ "' не связано с табличным документом";
		КонецЕсли;
	Исключение
		Результат.message = "Ошибка чтения ячейки табличного документа: " + ОписаниеОшибки();
	КонецПопытки;
	//@skip-check constructor-function-return-section
	Возврат Результат;

КонецФункции

