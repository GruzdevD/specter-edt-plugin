КонецФункции

// Выделить все строки таблицы формы (в т.ч. динамического списка).
// Vanessa: «в таблице '<X>' я выделяю все строки».
//
// Параметры:
//  Форма       - ФормаКлиентскогоПриложения - управляемая форма с таблицей.
//  ИмяТаблицы  - Строка - имя элемента таблицы формы.
//
// Возвращаемое значение:
//  Структура("ok, message") - ok=Истина, если строки выделены.
Функция ВыделитьВсеСтроки(Форма, ИмяТаблицы) Экспорт

	Результат = Новый Структура("ok, message", Ложь, "");
	Попытка
		Элемент = Форма.Элементы.Найти(ИмяТаблицы);
		Если Элемент = Неопределено ИЛИ НЕ Элемент.Свойство("ВыделенныеСтроки") Тогда
			Результат.message = "Таблица '" + ИмяТаблицы + "' не найдена или не поддерживает выделение строк";
			//@skip-check constructor-function-return-section
			Возврат Результат;
		КонецЕсли;

		Элемент.ВыделенныеСтроки.Очистить();
		ВыделеноСтрок = 0;

		// Табличная часть / коллекция реквизита формы.
		Данные = Неопределено;
		Попытка
			Если ОбъектФормыСодержит(Форма, ИмяТаблицы) Тогда
				Данные = Форма.Объект[ИмяТаблицы];
			КонецЕсли;
		Исключение
		КонецПопытки;
		Если Данные <> Неопределено И ТипЗнч(Данные) = Тип("ДанныеФормыКоллекция") Тогда
			Для Каждого ТекСтрока Из Данные Цикл
				Элемент.ВыделенныеСтроки.Добавить(ТекСтрока);
				ВыделеноСтрок = ВыделеноСтрок + 1;
			КонецЦикла;
		Иначе
			// Динамический список: строки берём из коллекции списка, связанного с полем.
			Попытка
				Если Элемент.Свойство("Список") Тогда
					Коллекция = Элемент.Список.ПолучитьЭлементы();
					Для Каждого ТекСтрока Из Коллекция Цикл
						Элемент.ВыделенныеСтроки.Добавить(ТекСтрока);
						ВыделеноСтрок = ВыделеноСтрок + 1;
					КонецЦикла;
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЕсли;

		Результат.ok = Истина;
		Результат.message = "Выделено строк " + Строка(ВыделеноСтрок) + " в таблице '" + ИмяТаблицы + "'";
	Исключение
		Результат.message = "Не удалось выделить строки таблицы '" + ИмяТаблицы + "': " + ОписаниеОшибки();
	КонецПопытки;
	//@skip-check constructor-function-return-section
	Возврат Результат;

КонецФункции

// Количество строк табличной части / данных, связанной с полем таблицы.
Функция КоличествоСтрокТаблицы(Форма, ИмяТаблицы, Элемент)

	Попытка
		Если ОбъектФормыСодержит(Форма, ИмяТаблицы) Тогда
			Данные = Форма.Объект[ИмяТаблицы];
			Если Данные <> Неопределено И ТипЗнч(Данные) = Тип("ДанныеФормыКоллекция") Тогда
				Возврат Данные.Количество();
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;
	// Динамический список: строки не в реквизите - берём из списка, связанного с полем.
	Попытка
		Если Элемент.Свойство("Список") Тогда
			Коллекция = Элемент.Список.ПолучитьЭлементы();
			Возврат Коллекция.Количество();
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат 0;

КонецФункции

// Установить фильтр (отбор) динамического списка формы.
Функция УстановитьФильтрСписка(Форма, ИмяСписка, ИмяПоляОтбора, Значение) Экспорт

	Результат = Новый Структура("ok, message", Ложь, "");
	Попытка
		Элемент = Форма.Элементы.Найти(ИмяСписка);
		Если Элемент = Неопределено ИЛИ НЕ Элемент.Свойство("Отбор") Тогда
			Результат.message = "Список '" + ИмяСписка + "' не найден или не поддерживает отбор";
			//@skip-check constructor-function-return-section
			Возврат Результат;
		КонецЕсли;
		Элемент.Отбор[ИмяПоляОтбора].Значение = Значение;
		Форма.ОбновитьОтображениеДанных();
		Результат.ok = Истина;
		Результат.message = "Установлен фильтр '" + ИмяПоляОтбора + "=" + Строка(Значение) + "' списка '" + ИмяСписка + "'";
	Исключение
		Результат.message = "Не удалось установить фильтр списка '" + ИмяСписка + "': " + ОписаниеОшибки();
	КонецПопытки;
	//@skip-check constructor-function-return-section
	Возврат Результат;

КонецФункции

// Очистить отбор (фильтр) динамического списка формы.
Функция ОчиститьФильтрСписка(Форма, ИмяСписка) Экспорт

	Результат = Новый Структура("ok, message", Ложь, "");
	Попытка
		Элемент = Форма.Элементы.Найти(ИмяСписка);
		Если Элемент = Неопределено ИЛИ НЕ Элемент.Свойство("Отбор") Тогда
			Результат.message = "Список '" + ИмяСписка + "' не найден или не поддерживает отбор";
			//@skip-check constructor-function-return-section
			Возврат Результат;
		КонецЕсли;
		ОчиститьОтборЭлемента(Элемент.Отбор);
		Форма.ОбновитьОтображениеДанных();
		Результат.ok = Истина;
		Результат.message = "Фильтр списка '" + ИмяСписка + "' очищен";
	Исключение
		Результат.message = "Не удалось очистить фильтр списка '" + ИмяСписка + "': " + ОписаниеОшибки();
	КонецПопытки;
	//@skip-check constructor-function-return-section
	Возврат Результат;

КонецФункции

// Очистить коллекцию отбора компоновки данных (с разных вариантов очистки).
Процедура ОчиститьОтборЭлемента(Отбор)

	Попытка
		Отбор.Элементы.Очистить();
		Возврат;
	Исключение
	КонецПопытки;
	Если Отбор.Свойство("Элементы") Тогда
		Для Каждого ЭлементОтбора Из Отбор.Элементы Цикл
			Попытка
				ЭлементОтбора.Использование = Ложь;
			Исключение
			КонецПопытки;
			Попытка
				ЭлементОтбора.Значение = Неопределено;
			Исключение
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

// Выбрать пункт контекстного меню: контекстное меню программно не открывается,
// поэтому одноимённая команда формы выполняется напрямую (командный интерфейс).
Функция ВыбратьПунктКонтекстногоМеню(Форма, НаименованиеКоманды) Экспорт
	//@skip-check constructor-function-return-section
	Возврат ВыбратьКомандуИнтерфейса(Форма, НаименованиеКоманды);
КонецФункции

// Нажать сочетание клавиш.
// Платформа 1С не позволяет эмулировать глобальные сочетания клавиш программно.
// Если сочетание соответствует команде формы - выполняем её; иначе честный ok=Ложь.
Функция НажатьСочетаниеКлавиш(Форма, СочетаниеКлавиш) Экспорт

	Результат = Новый Структура("ok, message", Ложь, "");
	Если СочетаниеКлавиш = Неопределено ИЛИ ПустаяСтрока(СокрЛП(СочетаниеКлавиш)) Тогда
		Результат.message = "Не передано сочетание клавиш";
		//@skip-check constructor-function-return-section
		Возврат Результат;
	КонецЕсли;

	Попытка
		Команда = Неопределено;
		Попытка
			Образец = Форма.Команды[СочетаниеКлавиш];
			Если Образец <> Неопределено Тогда
				Команда = Образец;
			КонецЕсли;
		Исключение
		КонецПопытки;
		Если Команда = Неопределено Тогда
			Для Каждого Канд Из Форма.Команды Цикл
				Если СокрЛП(Канд.Заголовок) = СокрЛП(СочетаниеКлавиш)
					ИЛИ СокрЛП(Канд.Имя) = СокрЛП(СочетаниеКлавиш) Тогда
					Команда = Канд;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если Команда <> Неопределено Тогда
			Форма.ВыполнитьКоманду(Команда);
			Результат.ok = Истина;
			Результат.message = "Выполнена команда за сочетание клавиш '" + СочетаниеКлавиш + "'";
		Иначе
			Результат.message = "Эмуляция сочетания клавиш '" + СочетаниеКлавиш
				+ "' не поддерживается платформой; задайте шаг через команду формы";
		КонецЕсли;
	Исключение
		Результат.message = "Ошибка выполнения сочетания клавиш: " + ОписаниеОшибки();
	КонецПопытки;
	//@skip-check constructor-function-return-section
	Возврат Результат;

КонецФункции

#КонецОбласти
