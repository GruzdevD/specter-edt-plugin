// Развернуть или свернуть группу формы (Vanessa «я разворачиваю группу с именем …»).
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, содержащая группу
//  ИмяГруппы - Строка - имя элемента-группы на форме
//  Развернуть - Булево - Истина = развернуть группу, Ложь = свернуть
// Возвращаемое значение:
//  Структура - результат операции: {ok, message}
Функция РазвернутьГруппу(Форма, ИмяГруппы, Развернуть = Истина) Экспорт

	Результат = Новый Структура("ok, message", Ложь, "");

	Если Форма = Неопределено Тогда
		Результат.message = "Форма не определена";
		//@skip-check constructor-function-return-section
		Возврат Результат;
	КонецЕсли;

	Попытка
		Группа = Форма.Элементы.Найти(ИмяГруппы);
		Если Группа = Неопределено Тогда
			Результат.message = "Группа '" + ИмяГруппы + "' не найдена на форме";
			//@skip-check constructor-function-return-section
			Возврат Результат;
		КонецЕсли;

		Если Группа.Свойство("Разворачивание") Тогда
			//@skip-check bsl-legacy-check-dynamic-feature-access
			//@skip-check undefined-variable
			Группа.Разворачивание = ?(Развернуть, РазворачиваниеФормы.Развернутая, РазворачиваниеФормы.Свернутая);
			Результат.ok = Истина;
			Результат.message = "Группа '" + ИмяГруппы + "' " + ?(Развернуть, "развёрнута", "свёрнута");
		Иначе
			Результат.message = "Элемент '" + ИмяГруппы + "' не является разворачиваемой группой";
		КонецЕсли;
	Исключение
		Результат.message = ОписаниеОшибки();
	КонецПопытки;
	//@skip-check constructor-function-return-section
	Возврат Результат;

КонецФункции

// Проверить наличие элемента на форме (Vanessa «элемент … присутствует / отсутствует на форме»).
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, на которой ищется элемент
//  ИмяЭлемента - Строка - имя элемента формы
// Возвращаемое значение:
//  Структура - результат операции: {ok, message, Присутствует}; Присутствует = Истина, если элемент найден
Функция ЭлементНаФорме(Форма, ИмяЭлемента) Экспорт

	Результат = Новый Структура("ok, message, Присутствует", Ложь, "", Ложь);

	Если Форма = Неопределено Тогда
		Результат.message = "Форма не определена";
		//@skip-check constructor-function-return-section
		Возврат Результат;
	КонецЕсли;

	Попытка
		Элемент = Форма.Элементы.Найти(ИмяЭлемента);
		Результат.ok = Истина;
		Результат.Присутствует = (Элемент <> Неопределено);
		Результат.message = "Элемент '" + ИмяЭлемента + "' " + ?(Результат.Присутствует, "присутствует на форме", "отсутствует на форме");
	Исключение
		Результат.message = ОписаниеОшибки();
	КонецПопытки;
	//@skip-check constructor-function-return-section
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Поиск открытой формы клиентского приложения по заголовку окна.
Функция НайтиФормуПоЗаголовку(Заголовок)

	//@skip-check undefined-function
	Попытка
		Формы = ПолучитьФормы();
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Для Каждого ФормаОкна Из Формы Цикл
		//@skip-check empty-except-statement
		Попытка
			Если СокрЛП(ФормаОкна.Заголовок) = СокрЛП(Заголовок) Тогда
				Возврат ФормаОкна;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция НайтиКнопкуПоЗаголовкуРекурсивно(КоллекцияЭлементов, ЗаголовокИскомый)

	Для Каждого Элемент Из КоллекцияЭлементов Цикл
		Если ТипЗнч(Элемент) = Тип("КнопкаФормы") Тогда
			Если ВРег(СокрЛП(Элемент.Заголовок)) = ВРег(СокрЛП(ЗаголовокИскомый))
				ИЛИ ВРег(СокрЛП(Элемент.Имя)) = ВРег(СокрЛП(ЗаголовокИскомый)) Тогда
				Возврат Элемент;
			КонецЕсли;
		ИначеЕсли ТипЗнч(Элемент) = Тип("ГруппаФормы") И Элемент.Свойство("ПодчиненныеЭлементы") Тогда
			НайденнаяКнопка = НайтиКнопкуПоЗаголовкуРекурсивно(Элемент.ПодчиненныеЭлементы, ЗаголовокИскомый);
			Если НайденнаяКнопка <> Неопределено Тогда
				Возврат НайденнаяКнопка;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция НайтиСтраницуРекурсивно(КоллекцияЭлементов, ИмяИлиЗаголовок)

	Для Каждого Элемент Из КоллекцияЭлементов Цикл
		Если ТипЗнч(Элемент) = Тип("ГруппаФормы") Тогда
			Если ВРег(СокрЛП(Элемент.Заголовок)) = ВРег(СокрЛП(ИмяИлиЗаголовок))
				ИЛИ ВРег(СокрЛП(Элемент.Имя)) = ВРег(СокрЛП(ИмяИлиЗаголовок)) Тогда
				Возврат Элемент;
			КонецЕсли;
			Если Элемент.Свойство("ПодчиненныеЭлементы") Тогда
				Найденная = НайтиСтраницуРекурсивно(Элемент.ПодчиненныеЭлементы, ИмяИлиЗаголовок);
				Если Найденная <> Неопределено Тогда
					Возврат Найденная;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// =========================================================================
// ДОПОЛНИТЕЛЬНЫЕ КЛИЕНТСКИЕ ПРИМИТИВЫ (Vanessa UI-pattern, R3)
// Реализованы на штатных механизмах управляемого клиента: ОткрытьСписокВыбора,
// ТекущаяСтрока/ТекущиеДанные таблицы, Отбор динамического списка, ВыполнитьКоманду.
// Где платформа не эмулирует действие (глобальные сочетания клавиш) - честный
// ok=Ложь с пояснением вместо поддельного успеха (анти-маскировка).
// =========================================================================

// Нажать кнопку выбора поля (открыть раскрывающийся список выбора).
// Использует штатный метод ПолеФормы.ОткрытьСписокВыбора() на реальном UI.
Функция НажатьКнопкуВыбора(Форма, ИмяПоля) Экспорт

	Результат = Новый Структура("ok, message", Ложь, "");
	Если Форма = Неопределено Тогда
		Результат.message = "Форма не определена";
		//@skip-check constructor-function-return-section
		Возврат Результат;
	КонецЕсли;

	МаксПопыток = 3;
	ПоследняяОшибка = "";
	Для ПопыткаНомер = 1 По МаксПопыток Цикл
		Попытка
			Элемент = Форма.Элементы.Найти(ИмяПоля);
			Если Элемент <> Неопределено Тогда
				Форма.ТекущийЭлемент = Элемент;
				Элемент.ОткрытьСписокВыбора();
				Результат.ok = Истина;
				Результат.message = "Открыт список выбора поля '" + ИмяПоля + "'";
				//@skip-check constructor-function-return-section
				Возврат Результат;
			КонецЕсли;
		Исключение
			ПоследняяОшибка = ОписаниеОшибки();
		КонецПопытки;
		Если ПопыткаНомер < МаксПопыток Тогда
			СП_ОжиданияКлиент.Пауза(0.1);
		КонецЕсли;
	КонецЦикла;

	Результат.message = "Не удалось открыть список выбора поля '" + ИмяПоля + "'"
		+ ?(ПустаяСтрока(ПоследняяОшибка), "", ": " + ПоследняяОшибка);
	//@skip-check constructor-function-return-section
	Возврат Результат;

КонецФункции

// Нажать кнопку выбора ячейки таблицы (открыть список выбора значения ячейки).
// Активизирует ячейку (АктивизироватьПолеВТаблице) и раскрывает её список выбора.
Функция НажатьКнопкуВыбораЯчейки(Форма, ИмяТаблицы, НомерСтроки, ИмяКолонки) Экспорт

	Результат = Новый Структура("ok, message", Ложь, "");
	АктивизацияСтроки = АктивизироватьСтрокуТаблицы(Форма, ИмяТаблицы, НомерСтроки);
	Если НЕ АктивизацияСтроки.ok Тогда
		Результат.message = АктивизацияСтроки.message;
		//@skip-check constructor-function-return-section
		Возврат Результат;
	КонецЕсли;
	Активизация = АктивизироватьПолеВТаблице(Форма, ИмяТаблицы, ИмяКолонки);
	Если НЕ Активизация.ok Тогда
		Результат.message = Активизация.message;
		//@skip-check constructor-function-return-section
		Возврат Результат;
	КонецЕсли;
	Попытка
		Элемент = Форма.ТекущийЭлемент;
		Если Элемент <> Неопределено И ТипЗнч(Элемент) = Тип("ПолеФормы") Тогда
			Элемент.ОткрытьСписокВыбора();
			Результат.ok = Истина;
			Результат.message = "Открыт список выбора ячейки '" + ИмяКолонки + "' строки "
				+ Строка(НомерСтроки) + " таблицы '" + ИмяТаблицы + "'";
		Иначе
			Результат.message = "Не удалось определить поле ячейки '" + ИмяКолонки + "' для открытия списка выбора";
		КонецЕсли;
	Исключение
		Результат.message = "Не удалось открыть список выбора ячейки: " + ОписаниеОшибки();
	КонецПопытки;
	//@skip-check constructor-function-return-section
	Возврат Результат;

КонецФункции

// Собрать плоскую цепочку доступных для навигации полей формы (по порядку элементов).
Процедура СобратьНавигационнуюЦепочку(КоллекцияЭлементов, Цепочка)

	Для Каждого Элемент Из КоллекцияЭлементов Цикл
		Если ТипЗнч(Элемент) = Тип("ПолеФормы") Тогда
			Если Элемент.Свойство("Доступность") И Элемент.Доступность
				И Элемент.Свойство("Видимость") И Элемент.Видимость Тогда
				Цепочка.Добавить(Элемент);
			КонецЕсли;
		ИначеЕсли ТипЗнч(Элемент) = Тип("ГруппаФормы") Тогда
			Если Элемент.Свойство("ПодчиненныеЭлементы") Тогда
				СобратьНавигационнуюЦепочку(Элемент.ПодчиненныеЭлементы, Цепочка);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Внутренняя реализация перехода к следующему/предыдущему реквизиту формы.
Функция ПерейтиКРеквизиту(Форма, Вперед)

	Результат = Новый Структура("ok, message", Ложь, "");
	Если Форма = Неопределено Тогда
		Результат.message = "Форма не определена";
		//@skip-check constructor-function-return-section
		Возврат Результат;
	КонецЕсли;

	Цепочка = Новый Массив;
	СобратьНавигационнуюЦепочку(Форма.Элементы, Цепочка);
	Если Цепочка.Количество() = 0 Тогда
		Результат.message = "На форме нет доступных полей для навигации";
		//@skip-check constructor-function-return-section
		Возврат Результат;
	КонецЕсли;

	ТекущийИндекс = -1;
	Если Форма.ТекущийЭлемент <> Неопределено Тогда
		Для Инд = 0 По Цепочка.ВГраница() Цикл
			Если Цепочка[Инд] = Форма.ТекущийЭлемент Тогда
				ТекущийИндекс = Инд;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	НовыйИндекс = ?(Вперед, ТекущийИндекс + 1, ТекущийИндекс - 1);
	Если НовыйИндекс < 0 Тогда
		НовыйИндекс = Цепочка.ВГраница();
	ИначеЕсли НовыйИндекс > Цепочка.ВГраница() Тогда
		НовыйИндекс = 0;
	КонецЕсли;

	Попытка
		Форма.ТекущийЭлемент = Цепочка[НовыйИндекс];
		Результат.ok = Истина;
		Результат.message = "Переход " + ?(Вперед, "к следующему", "к предыдущему")
			+ " реквизиту '" + Цепочка[НовыйИндекс].Имя + "'";
	Исключение
		Результат.message = "Не удалось перейти к реквизиту: " + ОписаниеОшибки();
	КонецПопытки;
	//@skip-check constructor-function-return-section
	Возврат Результат;

КонецФункции

