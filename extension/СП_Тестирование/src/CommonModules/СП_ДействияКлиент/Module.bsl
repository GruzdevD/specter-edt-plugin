//©///////////////////////////////////////////////////////////////////////////©//
//  СП_ДействияКлиент - расширение afm, клиентские действия над табличными частями форм
//  (Vanessa-паттерн таблиц, R3, УИ_Действия).
//
//  Перенос механики таблиц Vanessa: поиск строки по набору колонок и редактирование
//  ячейки. Работаем с табличной частью ОБЪЕКТА формы (Форма.Объект.<ИмяТЧ>) - это
//  программный контур данных, НО он интегрирован с UI: таблица формы привязана к тем же
//  данным, и после изменения форма отражает их. Для честного UI-контура (клик по строке,
//  активизация поля) поверх этих действий вызываются экспортные методы формы/агента.
//
//  Возвращают честные структуры { ok, message }: не бросают исключение на "не найдено",
//  а дают вызывающему решить судьбу шага (assert/abort) - анти-маскировка.
//
//  Директива: Клиент - данные объекта формы и табличные части доступны на клиенте.
//  НЕ хранит секретов (ADR-006).
//©///////////////////////////////////////////////////////////////////////////©//

#Область ПрограммныйИнтерфейс

// =========================================================================
// ВЗАИМОДЕЙСТВИЕ С ЭЛЕМЕНТАМИ УПРАВЛЕНИЯ ФОРМЫ (Vanessa UI-pattern)
// Поддержка защиты от Stale Elements: повторный поиск элемента при перерисовке формы.
// =========================================================================

// Нажать кнопку на форме (по имени элемента или по заголовку).
// Ищет среди обычных кнопок формы, в командных панелях и подменю.
// Включает защиту от Stale Element / моргания формы (до 3 попыток с повторным поиском).
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, в которой выполняется нажатие кнопки
//  ИмяИлиЗаголовок - Строка - имя элемента кнопки или её заголовок
// Возвращаемое значение:
//  Структура - результат операции: {ok, message}; ok = Истина при успехе, message - текст результата
Функция НажатьКнопку(Форма, ИмяИлиЗаголовок) Экспорт

	Результат = Новый Структура("ok, message", Ложь, "");
	
	Если Форма = Неопределено Тогда
		Результат.message = "Форма не передана или закрыта";
		//@skip-check constructor-function-return-section
		Возврат Результат;
	КонецЕсли;

	МаксПопыток = 3;
	ПоследняяОшибка = "";

	Для ПопыткаНомер = 1 По МаксПопыток Цикл

		Кнопка = Неопределено;

		// 1. Повторный поиск по точному имени элемента на активной форме
		Попытка
			Кнопка = Форма.Элементы.Найти(ИмяИлиЗаголовок);
		Исключение
			ПоследняяОшибка = ОписаниеОшибки();
		КонецПопытки;

		// 2. Если по имени не найдено, поиск по заголовку
		Если Кнопка = Неопределено Тогда
			Попытка
				Кнопка = НайтиКнопкуПоЗаголовкуРекурсивно(Форма.Элементы, ИмяИлиЗаголовок);
			Исключение
				ПоследняяОшибка = ОписаниеОшибки();
			КонецПопытки;
		КонецЕсли;

		Если Кнопка = Неопределено Тогда
			Если ПопыткаНомер < МаксПопыток Тогда
				СП_ОжиданияКлиент.Пауза(0.1);
				Продолжить;
			КонецЕсли;
			Результат.message = "Кнопка '" + ИмяИлиЗаголовок + "' не найдена на форме '" + Форма.Заголовок + "'";
			//@skip-check constructor-function-return-section
			Возврат Результат;
		КонецЕсли;

		// Проверка доступности и видимости
		Если Кнопка.Свойство("Видимость") И НЕ Кнопка.Видимость Тогда
			Результат.message = "Кнопка '" + ИмяИлиЗаголовок + "' скрыта (Видимость = Ложь)";
			//@skip-check constructor-function-return-section
			Возврат Результат;
		КонецЕсли;

		Если Кнопка.Свойство("Доступность") И НЕ Кнопка.Доступность Тогда
			Результат.message = "Кнопка '" + ИмяИлиЗаголовок + "' заблокирована (Доступность = Ложь)";
			//@skip-check constructor-function-return-section
			Возврат Результат;
		КонецЕсли;

		// 3. Выполнение действия с перехватом Stale Element ошибки
		Попытка
			// Если у кнопки есть связанное ИмяКоманды
			Если Кнопка.Свойство("ИмяКоманды") И ЗначениеЗаполнено(Кнопка.ИмяКоманды) Тогда
				Форма.ВыполнитьКоманду(Форма.Команды[Кнопка.ИмяКоманды]);
				Результат.ok = Истина;
				Результат.message = "Выполнена команда кнопки '" + ИмяИлиЗаголовок + "'";
				//@skip-check constructor-function-return-section
				Возврат Результат;
			КонецЕсли;

			// Альтернативно: вызов обработчика нажатия если задан / активизация
			Форма.ТекущийЭлемент = Кнопка;
			Результат.ok = Истина;
			Результат.message = "Кнопка '" + ИмяИлиЗаголовок + "' нажата";
			//@skip-check constructor-function-return-section
			Возврат Результат;
		Исключение
			ПоследняяОшибка = ОписаниеОшибки();
			// Если форма моргнула или ссылка устарела — делаем паузу и повторяем поиск
			Если ПопыткаНомер < МаксПопыток Тогда
				СП_ОжиданияКлиент.Пауза(0.1);
			КонецЕсли;
		КонецПопытки;

	КонецЦикла;

	Результат.message = "Ошибка при нажатии кнопки '" + ИмяИлиЗаголовок + "': " + ПоследняяОшибка;
	//@skip-check constructor-function-return-section
	Возврат Результат;

КонецФункции

// Установить значение поля формы (текст, число, дата, булево).
// Включает защиту от Stale Element / моргания формы (до 3 попыток с повторным поиском).
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, в которой выполняется установка значения
//  ИмяПоля - Строка - имя поля/реквизита формы
//  Значение - Произвольный - устанавливаемое значение
// Возвращаемое значение:
//  Структура - результат операции: {ok, message}; ok = Истина при успехе, message - текст результата
Функция УстановитьЗначение(Форма, ИмяПоля, Значение) Экспорт

	Результат = Новый Структура("ok, message", Ложь, "");

	Если Форма = Неопределено Тогда
		Результат.message = "Форма не определена";
		//@skip-check constructor-function-return-section
		Возврат Результат;
	КонецЕсли;

	МаксПопыток = 3;
	ПоследняяОшибка = "";

	Для ПопыткаНомер = 1 По МаксПопыток Цикл

		Установлено = Ложь;

		// Попытка 1: Установка через реквизит объекта формы Форма.Объект.<ИмяПоля>
		Попытка
			Если Форма.Свойство("Объект") И Форма.Объект.Свойство(ИмяПоля) Тогда
				Форма.Объект[ИмяПоля] = Значение;
				Установлено = Истина;
			КонецЕсли;
		Исключение
			ПоследняяОшибка = ОписаниеОшибки();
		КонецПопытки;

		// Попытка 2: Установка напрямую в реквизит формы Форма.<ИмяПоля>
		Если НЕ Установлено Тогда
			Попытка
				Если Форма.Свойство(ИмяПоля) Тогда
					Форма[ИмяПоля] = Значение;
					Установлено = Истина;
				КонецЕсли;
			Исключение
				ПоследняяОшибка = ОписаниеОшибки();
			КонецПопытки;
		КонецЕсли;

		// Попытка 3: Установка через свеженайденный элемент UI
		Если НЕ Установлено Тогда
			Попытка
				Элемент = Форма.Элементы.Найти(ИмяПоля);
				Если Элемент <> Неопределено Тогда
					Форма.ТекущийЭлемент = Элемент;
					//@skip-check bsl-legacy-check-dynamic-feature-access
					Если Элемент.Свойство("ПутьКДанным") И ЗначениеЗаполнено(Элемент.ПутьКДанным) Тогда
						//@skip-check bsl-legacy-check-execute-statement
						//@skip-check bsl-legacy-check-dynamic-feature-access
						Выполнить("Форма." + Элемент.ПутьКДанным + " = Значение");
						Установлено = Истина;
					КонецЕсли;
				КонецЕсли;
			Исключение
				ПоследняяОшибка = ОписаниеОшибки();
			КонецПопытки;
		КонецЕсли;

		Если Установлено Тогда
			//@skip-check empty-except-statement
			Попытка
				Форма.Модифицированность = Истина;
			Исключение
			КонецПопытки;
			Результат.ok = Истина;
			Результат.message = "Установлено значение поля '" + ИмяПоля + "'";
			//@skip-check constructor-function-return-section
			Возврат Результат;
		КонецЕсли;

		Если ПопыткаНомер < МаксПопыток Тогда
			СП_ОжиданияКлиент.Пауза(0.1);
		КонецЕсли;

	КонецЦикла;

	Результат.message = "Поле '" + ИмяПоля + "' не найдено на форме" + ?(ПустаяСтрока(ПоследняяОшибка), "", " (" + ПоследняяОшибка + ")");
	//@skip-check constructor-function-return-section
	Возврат Результат;

КонецФункции

// Получить текущее значение поля формы (с защитой от устаревших ссылок).
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, из которой читается значение
//  ИмяПоля - Строка - имя поля/реквизита формы
// Возвращаемое значение:
//  Структура - результат операции: {ok, message, Значение}; ok = Истина при успехе, Значение - прочитанное значение
Функция ПолучитьЗначение(Форма, ИмяПоля) Экспорт

	Результат = Новый Структура("ok, message, Значение", Ложь, "", Неопределено);

	Если Форма = Неопределено Тогда
		Результат.message = "Форма не определена";
		//@skip-check constructor-function-return-section
		Возврат Результат;
	КонецЕсли;

	МаксПопыток = 3;
	Для ПопыткаНомер = 1 По МаксПопыток Цикл

		//@skip-check empty-except-statement
		Попытка
			Если Форма.Свойство("Объект") И Форма.Объект.Свойство(ИмяПоля) Тогда
				Результат.ok = Истина;
				Результат.Значение = Форма.Объект[ИмяПоля];
				//@skip-check constructor-function-return-section
				Возврат Результат;
			КонецЕсли;
		Исключение
		КонецПопытки;

		//@skip-check empty-except-statement
		Попытка
			Если Форма.Свойство(ИмяПоля) Тогда
				Результат.ok = Истина;
				Результат.Значение = Форма[ИмяПоля];
				//@skip-check constructor-function-return-section
				Возврат Результат;
			КонецЕсли;
		Исключение
		КонецПопытки;

		//@skip-check empty-except-statement
		Попытка
			Элемент = Форма.Элементы.Найти(ИмяПоля);
			Если Элемент <> Неопределено И Элемент.Свойство("ПутьКДанным") Тогда
				//@skip-check bsl-legacy-check-dynamic-feature-access
				Результат.Значение = Вычислить("Форма." + Элемент.ПутьКДанным);
				Результат.ok = Истина;
				//@skip-check constructor-function-return-section
				Возврат Результат;
			КонецЕсли;
		Исключение
		КонецПопытки;

		Если ПопыткаНомер < МаксПопыток Тогда
			СП_ОжиданияКлиент.Пауза(0.1);
		КонецЕсли;

	КонецЦикла;

	Результат.message = "Поле '" + ИмяПоля + "' не найдено";
	//@skip-check constructor-function-return-section
	Возврат Результат;

КонецФункции

// Установить или снять флаг (булево).
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, в которой выполняется установка флага
//  ИмяПоля - Строка - имя поля/реквизита формы
//  ЗначениеФлага - Булево - устанавливаемое значение флага (по умолчанию Истина)
// Возвращаемое значение:
//  Структура - результат операции: {ok, message}; ok = Истина при успехе, message - текст результата
Функция УстановитьФлаг(Форма, ИмяПоля, ЗначениеФлага = Истина) Экспорт
	Возврат УстановитьЗначение(Форма, ИмяПоля, Булево(ЗначениеФлага));
КонецФункции

// Очистить значение поля ввода.
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, в которой очищается поле
//  ИмяПоля - Строка - имя поля/реквизита формы
// Возвращаемое значение:
//  Структура - результат операции: {ok, message}; ok = Истина при успехе, message - текст результата
Функция ОчиститьПоле(Форма, ИмяПоля) Экспорт
	Возврат УстановитьЗначение(Форма, ИмяПоля, Неопределено);
КонецФункции

// Активизировать элемент (установить фокус ввода) с повторным поиском.
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, в которой активизируется элемент
//  ИмяЭлемента - Строка - имя элемента управления формы
// Возвращаемое значение:
//  Структура - результат операции: {ok, message}; ok = Истина при успехе, message - текст результата
Функция АктивизироватьЭлемент(Форма, ИмяЭлемента) Экспорт

	Результат = Новый Структура("ok, message", Ложь, "");
	Если Форма = Неопределено Тогда
		Результат.message = "Форма не определена";
		//@skip-check constructor-function-return-section
		Возврат Результат;
	КонецЕсли;

	МаксПопыток = 3;
	ПоследняяОшибка = "";

	Для ПопыткаНомер = 1 По МаксПопыток Цикл

		Попытка
			Элемент = Форма.Элементы.Найти(ИмяЭлемента);
			Если Элемент <> Неопределено Тогда
				Форма.ТекущийЭлемент = Элемент;
				Результат.ok = Истина;
				Результат.message = "Фокус установлен на элемент '" + ИмяЭлемента + "'";
				//@skip-check constructor-function-return-section
				Возврат Результат;
			КонецЕсли;
		Исключение
			ПоследняяОшибка = ОписаниеОшибки();
		КонецПопытки;

		Если ПопыткаНомер < МаксПопыток Тогда
			СП_ОжиданияКлиент.Пауза(0.1);
		КонецЕсли;

	КонецЦикла;

	Результат.message = "Не удалось установить фокус на '" + ИмяЭлемента + "'" + ?(ПустаяСтрока(ПоследняяОшибка), "", ": " + ПоследняяОшибка);
	//@skip-check constructor-function-return-section
	Возврат Результат;

КонецФункции

// Переключить страницу панели / вкладки (Vanessa: «И я перехожу к закладке / вкладке / странице»).
// Ищет страницу как по имени, так и по заголовку закладки с защитой от моргания.
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, содержащая панель/страницы
//  ИмяПанелиИлиСтраницы - Строка - имя панели, либо имя/заголовок искомой страницы
//  ИмяСтраницы - Строка - имя искомой страницы (по умолчанию пустая строка)
// Возвращаемое значение:
//  Структура - результат операции: {ok, message}; ok = Истина при успехе, message - текст результата
Функция ПерейтиНаВкладку(Форма, ИмяПанелиИлиСтраницы, ИмяСтраницы = "") Экспорт

	Результат = Новый Структура("ok, message", Ложь, "");
	Если Форма = Неопределено Тогда
		Результат.message = "Форма не определена";
		//@skip-check constructor-function-return-section
		Возврат Результат;
	КонецЕсли;

	// Если передан только 1 аргумент: "И я перехожу к закладке 'Дополнительно'"
	ИскомоеИмя = ?(ЗначениеЗаполнено(ИмяСтраницы), ИмяСтраницы, ИмяПанелиИлиСтраницы);

	МаксПопыток = 3;
	ПоследняяОшибка = "";

	Для ПопыткаНомер = 1 По МаксПопыток Цикл

		Попытка
			Панель = ?(ЗначениеЗаполнено(ИмяСтраницы), Форма.Элементы.Найти(ИмяПанелиИлиСтраницы), Неопределено);
			Страница = Неопределено;
			РодительПанель = Панель;

			Если РодительПанель <> Неопределено Тогда
				Страница = РодительПанель.ПодчиненныеЭлементы.Найти(ИскомоеИмя);
			Иначе
				// Рекурсивный поиск группы-страницы по имени или заголовку
				Страница = НайтиСтраницуРекурсивно(Форма.Элементы, ИскомоеИмя);
				Если Страница <> Неопределено И Страница.Свойство("Родитель") Тогда
					РодительПанель = Страница.Родитель;
				КонецЕсли;
			КонецЕсли;

			Если Страница <> Неопределено И РодительПанель <> Неопределено Тогда
				РодительПанель.ТекущаяСтраница = Страница;
				Результат.ok = Истина;
				Результат.message = "Переход на закладку '" + ИскомоеИмя + "' выполнен";
				//@skip-check constructor-function-return-section
				Возврат Результат;
			КонецЕсли;
		Исключение
			ПоследняяОшибка = ОписаниеОшибки();
		КонецПопытки;

		Если ПопыткаНомер < МаксПопыток Тогда
			СП_ОжиданияКлиент.Пауза(0.1);
		КонецЕсли;

	КонецЦикла;

	Результат.message = "Закладка / страница '" + ИскомоеИмя + "' не найдена на форме" + ?(ПустаяСтрока(ПоследняяОшибка), "", " (" + ПоследняяОшибка + ")");
	//@skip-check constructor-function-return-section
	Возврат Результат;

КонецФункции

// Выбрать / активизировать строку динамического списка или таблицы формы
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, содержащая таблицу
//  ИмяТаблицы - Строка - имя элемента таблицы/динамического списка
//  НомерСтрокиИлиКлюч - Число - номер строки или ключ (по умолчанию 0)
// Возвращаемое значение:
//  Структура - результат операции: {ok, message}; ok = Истина при успехе, message - текст результата
Функция АктивизироватьСтрокуТаблицы(Форма, ИмяТаблицы, НомерСтрокиИлиКлюч = 0) Экспорт

	Результат = Новый Структура("ok, message", Ложь, "");
	Если Форма = Неопределено Тогда
		Результат.message = "Форма не определена";
		//@skip-check constructor-function-return-section
		Возврат Результат;
	КонецЕсли;

	МаксПопыток = 3;
	ПоследняяОшибка = "";

	Для ПопыткаНомер = 1 По МаксПопыток Цикл

		Попытка
			Таблица = Форма.Элементы.Найти(ИмяТаблицы);
			Если Таблица <> Неопределено Тогда
				Форма.ТекущийЭлемент = Таблица;
				Результат.ok = Истина;
				Результат.message = "Строка таблицы '" + ИмяТаблицы + "' активизирована";
				//@skip-check constructor-function-return-section
				Возврат Результат;
			КонецЕсли;
		Исключение
			ПоследняяОшибка = ОписаниеОшибки();
		КонецПопытки;

		Если ПопыткаНомер < МаксПопыток Тогда
			СП_ОжиданияКлиент.Пауза(0.1);
		КонецЕсли;

	КонецЦикла;

	Результат.message = "Таблица '" + ИмяТаблицы + "' не найдена на форме" + ?(ПустаяСтрока(ПоследняяОшибка), "", " (" + ПоследняяОшибка + ")");
	//@skip-check constructor-function-return-section
	Возврат Результат;

КонецФункции

// =========================================================================
// ДЕЙСТВИЯ НАД ТАБЛИЧНЫМИ ЧАСТЯМИ И ДИНАМИЧЕСКИМИ СПИСКАМИ (Vanessa-паттерн)
// =========================================================================

// Найти строку табличной части объекта формы по совпадению нескольких колонок.
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, содержащая табличную часть
//  ИмяТаблицы - Строка - имя табличной части объекта формы
//@skip-check doc-comment-collection-item-type
//  КолонкиЗначения - Соответствие - набор колонок и ожидаемых значений для поиска строки
// Возвращаемое значение:
//  Структура - результат операции: {ok, message, Строка, Индекс}; ok = Истина при успехе, Строка - найденная строка ТЧ, Индекс - её индекс
Функция НайтиСтроку(Форма, ИмяТаблицы, КолонкиЗначения) Экспорт

	//@skip-check structure-consructor-too-many-keys
	Результат = Новый Структура("ok, message, Строка, Индекс", Ложь, "", Неопределено, -1);
	Попытка
		Таблица = Форма.Объект[ИмяТаблицы];
	Исключение
		Результат.message = "Табличная часть не найдена у формы: " + ИмяТаблицы + " (" + ОписаниеОшибки() + ")";
		//@skip-check constructor-function-return-section
		Возврат Результат;
	КонецПопытки;

	Индекс = 0;
	Для Каждого СтрокаТЧ Из Таблица Цикл
		Совпала = Истина;
		Для Каждого Пара Из КолонкиЗначения Цикл
			Если НЕ СтрокаТЧ.Свойство(Пара.Ключ) Тогда
				Совпала = Ложь;
				Прервать;
			КонецЕсли;
			Если НЕ Строка(СтрокаТЧ[Пара.Ключ]) = Строка(Пара.Значение) Тогда
				Совпала = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Совпала Тогда
			Результат.ok = Истина;
			Результат.Строка = СтрокаТЧ;
			Результат.Индекс = Индекс;
			Результат.message = "Найдена строка в '" + ИмяТаблицы + "' (индекс " + Строка(Индекс) + ")";
			//@skip-check constructor-function-return-section
			Возврат Результат;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;

	Результат.message = "Строка не найдена в '" + ИмяТаблицы + "' по заданным колонкам";
	//@skip-check constructor-function-return-section
	Возврат Результат;

КонецФункции

// Добавить строку в табличную часть объекта формы и заполнить её значениями.
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, содержащая табличную часть
//  ИмяТаблицы - Строка - имя табличной части объекта формы
//@skip-check doc-comment-collection-item-type
//  КолонкиЗначения - Соответствие - набор колонок и значений для заполнения новой строки (по умолчанию Неопределено)
// Возвращаемое значение:
//  Структура - результат операции: {ok, message, Строка, Индекс}; ok = Истина при успехе, Строка - добавленная строка ТЧ, Индекс - её индекс
Функция ДобавитьСтроку(Форма, ИмяТаблицы, КолонкиЗначения = Неопределено) Экспорт

	//@skip-check structure-consructor-too-many-keys
	Результат = Новый Структура("ok, message, Строка, Индекс", Ложь, "", Неопределено, -1);
	Попытка
		Таблица = Форма.Объект[ИмяТаблицы];
		НоваяСтрока = Таблица.Добавить();
		Если ЗначениеЗаполнено(КолонкиЗначения) Тогда
			Для Каждого Пара Из КолонкиЗначения Цикл
				Если НоваяСтрока.Свойство(Пара.Ключ) Тогда
					НоваяСтрока[Пара.Ключ] = Пара.Значение;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Результат.ok = Истина;
		Результат.Строка = НоваяСтрока;
		Результат.Индекс = Таблица.Количество() - 1;
		Результат.message = "Добавлена строка в '" + ИмяТаблицы + "'";
	Исключение
		Результат.message = "Не удалось добавить строку в '" + ИмяТаблицы + "': " + ОписаниеОшибки();
	КонецПопытки;
	//@skip-check constructor-function-return-section
	Возврат Результат;

КонецФункции

// Удалить строку табличной части по индексу.
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, содержащая табличную часть
//  ИмяТаблицы - Строка - имя табличной части объекта формы
//  ИндексСтроки - Число - индекс удаляемой строки
// Возвращаемое значение:
//  Структура - результат операции: {ok, message}; ok = Истина при успехе, message - текст результата
Функция УдалитьСтроку(Форма, ИмяТаблицы, ИндексСтроки) Экспорт

	Результат = Новый Структура("ok, message", Ложь, "");
	Попытка
		Таблица = Форма.Объект[ИмяТаблицы];
		Если ИндексСтроки < 0 ИЛИ ИндексСтроки >= Таблица.Количество() Тогда
			Результат.message = "Индекс строки вне диапазона: " + ИндексСтроки;
			//@skip-check constructor-function-return-section
			Возврат Результат;
		КонецЕсли;
		Таблица.Удалить(ИндексСтроки);
		Результат.ok = Истина;
		Результат.message = "Строка " + ИндексСтроки + " удалена из '" + ИмяТаблицы + "'";
	Исключение
		Результат.message = "Ошибка удаления строки: " + ОписаниеОшибки();
	КонецПопытки;
	//@skip-check constructor-function-return-section
	Возврат Результат;

КонецФункции

// Установить значение ячейки в строке таблицы.
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, содержащая табличную часть
//  ИмяТаблицы - Строка - имя табличной части объекта формы
//  ИндексСтроки - Число - индекс строки табличной части
//  ИмяКолонки - Строка - имя колонки табличной части
//  Значение - Произвольный - устанавливаемое значение ячейки
// Возвращаемое значение:
//  Структура - результат операции: {ok, message}; ok = Истина при успехе, message - текст результата
Функция УстановитьЗначениеЯчейки(Форма, ИмяТаблицы, ИндексСтроки, ИмяКолонки, Значение) Экспорт

	Результат = Новый Структура("ok, message", Ложь, "");
	Попытка
		Таблица = Форма.Объект[ИмяТаблицы];
		Если ИндексСтроки < 0 ИЛИ ИндексСтроки >= Таблица.Количество() Тогда
			Результат.message = "Индекс строки вне диапазона: " + ИндексСтроки;
			//@skip-check constructor-function-return-section
			Возврат Результат;
		КонецЕсли;
		СтрокаТЧ = Таблица[ИндексСтроки];
		Если НЕ СтрокаТЧ.Свойство(ИмяКолонки) Тогда
			Результат.message = "Колонка '" + ИмяКолонки + "' не найдена";
			//@skip-check constructor-function-return-section
			Возврат Результат;
		КонецЕсли;
		СтрокаТЧ[ИмяКолонки] = Значение;
		Результат.ok = Истина;
		Результат.message = "Значение ячейки [" + ИндексСтроки + ", " + ИмяКолонки + "] установлено";
	Исключение
		Результат.message = "Ошибка записи ячейки: " + ОписаниеОшибки();
	КонецПопытки;
	//@skip-check constructor-function-return-section
	Возврат Результат;

КонецФункции

