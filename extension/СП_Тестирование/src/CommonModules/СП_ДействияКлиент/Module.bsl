// Перейти к следующей строке таблицы (позиционирование по текущей строке).
Функция ПерейтиКСледующейСтрокеТаблицы(Форма, ИмяТаблицы) Экспорт

	Результат = Новый Структура("ok, message", Ложь, "");
	Попытка
		Элемент = Форма.Элементы.Найти(ИмяТаблицы);
		Если Элемент = Неопределено ИЛИ НЕ Элемент.Свойство("ТекущаяСтрока") Тогда
			Результат.message = "Таблица '" + ИмяТаблицы + "' не найдена или не поддерживает позиционирование";
			//@skip-check constructor-function-return-section
			Возврат Результат;
		КонецЕсли;
		ТекущийНомер = Элемент.ТекущаяСтрока;
		КоличествоСтрок = КоличествоСтрокТаблицы(Форма, ИмяТаблицы, Элемент);
		Если ТекущийНомер < КоличествоСтрок Тогда
			Элемент.ТекущаяСтрока = ТекущийНомер + 1;
			Элемент.Активизировать();
			Результат.ok = Истина;
			Результат.message = "Переход к строке " + Строка(ТекущийНомер + 1) + " таблицы '" + ИмяТаблицы + "'";
		Иначе
			Результат.message = "Нет следующей строки в таблице '" + ИмяТаблицы + "' (текущая последняя)";
		КонецЕсли;
	Исключение
		Результат.message = "Ошибка перехода к следующей строке таблицы '" + ИмяТаблицы + "': " + ОписаниеОшибки();
	КонецПопытки;
	//@skip-check constructor-function-return-section
	Возврат Результат;

КонецФункции

// Перейти к последней строке таблицы.
Функция ПерейтиКПоследнейСтрокеТаблицы(Форма, ИмяТаблицы) Экспорт

	Результат = Новый Структура("ok, message", Ложь, "");
	Попытка
		Элемент = Форма.Элементы.Найти(ИмяТаблицы);
		Если Элемент = Неопределено ИЛИ НЕ Элемент.Свойство("ТекущаяСтрока") Тогда
			Результат.message = "Таблица '" + ИмяТаблицы + "' не найдена или не поддерживает позиционирование";
			//@skip-check constructor-function-return-section
			Возврат Результат;
		КонецЕсли;
		КоличествоСтрок = КоличествоСтрокТаблицы(Форма, ИмяТаблицы, Элемент);
		Если КоличествоСтрок = 0 Тогда
			Результат.message = "Таблица '" + ИмяТаблицы + "' пуста";
			//@skip-check constructor-function-return-section
			Возврат Результат;
		КонецЕсли;
		Элемент.ТекущаяСтрока = КоличествоСтрок;
		Элемент.Активизировать();
		Результат.ok = Истина;
		Результат.message = "Переход к последней строке " + Строка(КоличествоСтрок) + " таблицы '" + ИмяТаблицы + "'";
	Исключение
		Результат.message = "Ошибка перехода к последней строке таблицы '" + ИмяТаблицы + "': " + ОписаниеОшибки();
	КонецПопытки;
