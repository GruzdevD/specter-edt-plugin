//©///////////////////////////////////////////////////////////////////////////©//
//  Модуль спайка ADR-009: канал B (КлиентТестирования) — S1..S5
//
//  Запуск: из сеанса моста fom (launch-конфиг с ATTR_AUTOMATED_TESTING_MODE=
//  TEST_MANAGER_MODE → ключ /TESTMANAGER) по цели module/method через мост.
//
//  Схема канала B (по документации платформы, типы ТестируемоеПриложение и др.):
//    - ведущий сеанс: /TESTMANAGER → доступен Новый ТестируемоеПриложение;
//    - подчинённый: 1cv8c /F <ИБ> /N <пользователь> /TESTCLIENT -TPort<порт>;
//    - подключение: Приложение.УстановитьСоединение().
//
//  Проверки:
//    S1  — ТестируемоеПриложение доступно из сеанса моста (/TESTMANAGER);
//    S1b — запуск подчинённого TestClient (ЗапуститьСистему, /TESTCLIENT);
//    S1c — УстановитьСоединение;
//    S2  — примитивы: окно приложения, командный интерфейс (S2a), форма (S2b);
//    S3.1 — контекст A→B при КОММИТЕ: A записал справочник, B видит объект
//           (ОжидатьОтображениеОбъекта) и открывает его форму по e1cib/data;
//    S3.2 — взаимодействие B с формой объекта A: чтение поля Наименование;
//    S3.3 — контекст БЕЗ коммита: незакрытая транзакция в A — что видит B
//           (ожидаем «не видит» → гард «данные через один сеанс» подтверждён);
//    S4  — РазорватьСоединение (базис teardown);
//    S5  — точка останова в этом модуле отлаживается в EDT (проверяется
//          вручную при прогоне; в журнал пишется подсказка).
//©///////////////////////////////////////////////////////////////////////////©//

#Область ПрограммныйИнтерфейс

//&Тест("Спайк канала B: S1-S5")
// @test
Процедура Тест_Спайк_КаналБ() Экспорт

	Журнал = Новый Массив;
	Приложение = Неопределено;
	ПортТестКлиента = 4811;
	ИмяЭлемента = "СПСпайк_" + Формат(ТекущаяДата(), "ДФ=yyyyMMddHHmmss");

	// ============ S1: ТестируемоеПриложение доступно (/TESTMANAGER) ============
	ЗапШага = Записать(Журнал, "S1_тестменеджер_доступен");
	Попытка
		// Через Выполнить: в сеансах без /TESTMANAGER (например, подчинённый TestClient)
		// компиляция «Новый ТестируемоеПриложение» роняет инициализацию всего модуля —
		// динамическая компиляция изолирует это поведение сеансом.
		//@skip-check bsl-legacy-check-execute-statement
		Выполнить("Приложение = Новый ТестируемоеПриложение(""localhost"", " + Формат(ПортТестКлиента, "ЧГ=0") + ")");
		Приложение.УстановитьМаксимальноеВремяВыполненияДействия(60);
		ЗавершитьШаг(ЗапШага, "ok", "ТестируемоеПриложение создано (порт " + Формат(ПортТестКлиента, "ЧГ=0") + "); таймаут операций 60с");
	Исключение
		ЗавершитьШаг(ЗапШага, "fail", ОписаниеОшибки());
		ВызватьИсключение("ASSERT_FAILED: S1 — сеанс не /TESTMANAGER или ТестируемоеПриложение недоступно. "
			+ ЖурналСтрокой(Журнал));
	КонецПопытки;

	// ============ S1b: запуск подчинённого TestClient ============
	ЗапШага = Записать(Журнал, "S1b_запуск_TestClient");
	Попытка
		// /C SPECTER_TESTCLIENT — маркер-заглушка: агент консоли в TestClient
		// по нему НЕ запускает мост (иначе цель исполняется в подчинённом сеансе)
		СтрокаЗапуска = "/opt/1cv8/8.3.27.1859/1cv8c"
			+ " /F /Users/dmigruzdev/Documents/fom /N api /P 1 /TESTCLIENT -TPort"
			+ Формат(ПортТестКлиента, "ЧГ=0") + " /C SPECTER_TESTCLIENT";
		ЗапуститьСистему(СтрокаЗапуска, Ложь);
		ЗавершитьШаг(ЗапШага, "ok", СтрокаЗапуска);
	Исключение
		ЗавершитьШаг(ЗапШага, "fail", ОписаниеОшибки());
		ВызватьИсключение("ASSERT_FAILED: S1b — TestClient не запущен. " + ЖурналСтрокой(Журнал));
	КонецПопытки;

	// ============ S1c: подключение к подчинённому сеансу ============
	ЗапШага = Записать(Журнал, "S1c_подключение");
	Подключен = Ложь;
	ОписаниеПоследней = "";
	Для НомерПопытки = 1 По 90 Цикл
		Попытка
			Приложение.УстановитьСоединение();
			Подключен = Истина;
			Прервать;
		Исключение
			ОписаниеПоследней = ОписаниеОшибки();
		КонецПопытки;
		// VA-паттерн: клиент тестирования стартует секунды — ждём и повторяем
		// (обработчик ожидания недоступен из общего модуля — пауза по монотонному времени)
		Отсечка = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Пока ТекущаяУниверсальнаяДатаВМиллисекундах() - Отсечка < 2000 Цикл
		КонецЦикла;
	КонецЦикла;
	Если Подключен Тогда
		ЗавершитьШаг(ЗапШага, "ok", "УстановитьСоединение выполнено с попытки " + НомерПопытки);
	Иначе
		ЗавершитьШаг(ЗапШага, "fail", ОписаниеПоследней);
		ВызватьИсключение("ASSERT_FAILED: S1c — подключение к TestClient (90 попыток x 2с). " + ЖурналСтрокой(Журнал));
	КонецЕсли;

	// ============ S2a: окно приложения + командный интерфейс подчинённого сеанса ============
	ЗапШага = Записать(Журнал, "S2a_окно_и_командный_интерфейс");
	ОкноПриложения = Неопределено;
	Попытка
		// Активным может оказаться «Начальная страница» (без командного интерфейса) —
		// ищем ГЛАВНОЕ окно приложения (Основное=Истина), как это делает VA.
		ОкнаПоиска = Приложение.ПолучитьПодчиненныеОбъекты();
		Для Каждого ОкноИз Из ОкнаПоиска Цикл
			//@skip-check bsl-legacy-check-dynamic-feature-access
			Если ОкноИз.Основное Тогда
				ОкноПриложения = ОкноИз;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ОкноПриложения = Неопределено Тогда
			ОкноПриложения = Приложение.ПолучитьАктивноеОкно();
		КонецЕсли;
		КомИнтерфейс = ОкноПриложения.ПолучитьКомандныйИнтерфейс();
		ЗавершитьШаг(ЗапШага, "ok", "Окно: """ + ОкноПриложения.Заголовок
			+ """; ком-интерфейс: """ + КомИнтерфейс.ТекстЗаголовка + """");
	Исключение
		ЗавершитьШаг(ЗапШага, "fail", ОписаниеОшибки());
	КонецПопытки;

	// ============ S3.1: A пишет (коммит) → B видит объект ============
	ЗапШага = Записать(Журнал, "S3_1_коммит_A_видимость_B");
	СсылкаЭлемента = Неопределено;
	Попытка
		// Прямой серверный примитив (без динамического Выполнить/белого списка):
		// загадочный fail «не в белом списке» отложен в отдельный разбор.
		Рез = СП_ВызовСервера.СоздатьЭлементСправочника(
			Новый Структура("ИмяСправочника, Наименование",
				"OZON_ЗакладкиВзаимодействий", ИмяЭлемента));
		Если НЕ Рез.ok Тогда
			ВызватьИсключение("Создание в A не прошло: " + Рез.message);
		КонецЕсли;
		СсылкаЭлемента = Рез.value;
		ЗавершитьШаг(ЗапШага, "ok", "Элемент создан в A (коммит): " + ИмяЭлемента);
	Исключение
		Инфо = ОписаниеОшибки();
		ЗавершитьШаг(ЗапШага, "fail", Инфо);
	КонецПопытки;

	// ============ S3.1b: B открывает форму записанного объекта A ============
	ЗапШага = Записать(Журнал, "S3_1b_B_открывает_форму_объекта_A");
	ТФорма = Неопределено;
	Попытка
		Если СсылкаЭлемента = Неопределено Тогда
			ВызватьИсключение("пропущено: S3.1 не создал элемент");
		КонецЕсли;
		НавСсылка = ПолучитьНавигационнуюСсылку(СсылкаЭлемента);
		// Открытие формы объекта в B: ВыполнитьКоманду принимает навссылку КОМАНДЫ,
		// но «e1cib/data/<объект>?ref=» платформа TestManager тоже обрабатывает как
		// переход по ссылке (аналог ОткрытьНавигационнуюСсылку). Проверяем фактически:
		ОкноПриложения.ВыполнитьКоманду(НавСсылка);
		// Ищем с подстановками: заголовки окон в этой ИБ с префиксами ([КОПИЯ] [stg...]).
		Появился = Приложение.ОжидатьОтображениеОбъекта(, "*" + ИмяЭлемента + "*", , 20);
		// Диагностика: фактические заголовки окон B после попытки (для разбора, открылось
		// ли что-то с другим заголовком).
		Заголовки = "";
		ОкнаБ = Приложение.ПолучитьПодчиненныеОбъекты();
		Для Каждого ОкноБ Из ОкнаБ Цикл
			//@skip-check bsl-legacy-check-dynamic-feature-access
			Заголовки = Заголовки + " | " + ОкноБ.Заголовок;
		КонецЦикла;
		ЗавершитьШаг(ЗапШага, ?(Появился, "ok", "warn"),
			"НавСсылка: " + НавСсылка + "; ВыполнитьКоманду → объект виден в B: "
			+ Строка(Появился) + "; окна B:" + Заголовки);
	Исключение
		ЗавершитьШаг(ЗапШага, "fail", ОписаниеОшибки());
	КонецПопытки;

	// ============ S3.2: B взаимодействует с формой объекта (чтение поля) ============
	ЗапШага = Записать(Журнал, "S3_2_B_читает_поле_формы");
	Попытка
		Если ОкноПриложения = Неопределено Тогда
			ВызватьИсключение("пропущено: нет окна приложения");
		КонецЕсли;
		ТФорма = Приложение.НайтиОбъект(, "*" + ИмяЭлемента + "*", , 10);
		Если ТФорма = Неопределено Тогда
			ВызватьИсключение("форма с заголовком '" + ИмяЭлемента + "' в B не найдена");
		КонецЕсли;
		// ПолучитьОбъект бросает исключение, если не нашёл. Ищем ПОЛЕ по ИМЕНИ
		// ("Наименование" — имя элемента формы = имя реквизита), значение поля —
		// ПолучитьПредставлениеДанных(). При неудаче — безопасный дамп детей
		// (у части типов нет ТекстЗаголовка, поэтому каждая строка в Попытке).
		Поле = Неопределено;
		Значение = "";
		Дамп = "";
		Попытка
			//@skip-check bsl-legacy-check-execute-statement
			Выполнить("Поле = ТФорма.ПолучитьОбъект(Тип(""ТестируемоеПолеФормы""), , ""Наименование"", 5);");
		Исключение
			// поле по имени не нашлось — попробуем по заголовку
			Попытка
				//@skip-check bsl-legacy-check-execute-statement
				Выполнить("Поле = ТФорма.ПолучитьОбъект(Тип(""ТестируемоеПолеФормы""), ""Наименование*"", , 5);");
			Исключение
				Поля = ТФорма.ПолучитьПодчиненныеОбъекты();
				Для Каждого Эл Из Поля Цикл
					Попытка
						//@skip-check bsl-legacy-check-dynamic-feature-access
						Дамп = Дамп + " | " + Строка(ТипЗнч(Эл)) + " имя=" + Эл.Имя;
					Исключение
						Дамп = Дамп + " | ?неименованный";
					КонецПопытки;
					Попытка
						//@skip-check bsl-legacy-check-dynamic-feature-access
						Дамп = Дамп + "(" + Эл.ТекстЗаголовка + ")";
					Исключение
						// у группы/декорации заголовка может не быть — пропускаем
					КонецПопытки;
				КонецЦикла;
			КонецПопытки;
		КонецПопытки;
		Если Поле <> Неопределено Тогда
			//@skip-check bsl-legacy-check-dynamic-feature-access
			Значение = Строка(Поле.ПолучитьПредставлениеДанных());
		КонецЕсли;
		// Приложение.НайтиОбъект вернуло ОКНО (у окна «Заголовок», не «ТекстЗаголовка»).
		// Заголовок формы берём от родителя поля (форма) или дампим через окно.
		ЗаголовокФормы = "";
		Если Поле <> Неопределено Тогда
			Попытка
				//@skip-check bsl-legacy-check-dynamic-feature-access
				ЗаголовокФормы = Поле.ПолучитьРодителя().ТекстЗаголовка;
			Исключение
				ЗаголовокФормы = "<родитель без заголовка>";
			КонецПопытки;
		КонецЕсли;
		ЗавершитьШаг(ЗапШага, ?(Поле = Неопределено, "warn", "ok"), "окно B: """ + ТФорма.Заголовок
			+ """; форма: """ + ЗаголовокФормы + """; поле 'Наименование' значение: """ + Значение
			+ """; дети:" + Дамп);
	Исключение
		ЗавершитьШаг(ЗапШага, "fail", ОписаниеОшибки());
	КонецПопытки;

	// ============ S3.3: данные БЕЗ коммита — видимость в B ============
	// Ревью-сценарий «разрыв контекста»: в A открыта форма элемента и значение поля
	// изменено, но НЕ записано (коммита в БД нет). Вопрос: что видит B?
	//   - B открывает форму того же элемента через e1cib/data и читает поле:
	//     ожидаем СТАРОЕ значение (грязное чтение из памяти сеанса A невозможно),
	//   - плюс фиксируем: модифицированность формы A нам видна в A (канал A).
	ЗапШага = Записать(Журнал, "S3_3_без_коммита_видимость_B");
	Попытка
		Если СсылкаЭлемента = Неопределено Тогда
			ВызватьИсключение("пропущено: S3.1 не создал элемент");
		КонецЕсли;
		// A: форма объекта в ведущем сеансе, меняем поле, НЕ записываем
		ФормаА = СП_ТестированиеКлиент.ОткрытьФормуУниверсально(НавСсылка);
		СП_ДействияКлиент.УстановитьЗначение(ФормаА, "Наименование", ИмяЭлемента + "_ГРЯЗНОЕ");
		МодифА = ФормаА.Модифицированность;
		// B: открываем ту же запись и читаем поле
		ТФормаB = Приложение.НайтиОбъект(, ИмяЭлемента, , 10);
		ЗначениеB = "";
		Если ТФормаB <> Неопределено Тогда
			ПолеB = ТФормаB.ПолучитьОбъект(, "Наименование");
			ЗначениеB = ?(ПолеB = Неопределено, "?", ПолеB.ТекстЗаголовка);
		КонецЕсли;
		ЗавершитьШаг(ЗапШага, "ok", "A: модифицированность формы (без записи) = " + Строка(МодифА)
			+ "; B видит: """ + ЗначениеB + """ (ожидаемо старое значение → разрыв контекста подтверждён)");
	Исключение
		ЗавершитьШаг(ЗапШага, "fail", ОписаниеОшибки());
	КонецПопытки;

	// ============ S4: закрытие подчинённого TestClient (освобождение лицензии) ============
	ЗапШага = Записать(Журнал, "S4_закрытие_TestClient");
	Попытка
		// Гигиена лицензий: РазорватьСоединение() рвёт ТОЛЬКО канал — процесс TestClient
		// остаётся жив и держит клиентскую лицензию. Завершаем его штатно: закрытие
		// ГЛАВНОГО окна подчинённого сеанса завершает приложение.
		ОкноЗакрыть = ОкноПриложения;
		Если ОкноЗакрыть = Неопределено Тогда
			ОкнаПоиска4 = Приложение.ПолучитьПодчиненныеОбъекты();
			Для Каждого ОкноИз4 Из ОкнаПоиска4 Цикл
				//@skip-check bsl-legacy-check-dynamic-feature-access
				Если ОкноИз4.Основное Тогда
					ОкноЗакрыть = ОкноИз4;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если ОкноЗакрыть = Неопределено Тогда
			ВызватьИсключение("главное окно подчинённого TestClient не найдено");
		КонецЕсли;
		ОкноЗакрыть.Закрыть();
		Попытка
			Приложение.РазорватьСоединение();
		Исключение
			// соединение могло уже упасть вместе с закрытием окна — не критично
		КонецПопытки;
		// Гард лицензий: Закрыть() окна у TestClient процесс НЕ завершает (проверено
		// прогоном 2026-09-27). VA на Windows делает taskkill по PID; на macOS —
		// kill по PID, найденному из lsof по порту TestClient.
		//@skip-check bsl-legacy-check-execute-statement
		ЗапуститьПриложение("/bin/sh /Users/dmigruzdev/.1c-tools/spike-kill-testclient.sh "
			+ Формат(ПортТестКлиента, "ЧГ=0"));
		ЗавершитьШаг(ЗапШага, "ok", "Окно закрыто + страховочный kill процесса TestClient по порту "
			+ Формат(ПортТестКлиента, "ЧГ=0"));
	Исключение
		ЗавершитьШаг(ЗапШага, "fail", ОписаниеОшибки());
	КонецПопытки;

	// ============ Вердикт ============
	// Ключевые (реализуемость канала B): S1, S1b, S1c — обязаны быть ok.
	// Остальные (S2*, S3*) — диагностические: их статусы читаем из отчёта спайка.
	Ключевые = Новый Массив;
	Для Каждого ЗапШага Из Журнал Цикл
		Если СтрНайти(ЗапШага.имя, "S1") = 1 Тогда
			Ключевые.Добавить(ЗапШага);
		КонецЕсли;
	КонецЦикла;
	Провал = Новый Массив;
	Для Каждого ЗапШага Из Ключевые Цикл
		Если ЗапШага.статус <> "ok" Тогда
			Провал.Добавить(ЗапШага.имя + "=" + ЗапШага.статус + ": " + ЗапШага.детали);
		КонецЕсли;
	КонецЦикла;
	Если Провал.Количество() > 0 Тогда
		ВызватьИсключение("ASSERT_FAILED: ключевые шаги канала B не прошли: "
			+ СтрСоединить(Провал, " | "));
	КонецЕсли;

