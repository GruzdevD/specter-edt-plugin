#Область ПрограммныйИнтерфейс

// Собрать JSON-ответ успешного вызова (jsonrpc-style).
Функция СобратьОтвет(Ид, Результат) Экспорт

	Тело = Новый Соответствие;
	Тело.Вставить("jsonrpc", "2.0");
	Тело.Вставить("id", Ид);
	Тело.Вставить("result", Результат);

	Возврат СериализоватьВJson(Тело);

КонецФункции

// Собрать JSON-ответ ошибки (jsonrpc-style).
Функция СобратьОшибку(Ид, Код, Сообщение) Экспорт

	Ошибка = Новый Соответствие;
	Ошибка.Вставить("code", Код);
	Ошибка.Вставить("message", Сообщение);

	Тело = Новый Соответствие;
	Тело.Вставить("jsonrpc", "2.0");
	Тело.Вставить("id", Ид);
	Тело.Вставить("error", Ошибка);

	Возврат СериализоватьВJson(Тело);

КонецФункции

// Разобрать входящий JSON-запрос в структуру.
Функция РазобратьЗапрос(Текст) Экспорт

	Значение = РазобратьJson(Текст);

	Результат = Новый Структура("id, method, params", Неопределено, "", Новый Соответствие);
	Если ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Если Значение.Свойство("id") Тогда
			Результат.Вставить("id", Значение["id"]);
		КонецЕсли;
		Если Значение.Свойство("method") Тогда
			Результат.Вставить("method", Строка(Значение["method"]));
		КонецЕсли;
		Если Значение.Свойство("params") Тогда
			Результат.Вставить("params", Значение["params"]);
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Сериализовать произвольное простое значение (Структура/Соответствие/Массив/примитив) в JSON.
Функция СериализоватьВJson(Значение) Экспорт

	Запись = Новый ЗаписьJSON;
	ПараметрыJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто);
	Запись.УстановитьСтроку(ПараметрыJSON);
	ЗаписатьJSON(Запись, НормализоватьДляJSON(Значение));
	Результат = Запись.Закрыть();
	Возврат Результат;

КонецФункции

// Разобрать JSON-строку в Соответствие/Массив/примитив.
Функция РазобратьJson(Текст) Экспорт

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Результат = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Возврат Результат;

КонецФункции

// Формирование скриншота средствами платформы 1С (ОтчетОбОшибке) без сторонних DLL
Функция СформироватьСкриншотBase64() Экспорт

	РезультатBase64 = "";

	ИмяФайлаZip = КаталогВременныхФайлов() + "specter_err_" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "") + ".zip";
	КаталогВыгрузки = КаталогВременныхФайлов() + "specter_unpack_" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "") + "/";

	СоздатьКаталог(КаталогВыгрузки);

	Попытка
		ВызватьИсключение "Specter Artificial Exception for Screenshot Generation";
	Исключение
		ИнфоОшибки = ИнформацияОбОшибке();
		ОтчетОшибки = Новый ОтчетОбОшибке(ИнфоОшибки);
		ОтчетОшибки.Записать(ИмяФайлаZip);
	КонецПопытки;

	ФайлАрхива = Новый Файл(ИмяФайлаZip);
	Если ФайлАрхива.Существует() Тогда
		Попытка
			ЧтениеZip = Новый ЧтениеZipФайла(ИмяФайлаZip);
			ЧтениеZip.ИзвлечьВсе(КаталогВыгрузки, РежимВосстановленияПутейФайловZIP.НеВосстанавливать);
			ЧтениеZip.Закрыть();

			МассивФайлов = НайтиФайлы(КаталогВыгрузки, "*.png");
			Если МассивФайлов.Количество() > 0 Тогда
				ФайлСкриншота = МассивФайлов[0].ПолноеИмя;
				ДвоичныеДанныеСкриншота = Новый ДвоичныеДанные(ФайлСкриншота);
				РезультатBase64 = Base64Строка(ДвоичныеДанныеСкриншота);
			Иначе
				ПутьКPng = КаталогВыгрузки + "screenshot.png";
				ФайлPng = Новый Файл(ПутьКPng);
				Если ФайлPng.Существует() Тогда
					ДвоичныеДанныеСкриншота = Новый ДвоичныеДанные(ПутьКPng);
					РезультатBase64 = Base64Строка(ДвоичныеДанныеСкриншота);
				КонецЕсли;
			КонецЕсли;
		Исключение
			// Игнорируем ошибки чтения/распаковки
		КонецПопытки;
	КонецЕсли;

	Попытка
		УдалитьФайлы(ИмяФайлаZip);
		УдалитьФайлы(КаталогВыгрузки);
	Исключение
		// Игнорируем ошибки удаления временных файлов
	КонецПопытки;

	Возврат РезультатBase64;

КонецФункции

// =========================================================================
// АТОМАРНАЯ ЗАПИСЬ ФАЙЛОВ ОБМЕНА (Race Condition Prevention)
// Сначала пишем во временный файл *.tmp, закрываем дескриптор, затем переименовываем.
// =========================================================================

// Атомарно записать текстовое содержимое в файл по двухэтапной схеме (.tmp -> rename).
Процедура АтомарноЗаписатьТекстВФайл(ПутьКФайлу, Текст) Экспорт

	ПутьTmp = ПутьКФайлу + ".tmp";

	// 1. Создаем и полностью заполняем временный файл
	Запись = Новый ЗаписьТекста(ПутьTmp, КодировкаТекста.UTF8, Символы.ПС, Ложь);
	Запись.Записать(Текст);
	// 2. ОБЯЗАТЕЛЬНО закрываем дескриптор перед перемещением
	Запись.Закрыть();

	// 3. Атомарное перемещение / переименование в целевой файл
	Попытка
		ПереместитьФайл(ПутьTmp, ПутьКФайлу);
	Исключение
		// Если целевой файл заблокирован или уже существует на некоторых ОС, удаляем и перемещаем
		УдалитьФайлы(ПутьКФайлу);
		ПереместитьФайл(ПутьTmp, ПутьКФайлу);
	КонецПопытки;

КонецПроцедуры

// Атомарно сериализовать объект в JSON и записать в файл по двухэтапной схеме (.tmp -> rename).
Процедура АтомарноЗаписатьJSONВФайл(ПутьКФайлу, Данные) Экспорт

	ПутьTmp = ПутьКФайлу + ".tmp";

	// 1. Создаем JSON-запись во временный файл
	Запись = Новый ЗаписьJSON;
	ПараметрыJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто);
	Запись.ОткрытьФайл(ПутьTmp, , , ПараметрыJSON);
	ЗаписатьJSON(Запись, НормализоватьДляJSON(Данные));
	// 2. ОБЯЗАТЕЛЬНО закрываем дескриптор перед перемещением
	Запись.Закрыть();

	// 3. Атомарное перемещение / переименование в целевой файл
	Попытка
		ПереместитьФайл(ПутьTmp, ПутьКФайлу);
	Исключение
		УдалитьФайлы(ПутьКФайлу);
		ПереместитьФайл(ПутьTmp, ПутьКФайлу);
	КонецПопытки;

КонецПроцедуры

// Вспомогательный: превратить разобранный JSON-тип в структуру с простыми ключами.
Функция НормализоватьДляJSON(Значение)

	Если ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Результат = Новый Соответствие;
		Для Каждого КЗ Из Значение Цикл
			Результат.Вставить(Строка(КЗ.Ключ), НормализоватьДляJSON(КЗ.Значение));
		КонецЦикла;
		Возврат Результат;
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(НормализоватьДляJSON(Элемент));
		КонецЦикла;
		Возврат Результат;
	ИначеЕсли Значение = Неопределено Тогда
		Возврат Новый Структура("type, value", "null", Неопределено);
	КонецЕсли;

	Возврат Значение;

КонецФункции

#КонецОбласти
