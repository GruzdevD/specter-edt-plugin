//©///////////////////////////////////////////////////////////////////////////©//
//  СП_Утверждения - расширение afm, API тестов (R2, assert-библиотека).
//
//  Структурированные утверждения для тестов BSL по образцу YAxUnit assert-библиотеки,
//  но без зависимости от .epf и без подмены типовых библиотек. Ядро моделей проверок:
//   - исключения-assert: нарушение => ВызватьИсключение с машиночитаемым кодом
//     ASSERT_FAILED, которое движок тестов (СП_Тестирование) распознаёт как
//     падение шага/теста и фиксирует в единую модель результата (анти-маскировка D4).
//   - типизированное сравнение вместо слабого Строка()=Строка() (закрывает D3):
//     числа сравниваются как числа, даты по заданному формату, булевы как булевы,
//     ссылки/перечисления по строковому представлению, строки как строки.
//   - честная диагностика mismatch: в тексте исключения и в возвращаемой структуре
//     присутствуют «ожидал» и «получил» (не просто «не совпало»).
//
//  НЕ хранит секретов (ADR-006). Директивы: Сервер (работает и в толстом клиенте,
//  и на сервере; серверные проверки данных и проверки на сервере — основной контур R2).
//©///////////////////////////////////////////////////////////////////////////©//

#Область ПрограммныйИнтерфейс

// Код исключения, который движок трактует как падение assert.
Функция КодОшибкиУтверждения() Экспорт
	Возврат "ASSERT_FAILED";
КонецФункции

// Утверждение: условие должно быть Истина. Иначе — исключение ASSERT_FAILED.
Процедура УтверждениеИстина(Условие, Сообщение = "") Экспорт

	Если НЕ КакБулево(Условие) Тогда
		ВызватьИсключение(ФормироватьСообщениеОшибки("условие должно быть истинным",
			Сообщение, Истина, Ложь));
	КонецЕсли;

КонецПроцедуры

// Утверждение: условие должно быть Ложь.
Процедура УтверждениеЛожь(Условие, Сообщение = "") Экспорт

	Если КакБулево(Условие) Тогда
		ВызватьИсключение(ФормироватьСообщениеОшибки("условие должно быть ложным",
			Сообщение, Ложь, Истина));
	КонецЕсли;

КонецПроцедуры

// Утверждение равенства с типизированным сравнением и диагностикой mismatch.
// ФорматДаты (необязательно) — для сравнения дат по формату, напр. "ДФ='yyyyMMdd'".
Процедура УтверждениеРавенство(Ожидаемое, Фактическое, Сообщение = "", ФорматДаты = "") Экспорт

	Если НЕ ЗначенияРавны(Ожидаемое, Фактическое, ФорматДаты) Тогда
		ВызватьИсключение(ФормироватьСообщениеОшибки("значения не равны",
			Сообщение, Ожидаемое, Фактическое));
	КонецЕсли;

КонецПроцедуры

// Утверждение неравенства.
Процедура УтверждениеНеРавенство(Ожидаемое, Фактическое, Сообщение = "", ФорматДаты = "") Экспорт

	Если ЗначенияРавны(Ожидаемое, Фактическое, ФорматДаты) Тогда
		ВызватьИсключение(ФормироватьСообщениеОшибки("значения не должны быть равны",
			Сообщение, Ожидаемое, Фактическое));
	КонецЕсли;

КонецПроцедуры

// Утверждение: значение заполнено.
Процедура УтверждениеЗаполнено(Значение, Сообщение = "") Экспорт

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		ВызватьИсключение(ФормироватьСообщениеОшибки("значение должно быть заполнено",
			Сообщение, "заполнено", "не заполнено"));
	КонецЕсли;

КонецПроцедуры

// Утверждение: значение не заполнено.
Процедура УтверждениеНеЗаполнено(Значение, Сообщение = "") Экспорт

	Если ЗначениеЗаполнено(Значение) Тогда
		ВызватьИсключение(ФормироватьСообщениеОшибки("значение должно быть пустым",
			Сообщение, "пусто", Строка(Значение)));
	КонецЕсли;

КонецПроцедуры

// Утверждение: Фактическое больше Эталона (числа/даты).
Процедура УтверждениеБольше(Эталон, Фактическое, Сообщение = "") Экспорт

	Если НЕ Фактическое > Эталон Тогда
		ВызватьИсключение(ФормироватьСообщениеОшибки("значение должно быть больше эталона",
			Сообщение, Эталон, Фактическое));
	КонецЕсли;

КонецПроцедуры

// Утверждение: Фактическое меньше Эталона (числа/даты).
Процедура УтверждениеМеньше(Эталон, Фактическое, Сообщение = "") Экспорт

	Если НЕ Фактическое < Эталон Тогда
		ВызватьИсключение(ФормироватьСообщениеОшибки("значение должно быть меньше эталона",
			Сообщение, Эталон, Фактическое));
	КонецЕсли;

КонецПроцедуры

// Не бросающая проверка равенства: возвращает { ok, expected, actual, message }.
// Удобно для ведения шагов теста (assert по шагу без прерывания потока).
Функция ОжидаетРавенство(Ожидаемое, Фактическое, Сообщение = "", ФорматДаты = "") Экспорт

	Равны = ЗначенияРавны(Ожидаемое, Фактическое, ФорматДаты);
	Результат = Новый Структура("ok, expected, actual, message", Равны, Ожидаемое, Фактическое, Сообщение);
	Если НЕ Равны Тогда
		Результат.Вставить("message", ФормироватьСообщениеОшибки("значения не равны",
			Сообщение, Ожидаемое, Фактическое));
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Типизированное сравнение значений (ядро D3-фикса). Используется тестами и шагами.
Функция ЗначенияРавны(Ожидаемое, Фактическое, ФорматДаты = "") Экспорт

	Если Ожидаемое = Неопределено И Фактическое = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Если Ожидаемое = Неопределено ИЛИ Фактическое = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	ТипОжидаемого = ТипЗнч(Ожидаемое);
	ТипФактического = ТипЗнч(Фактическое);

	// Числа — как числа (не строки): 1.0 и 1 эквивалентны, пробелы не влияют.
	Если ТипОжидаемого = Тип("Число") И ТипФактического = Тип("Число") Тогда
		Возврат Ожидаемое = Фактическое;
	КонецЕсли;

	// Булевы — как булевы.
	Если ТипОжидаемого = Тип("Булево") И ТипФактического = Тип("Булево") Тогда
		Возврат Ожидаемое = Фактическое;
	КонецЕсли;

	// Даты — сравнение по формату строки (если задан) либо точное равенство дат.
	Если ТипОжидаемого = Тип("Дата") И ТипФактического = Тип("Дата") Тогда
		Если НЕ ПустаяСтрока(ФорматДаты) Тогда
			Возврат Формат(Фактическое, ФорматДаты) = Формат(Ожидаемое, ФорматДаты);
		Иначе
			Возврат Ожидаемое = Фактическое;
		КонецЕсли;
	КонецЕсли;

	// Ссылки/перечисления/объекты — по строковому представлению (несколько ссылок одного
	// элемента равны одной строке представления).
	Если СсылкаНаОбъект(ТипОжидаемого) ИЛИ СсылкаНаОбъект(ТипФактического) Тогда
		Возврат Строка(Фактическое) = Строка(Ожидаемое);
	КонецЕсли;

	// Прочие простые типы — строковое сравнение после нормализации.
	Возврат НРег(СокрЛП(Строка(Фактическое))) = НРег(СокрЛП(Строка(Ожидаемое)));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Собрать машиночитаемое сообщение ошибки assert.
Функция ФормироватьСообщениеОшибки(ТипОшибки, ПользовательскоеСообщение, Ожидаемое, Фактическое)

	Текст = КодОшибкиУтверждения() + ": " + ТипОшибки;
	Если НЕ ПустаяСтрока(ПользовательскоеСообщение) Тогда
		Текст = Текст + ". " + ПользовательскоеСообщение;
	КонецЕсли;

	// Диагностика mismatch (D4): явно «ожидал ≠ получил», а не глухое «не совпало».
	Текст = Текст + ". Ожидал: '" + Строка(Ожидаемое) + "' | Получил: '" + Строка(Фактическое) + "'";

	Возврат Текст;

КонецФункции

// Проверка, что тип значения — ссылка на объект БД/перечисление (строковое представление сравнимо).
Функция СсылкаНаОбъект(ТипЗначения)

	ИмяТипа = Строка(ТипЗначения);
	// Типы ссылок/перечислений имеют вид "СправочникСсылка.X", "ПеречислениеСсылка.X",
	// "ДокументСсылка.X", "КаталогСсылка.*" и т.п.; менеджеры/объекты — "СправочникОбъект.X".
	Если СтрНайти(ИмяТипа, "Ссылка.") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	// Объекты БД (Объект.Записать) тоже сравниваем по представлению.
	Если СтрНайти(ИмяТипа, "Объект.") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;

КонецФункции

Функция КакБулево(Значение)

	// Надёжная проверка булева: Ложь/Истина/Неопределено/число 0|1.
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение <> 0;
	Иначе
		Возврат ЗначениеЗаполнено(Значение);
	КонецЕсли;

КонецФункции

#КонецОбласти
