//©///////////////////////////////////////////////////////////////////////////©//
//  СП_ОжиданияКлиент - расширение afm, клиентские умные ожидания (Vanessa-паттерн, R3).
//
//  Аналог smart-waits Vanessa: НЕ слепой Sleep, а поллинг условия до таймаута.
//  В Vanessa это "N попыток + Sleep(1)", а сам Sleep в движке заменён неблокирующим
//  ping. Здесь два кирпича:
//   - ДождатьсяУсловия(Выражение, ТаймаутСек) - цикл, вычисляющий булево-условие, пока
//     оно не станет Истина или не выйдет таймаут; между проверками - пауза-проветривание
//     (ОбработкаПрерыванияПользователя + короткая задержка по датам), чтобы клиент
//     оставался отзывчивым и допускал отмену.
//   - Пауза(Секунд) - короткая неблокирующая пауза для перерисовки UI.
//
//  Директива: Клиент (управляемое приложение) - игровой инструмент работает ТОЛЬКО на
//  клиенте, где живёт реальный слой UI (Элементы, ВыполнитьКомандуФормы).
//  ЖР недоступен на тонком клиенте - при таймауте просто возвращаем Ложь.
//  НЕ хранит секретов (ADR-006).
//©///////////////////////////////////////////////////////////////////////////©//

#Область ПрограммныйИнтерфейс

// Дождаться открытия окна с указанным заголовком (Vanessa: «И я жду открытия окна '...'»).
//
// Параметры:
//  ЗаголовокОкна - Строка - заголовок окна/формы для поиска.
//  ТаймаутСек    - Число - таймаут ожидания в секундах (необязательно, по умолчанию 10).
//
// Возвращаемое значение:
//  Булево - Истина, если окно найдено за отведённое время.
Функция ДождатьсяОткрытияОкна(ЗаголовокОкна, ТаймаутСек = 10) Экспорт

	КоличествоПопыток = Макс(1, Цел((ТаймаутСек * 1000) / 100));
	Для Сч = 1 По КоличествоПопыток Цикл
		Окна = ПолучитьОкна();
		Для Каждого Окно Из Окна Цикл
			Если СтрНайти(ВРег(Окно.Заголовок), ВРег(ЗаголовокОкна)) > 0 Тогда
				Возврат Истина;
			КонецЕсли;
			Для Каждого Форма Из Окно.Содержимое Цикл
				Если СтрНайти(ВРег(Форма.Заголовок), ВРег(ЗаголовокОкна)) > 0 Тогда
					Возврат Истина;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Проветриться();
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Дождаться закрытия окна с указанным заголовком (Vanessa: «И я жду закрытия окна '...'»).
//
// Параметры:
//  ЗаголовокОкна - Строка - заголовок окна/формы для поиска.
//  ТаймаутСек    - Число - таймаут ожидания в секундах (необязательно, по умолчанию 10).
//
// Возвращаемое значение:
//  Булево - Истина, если окно перестало находиться за отведённое время.
Функция ДождатьсяЗакрытияОкна(ЗаголовокОкна, ТаймаутСек = 10) Экспорт

	КоличествоПопыток = Макс(1, Цел((ТаймаутСек * 1000) / 100));
	Для Сч = 1 По КоличествоПопыток Цикл
		ОкноНайдено = Ложь;
		Окна = ПолучитьОкна();
		Для Каждого Окно Из Окна Цикл
			Если СтрНайти(ВРег(Окно.Заголовок), ВРег(ЗаголовокОкна)) > 0 Тогда
				ОкноНайдено = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ ОкноНайдено Тогда
			Возврат Истина;
		КонецЕсли;
		Проветриться();
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Дождаться доступности элемента на форме (Vanessa: «И элемент '...' стал доступен»).
//
// Параметры:
//  Форма        - ФормаКлиентскогоПриложения - управляемая форма, на которой ищется элемент.
//  ИмяЭлемента  - Строка - имя элемента формы.
//  ТаймаутСек   - Число - таймаут ожидания в секундах (необязательно, по умолчанию 10).
//
// Возвращаемое значение:
//  Булево - Истина, если элемент стал доступен за отведённое время.
Функция ДождатьсяДоступностиЭлемента(Форма, ИмяЭлемента, ТаймаутСек = 10) Экспорт

	КоличествоПопыток = Макс(1, Цел((ТаймаутСек * 1000) / 100));
	Для Сч = 1 По КоличествоПопыток Цикл
		Если Форма <> Неопределено Тогда
			Элемент = Форма.Элементы.Найти(ИмяЭлемента);
			Если Элемент <> Неопределено И Элемент.Свойство("Доступность") И Элемент.Доступность Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЕсли;
		Проветриться();
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Дождаться видимости элемента на форме (Vanessa: «И элемент '...' стал видим»).
//
// Параметры:
//  Форма        - ФормаКлиентскогоПриложения - управляемая форма, на которой ищется элемент.
//  ИмяЭлемента  - Строка - имя элемента формы.
//  ТаймаутСек   - Число - таймаут ожидания в секундах (необязательно, по умолчанию 10).
//
// Возвращаемое значение:
//  Булево - Истина, если элемент стал видимым за отведённое время.
Функция ДождатьсяВидимостиЭлемента(Форма, ИмяЭлемента, ТаймаутСек = 10) Экспорт

	КоличествоПопыток = Макс(1, Цел((ТаймаутСек * 1000) / 100));
	Для Сч = 1 По КоличествоПопыток Цикл
		Если Форма <> Неопределено Тогда
			Элемент = Форма.Элементы.Найти(ИмяЭлемента);
			Если Элемент <> Неопределено И Элемент.Свойство("Видимость") И Элемент.Видимость Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЕсли;
		Проветриться();
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Дождаться появления значения в поле формы (Vanessa: «И поле '...' стало равно '...'»).
//
// Параметры:
//  Форма             - ФормаКлиентскогоПриложения - управляемая форма, на которой расположено поле.
//  ИмяПоля           - Строка - имя поля формы.
//  ОжидаемоеЗначение - Произвольный - ожидаемое значение поля.
//  ТаймаутСек        - Число - таймаут ожидания в секундах (необязательно, по умолчанию 10).
//
// Возвращаемое значение:
//  Булево - Истина, если поле приняло ожидаемое значение за отведённое время.
Функция ДождатьсяЗначения(Форма, ИмяПоля, ОжидаемоеЗначение, ТаймаутСек = 10) Экспорт

	КоличествоПопыток = Макс(1, Цел((ТаймаутСек * 1000) / 100));
	Для Сч = 1 По КоличествоПопыток Цикл
		Значение = СП_ДействияКлиент.ПолучитьЗначение(Форма, ИмяПоля);
		Если Значение.ok И Строка(Значение.Значение) = Строка(ОжидаемоеЗначение) Тогда
			Возврат Истина;
		КонецЕсли;
		Проветриться();
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Умное ожидание: поллинг булева-выражения до ТаймаутСек (пауза между проверками
// ~50 мс). Условие может быть строкой-выражением, напр. "Форма.Объект.Готово".
// Возвращает Истина, если условие выполнено, Ложь - по таймауту.
//
// Параметры:
//  Выражение  - Строка - булево-выражение (или строка-выражение) для проверки.
//  ТаймаутСек - Число - таймаут ожидания в секундах (необязательно, по умолчанию 10).
//
// Возвращаемое значение:
//  Булево - Истина, если условие выполнено до истечения таймаута.
Функция ДождатьсяУсловия(Выражение, ТаймаутСек = 10) Экспорт

	КоличествоПопыток = Макс(1, Цел((ТаймаутСек * 1000) / 50));

	Для Сч = 1 По КоличествоПопыток Цикл

		Готово = Ложь;
		Попытка
			Готово = Вычислить(Выражение);
		Исключение
			// Условие пока не вычислимо (объект ещё не готов) - норма для UI-переходных
			// состояний; продолжаем поллинг до таймаута.
			Готово = Ложь;
		КонецПопытки;

		Если Готово Тогда
			Возврат Истина;
		КонецЕсли;

		Проветриться();
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Короткая неблокирующая пауза: покрутить очередь событий, дать форме перерисоваться.
//
// Параметры:
//  Секунд - Число - длительность паузы в секундах.
Процедура Пауза(Секунд) Экспорт

	КоличествоПовторов = Макс(1, Цел(Секунд * 20));
	Для Сч = 1 По КоличествоПовторов Цикл
		ОбработкаПрерыванияПользователя();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// "Проветривание" очереди: короткое вращение с ОбработкаПрерыванияПользователя.
// Даёт платформе обработать события и откликнуться на отмену пользователя, без Sleep.
Процедура Проветриться()

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало < 50 Цикл
		ОбработкаПрерыванияПользователя();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
