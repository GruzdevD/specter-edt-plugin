//©///////////////////////////////////////////////////////////////////////////©//
//  СП_ВызовСервера - прозрачный мост Клиент -> Сервер (P2).
//
//  Позволяет клиентскому шагу выполнить серверную проверку/фабрику по имени, не внося
//  «Серверные вызовы без контекста» в код теста. Контракт серверного метода:
//    Функция Имя(Параметры) Экспорт   // Параметры - Структура простых значений/ссылок
//    Возврат Структура("ok, message, value");
//  Такую сигнатуру имеют методы СП_ПроверкиДанныхСервер и СП_ФабрикаДанных.
//
//  Безопасность: вызов строится динамически через Выполнить() и ограничен белым списком
//  модулей + проверкой имени метода на допустимые символы (защита от инъекции в строку).
//©///////////////////////////////////////////////////////////////////////////©//

#Область ПрограммныйИнтерфейс

// Выполняет серверный метод по имени и возвращает его результат {ok, message, value}.
//
// Параметры:
//   ИмяМетода - Строка - имя экспортного метода целевого модуля.
//   Параметры - Произвольный - параметр, передаваемый методу (обычно Структура).
//   ИмяМодуля - Строка - имя серверного модуля (из белого списка).
//
// Возвращаемое значение:
//   Произвольный - результат метода (для проверок данных - Структура{ok,message,value}).
Функция Выполнить(ИмяМетода, Параметры = Неопределено, ИмяМодуля = "СП_ПроверкиДанныхСервер") Экспорт

	ПроверитьРазрешенМодуль(ИмяМодуля);
	ПроверитьИмяМетода(ИмяМетода);

	//@skip-check bsl-legacy-check-execute-statement
	Выполнить("Результат = " + ИмяМодуля + "." + ИмяМетода + "(Параметры)");
	Возврат Результат;

КонецФункции

// Выполняет серверный метод и, если проверка не прошла (ok=Ложь), бросает ASSERT_FAILED.
//
// Параметры:
//   ИмяМетода - Строка - имя метода проверки.
//   Параметры - Структура - параметры проверки.
//   Сообщение - Строка - дополнительное сообщение об ошибке.
//
// Возвращаемое значение:
//   Произвольный - значение value результата (полезно: остаток, флаг и т.п.).
Функция Проверить(ИмяМетода, Параметры = Неопределено, Сообщение = "") Экспорт

	Рез = Выполнить(ИмяМетода, Параметры);
	Если НЕ ТипЗнч(Рез) = Тип("Структура") Тогда
		ВызватьИсключение("ASSERT_FAILED: серверный метод '" + ИмяМетода + "' вернул не Структуру{ok,message,value}");
	КонецЕсли;
	Если Рез.ok Тогда
		Возврат Рез.value;
	КонецЕсли;

	Текст = "ASSERT_FAILED: серверная проверка '" + ИмяМетода + "' не прошла";
	Если ЗначениеЗаполнено(Рез.message) Тогда
		Текст = Текст + ". " + Рез.message;
	КонецЕсли;
	Если НЕ ПустаяСтрока(Сообщение) Тогда
		Текст = Текст + ". " + Сообщение;
	КонецЕсли;
	ВызватьИсключение(Текст);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Белый список серверных модулей, доступных для динамического вызова.
Процедура ПроверитьРазрешенМодуль(ИмяМодуля)

	Разрешенные = Новый Соответствие;
	Разрешенные.Вставить("СП_ПроверкиДанныхСервер");
	Разрешенные.Вставить("СП_ФабрикаДанных");
	Разрешенные.Вставить("СП_ОбнаружениеТестов");

	Если НЕ Разрешенные[ИмяМодуля] Тогда
		ВызватьИсключение("СП_ВызовСервера: модуль '" + ИмяМодуля + "' не в белом списке динамического вызова");
	КонецЕсли;

КонецПроцедуры

// Проверка имени метода на допустимые символы (анти-инъекция в строку Выполнить).
Процедура ПроверитьИмяМетода(ИмяМетода)

	Если ПустаяСтрока(ИмяМетода) Тогда
		ВызватьИсключение("СП_ВызовСервера: пустое имя метода");
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(ИмяМетода) Цикл
		Символ = Сред(ИмяМетода, Индекс, 1);
		//@skip-check bsl-legacy-check-unsafe-char-use-in-code-construction
		Если НЕ ((Символ >= "А" И Символ <= "Я") ИЛИ (Символ >= "а" И Символ <= "я")
			ИЛИ (Символ >= "A" И Символ <= "Z") ИЛИ (Символ >= "a" И Символ <= "z")
			ИЛИ (Символ >= "0" И Символ <= "9") ИЛИ Символ = "_") Тогда
			ВызватьИсключение("СП_ВызовСервера: недопустимый символ в имени метода '" + ИмяМетода + "'");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
