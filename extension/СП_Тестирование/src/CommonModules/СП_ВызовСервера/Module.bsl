//©///////////////////////////////////////////////////////////////////////////©//
//  СП_ВызовСервера - прозрачный мост Клиент -> Сервер (P2).
//
//  Позволяет клиентскому шагу выполнить серверную проверку/фабрику по имени, не внося
//  «Серверные вызовы без контекста» в код теста. Контракт серверного метода:
//    Функция Имя(Параметры) Экспорт   // Параметры - Структура простых значений/ссылок
//    Возврат Структура("ok, message, value");
//  Такую сигнатуру имеют методы СП_ПроверкиДанныхСервер и СП_ФабрикаДанных.
//
//  Безопасность: вызов строится динамически через Выполнить() и ограничен белым списком
//  модулей + проверкой имени метода на допустимые символы (защита от инъекции в строку).
//©///////////////////////////////////////////////////////////////////////////©//

#Область ПрограммныйИнтерфейс

// Выполняет серверный метод по имени и возвращает его результат {ok, message, value}.
//
// Параметры:
//   ИмяМетода - Строка - имя экспортного метода целевого модуля.
//   Параметры - Произвольный - параметр, передаваемый методу (обычно Структура).
//   ИмяМодуля - Строка - имя серверного модуля (из белого списка).
//
// Возвращаемое значение:
//   Произвольный - результат метода (для проверок данных - Структура{ok,message,value}).
Функция ВыполнитьМетод(ИмяМетода, Параметры = Неопределено, ИмяМодуля = "СП_ПроверкиДанныхСервер") Экспорт

	ПроверитьРазрешенМодуль(ИмяМодуля);
	ПроверитьИмяМетода(ИмяМетода);

	Результат = Неопределено;  // присваивается динамическим Выполнить() ниже; объявлен для парсера
	//@skip-check bsl-legacy-check-execute-statement
	Выполнить("Результат = " + ИмяМодуля + "." + ИмяМетода + "(Параметры)");
	Возврат Результат;

КонецФункции

// Выполняет серверный метод и, если проверка не прошла (ok=Ложь), бросает ASSERT_FAILED.
//
// Параметры:
//   ИмяМетода - Строка - имя метода проверки.
//   Параметры - Структура - параметры проверки.
//   Сообщение - Строка - дополнительное сообщение об ошибке.
//
// Возвращаемое значение:
//   Произвольный - значение value результата (полезно: остаток, флаг и т.п.).
Функция Проверить(ИмяМетода, Параметры = Неопределено, Сообщение = "") Экспорт

	Рез = ВыполнитьМетод(ИмяМетода, Параметры);
	Если НЕ ТипЗнч(Рез) = Тип("Структура") Тогда
		ВызватьИсключение("ASSERT_FAILED: серверный метод '" + ИмяМетода + "' вернул не Структуру{ok,message,value}");
	КонецЕсли;
	Если Рез.ok Тогда
		Возврат Рез.value;
	КонецЕсли;

	Текст = "ASSERT_FAILED: серверная проверка '" + ИмяМетода + "' не прошла";
	Если ЗначениеЗаполнено(Рез.message) Тогда
		Текст = Текст + ". " + Рез.message;
	КонецЕсли;
	Если НЕ ПустаяСтрока(Сообщение) Тогда
		Текст = Текст + ". " + Сообщение;
	КонецЕсли;
	ВызватьИсключение(Текст);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Белый список серверных модулей, доступных для динамического вызова.
Процедура ПроверитьРазрешенМодуль(ИмяМодуля)

	Разрешенные = Новый Соответствие;
	Разрешенные.Вставить("СП_ПроверкиДанныхСервер");
	Разрешенные.Вставить("СП_ФабрикаДанных");
	Разрешенные.Вставить("СП_ОбнаружениеТестов");
	Разрешенные.Вставить("СП_ХранилищеКонтекста");

	// Безопасно: Соответствие[Ключ] возвращает Неопределено при отсутствии;
	// НЕ <Неопределено> в 1С бросает «Преобразование значения к типу Булево».
	Если Разрешенные.Получить(ИмяМодуля) = Неопределено Тогда
		// Диагностика: точное содержимое имени и ключей списка - в ЖР
		Ключи = "";
		Для Каждого КП Из Разрешенные Цикл
			Ключи = Ключи + КП.Ключ + "(длина " + СтрДлина(КП.Ключ) + "); ";
		КонецЦикла;
		ТекстДиагн = "ИмяМодуля=" + ИмяМодуля + " (длина " + СтрДлина(ИмяМодуля) + "); список: " + Ключи;
		ЗаписьЖурналаРегистрации("СП_ВызовСервера.БелыйСписок", УровеньЖурналаРегистрации.Ошибка, , , ТекстДиагн);
		ВызватьИсключение("СП_ВызовСервера: модуль '" + ИмяМодуля + "' не в белом списке динамического вызова");
	КонецЕсли;

КонецПроцедуры

// Проверка имени метода на допустимые символы (анти-инъекция в строку Выполнить).
Процедура ПроверитьИмяМетода(ИмяМетода)

	Если ПустаяСтрока(ИмяМетода) Тогда
		ВызватьИсключение("СП_ВызовСервера: пустое имя метода");
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(ИмяМетода) Цикл
		Символ = Сред(ИмяМетода, Индекс, 1);
		//@skip-check bsl-legacy-check-unsafe-char-use-in-code-construction
		Если НЕ ((Символ >= "А" И Символ <= "Я") ИЛИ (Символ >= "а" И Символ <= "я")
			ИЛИ (Символ >= "A" И Символ <= "Z") ИЛИ (Символ >= "a" И Символ <= "z")
			ИЛИ (Символ >= "0" И Символ <= "9") ИЛИ Символ = "_") Тогда
			ВызватьИсключение("СП_ВызовСервера: недопустимый символ в имени метода '" + ИмяМетода + "'");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти


// =========================================================================
// КОНТЕКСТНАЯ ПАМЯТЬ СЦЕНАРИЯ И ЖУРНАЛ СООБЩЕНИЙ (server-call API)
// Клиентские модули расширения не могут объявлять &НаСервере-методы,
// поэтому серверное хранение живёт здесь (белый список: СП_ХранилищеКонтекста).
// =========================================================================

// Загрузить контекстную память сценария (Соответствие) с сервера.
//
// Возвращаемое значение:
//   Соответствие, Неопределено - память сценария.
Функция ЗагрузитьПамятьСценария() Экспорт
	Возврат ХранилищеОбщихНастроек.Загрузить("СП_Тестирование", "СП_ПамятьСценария", "");
КонецФункции

// Сохранить контекстную память сценария (Соответствие) на сервере.
//
// Параметры:
//   Память - Соответствие - память сценария.
Процедура СохранитьПамятьСценария(Память) Экспорт
	ХранилищеОбщихНастроек.Сохранить("СП_Тестирование", "СП_ПамятьСценария", "", , Память);
КонецПроцедуры

// Загрузить журнал сообщений сессии (Массив) с сервера.
//
// Возвращаемое значение:
//   Массив, Неопределено - журнал сообщений сессии.
Функция ЗагрузитьЖурналСообщений() Экспорт
	Возврат ХранилищеОбщихНастроек.Загрузить("СП_Тестирование", "СП_ЖурналСообщенийСессии", "");
КонецФункции

// Сохранить журнал сообщений сессии (Массив) на сервере.
//
// Параметры:
//   Журнал - Массив - накопленные сообщения сессии.
Процедура СохранитьЖурналСообщений(Журнал) Экспорт
	ХранилищеОбщихНастроек.Сохранить("СП_Тестирование", "СП_ЖурналСообщенийСессии", "", , Журнал);
КонецПроцедуры


// =========================================================================
// СПАЙК ADR-009: прямой серверный примитив создания элемента справочника.
// Обход динамического Выполнить/белого списка, причина странного «не в белом
// списке» при живом прогоне канала B — в отдельном разборе.
// =========================================================================
// Создаёт элемент справочника с наименованием; возвращает Структура{ok,message,value}.
//
// Параметры:
//   ИмяСправочника - Строка - имя справочника.
//   Наименование   - Строка - наименование элемента.
//
// Возвращаемое значение:
//   Структура - {ok, message, value: Ссылка}.
Функция СоздатьЭлементСправочника(Параметры) Экспорт
	
	Результат = Новый Структура("ok, message, value", Ложь, "", Неопределено);
	Попытка
		Элемент = Справочники[Параметры.ИмяСправочника].СоздатьЭлемент();
		Элемент.Наименование = Параметры.Наименование;
		// OZON_ЗакладкиВзаимодействий подчинён справочнику Пользователи:
		// обязательный стандартный атрибут Владелец (fillChecking=ShowError).
		ДиагВладелец = "";
		Если Элемент.Метаданные().Владельцы.Количество() > 0 Тогда
			// Пользователи.ТекущийПользователь — БСП; в fom «Пользователи» —
			// просто менеджер справочника, поэтому ищем/создаём элемент напрямую.
			Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Пользователи ГДЕ НЕ ПометкаУдаления");
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Владелец = Выборка.Ссылка;
			Иначе
				// справочник Пользователи пуст (учётки ИБ ≠ элементы справочника) —
				// создаём технического владельца для спайк-данных
				НовыйПользователь = Справочники.Пользователи.СоздатьЭлемент();
				НовыйПользователь.Наименование = "СП Спайк (технический)";
				НовыйПользователь.Записать();
				Владелец = НовыйПользователь.Ссылка;
			КонецЕсли;
			Элемент.Владелец = Владелец;
			ДиагВладелец = "владелец=" + Строка(Владелец);
		КонецЕсли;
		Элемент.Записать();
		Результат.ok = Истина;
		Результат.value = Элемент.Ссылка;
	Исключение
		Результат.message = ОписаниеОшибки() + " [" + ДиагВладелец + "]";
	КонецПопытки;
	Возврат Результат;
	
КонецФункции
