// Capabilities механизма (проекция UiAdapterCapabilities движковой границы Runner).
//
// Возвращаемое значение:
//  Структура - capabilities адаптера (механизм, конфигурация, действия, области и пр.):
//   * Механизм - Строка - механизм адаптера.
//   * Конфигурация - Строка - конфигурация.
//   * ПоддерживаемыеКонфигурации - Массив из Строка - поддерживаемые конфигурации.
//   * Версия - Строка - версия протокола.
//   * Действия - Массив из Строка - поддерживаемые действия.
//   * Области - Массив из Строка - поддерживаемые области.
//   * ОперацииУстановки - Массив из Строка - операции установки.
//   * Проверено - Массив из Строка - подтверждённые возможности (массив примечаний о проверке).
//   * НеПоддерживается - Структура - неподдерживаемые возможности.
Функция Возможности() Экспорт

	ТестовыйКлиент = СП_ТестовыйКлиент.Возможности();

	Возможности = Новый Структура;

	Возможности.Вставить("Механизм", ТестовыйКлиент.Механизм);
	Возможности.Вставить("Конфигурация", ТестовыйКлиент.Конфигурация);

	Поддерживаемые = Новый Массив;
	Поддерживаемые.Добавить("afm");
	Возможности.Вставить("ПоддерживаемыеКонфигурации", Поддерживаемые);

	Возможности.Вставить("Версия", ТестовыйКлиент.Протокол);
	Возможности.Вставить("Действия", ТестовыйКлиент.Действия);
	Возможности.Вставить("Области", ТестовыйКлиент.Области);
	Возможности.Вставить("ОперацииУстановки", ТестовыйКлиент.ОперацииДанных);
	Возможности.Вставить("Проверено", ТестовыйКлиент.Проверено);
	Возможности.Вставить("НеПоддерживается", ТестовыйКлиент.НеПоддерживается);

	Возврат Возможности;

КонецФункции

// Подключиться к SUT (сессия). Аналог connect(SessionTarget) из adapter.ts.
//
// Параметры:
//  Конфигурация - Строка - имя целевой конфигурации (по умолчанию "afm").
//  ПараметрыСоединения - Структура, Неопределено - структура параметров подключения (например, { mode }).
//
// Возвращаемое значение:
//  Структура - результат подключения:
//   * sessionId - Строка - идентификатор сессии.
//   * status - Строка - статус подключения.
//   * mechanism - Строка - механизм подключения.
Функция ПодключитьСессию(Конфигурация = "afm", ПараметрыСоединения = Неопределено) Экспорт

	Если Конфигурация <> "afm" Тогда
		ВызватьИсключение "Адаптер afm не поддерживает конфигурацию '" + Конфигурация + "'";
	КонецЕсли;

	Подключение = СП_ТестовыйКлиент.Подключиться(ПараметрыСоединения);
	// status — реальный механизм (programmatic/test-client), а не литеральный "ready".
	Возврат Новый Структура("sessionId, status, mechanism",
		Строка(Подключение.Сессия), НРег(Строка(Подключение.Механизм)), Строка(Подключение.Механизм));

КонецФункции

// Закрыть (отключить) сессию.
//
// Параметры:
//  Сессия - Строка - идентификатор сессии, возвращённый функцией ПодключитьСессию.
Процедура ЗакрытьСессию(Сессия) Экспорт

	СП_ТестовыйКлиент.Отключиться(Сессия);

КонецПроцедуры

// Исполнение одного канонического шага (StepAction) через адаптер.
//
// Параметры:
//  Сессия - Строка - идентификатор сессии (для высокоуровневого шага).
//  Действие - Строка - строка имени действия: click/setValue/select/waitFor/assert/read/check.
//  Локатор - Соответствие - Строка -> Строка, Структура - локатор { kind, value, area }.
//  Значение - Произвольный, Неопределено - устанавливаемое значение (для setValue/select).
//  Свойство - Строка - имя читаемого свойства (для read/check/assert).
//  Ожидаемое - Произвольный, Неопределено - ожидаемое значение (для check/assert).
//  Состояние - Строка - ожидаемое состояние (для waitFor): visible/hidden/exists.
//  ТаймаутМс - Число - таймаут ожидания в миллисекундах (для waitFor).
//
//@skip-check doc-comment-collection-item-type
// Возвращаемое значение:
//  Структура - результат по ADR-004 (Disposition, ok, value, matched, error) с полем action:
//   * Disposition - Строка - исход команды (not-sent/executed/unknown).
//   * ok - Булево - признак успешного выполнения.
//   * value - Строка, Булево, Неопределено - значение.
//   * matched - Булево - признак совпадения.
//   * error - Строка - описание ошибки.
//   * action - Строка - выполненное действие.
//@skip-check method-too-many-params
Функция ИсполнитьШаг(Сессия, Действие, Локатор, Значение = Неопределено,
	Свойство = "value", Ожидаемое = Неопределено, Состояние = "visible", ТаймаутМс = 15000) Экспорт

	ЛокаторСтруктура = ПреобразоватьЛокатор(Локатор);

	Результат = СП_ТестовыйКлиент.ВыполнитьДействие(
		Действие, ЛокаторСтруктура, Значение, Свойство, Ожидаемое, Состояние, ТаймаутМс);

	Результат.Вставить("action", Действие);
	Возврат Результат;

КонецФункции

// Кандидаты возвращаются Массивом ИЛИ Неопределено; doc-синтаксис «Массив из ...» не
// выражает «, Неопределено» на уровне значения поля — constructor-check подавляем точечно.
//@skip-check constructor-function-return-section
// Разрешение локатора (resolveLocator).
//
// Параметры:
//  Локатор - Соответствие - Строка -> Строка, Структура - локатор { kind, value, area }.
//
//@skip-check doc-comment-collection-item-type
// Возвращаемое значение:
//  Структура - результат разрешения:
//   * Исход - Строка - источник.
//   * Сопоставлено - Число - количество найденных соответствий.
//   * Кандидаты - Массив из Строка, Неопределено - список кандидатов (Неопределено - совпадений не найдено).
//   * Ошибка - Строка - описание ошибки.
Функция РазрешитьЛокатор(Локатор) Экспорт

	ЛокаторСтруктура = ПреобразоватьЛокатор(Локатор);
	Результат = СП_ТестовыйКлиент.РазрешитьЛокатор(ЛокаторСтруктура);
	Возврат Результат;

КонецФункции

// Инспекция UI.
//
// Параметры:
//  Локатор - Соответствие - Строка -> Строка, Структура, Неопределено - локатор узла для инспекции (Неопределено - инспектировать всё).
//  Параметры - Структура, Неопределено - структура опций: { Лимит, Значения }.
//
//@skip-check doc-comment-collection-item-type
// Возвращаемое значение:
//  Структура - результат инспекции:
//   * ok - Булево - признак успеха.
//   * limit - Число - применённый лимит.
//   * valuesOmitted - Булево - признак пропуска значений.
//   * nodes - Массив из Строка - список узлов.
Функция Инспектировать(Локатор = Неопределено, Параметры = Неопределено) Экспорт

	ЛокаторСтруктура = Неопределено;
	Если Локатор <> Неопределено Тогда
		ЛокаторСтруктура = ПреобразоватьЛокатор(Локатор);
	КонецЕсли;

	Возврат СП_ТестовыйКлиент.Инспектировать(ЛокаторСтруктура, Параметры);

КонецФункции

// Локатор из протокола (Соответствие/Структура) в структуру { kind, value, area }.
//
// Параметры:
//  Локатор - Соответствие - Строка -> Строка, Структура, Неопределено - локатор в формате протокола (Соответствие или Структура) либо Неопределено.
//
//@skip-check doc-comment-collection-item-type
// Возвращаемое значение:
//  Структура - нормализованный локатор:
//   * kind - Строка - вид локатора.
//   * value - Строка - значение локатора.
//   * area - Строка - область локатора.
Функция ПреобразоватьЛокатор(Локатор) Экспорт

	Результат = Новый Структура("kind, value, area", "", "", "");

	Если Локатор = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(Локатор) = Тип("Соответствие") Тогда
		Если Локатор.Свойство("kind") Тогда Результат.Вставить("kind", Строка(Локатор["kind"])); КонецЕсли;
		Если Локатор.Свойство("value") Тогда Результат.Вставить("value", Строка(Локатор["value"])); КонецЕсли;
		Если Локатор.Свойство("area") Тогда Результат.Вставить("area", Строка(Локатор["area"])); КонецЕсли;
	ИначеЕсли ТипЗнч(Локатор) = Тип("Структура") Тогда
		Если Локатор.Свойство("kind") Тогда Результат.Вставить("kind", Строка(Локатор.kind)); КонецЕсли;
		Если Локатор.Свойство("value") Тогда Результат.Вставить("value", Строка(Локатор.value)); КонецЕсли;
		Если Локатор.Свойство("area") Тогда Результат.Вставить("area", Строка(Локатор.area)); КонецЕсли;
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти
