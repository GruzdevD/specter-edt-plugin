#Область ПрограммныйИнтерфейс

// Capabilities механизма (проекция UiAdapterCapabilities движковой границы Runner).
Функция Возможности() Экспорт

	ТестовыйКлиент = СП_ТестовыйКлиент.Возможности();

	Возможности = Новый Структура;

	Возможности.Вставить("Механизм", ТестовыйКлиент.Механизм);
	Возможности.Вставить("Конфигурация", ТестовыйКлиент.Конфигурация);

	Поддерживаемые = Новый Массив;
	Поддерживаемые.Добавить("afm");
	Возможности.Вставить("ПоддерживаемыеКонфигурации", Поддерживаемые);

	Возможности.Вставить("Версия", ТестовыйКлиент.Протокол);
	Возможности.Вставить("Действия", ТестовыйКлиент.Действия);
	Возможности.Вставить("Области", ТестовыйКлиент.Области);
	Возможности.Вставить("ОперацииУстановки", ТестовыйКлиент.ОперацииДанных);
	Возможности.Вставить("Проверено", ТестовыйКлиент.Проверено);
	Возможности.Вставить("НеПоддерживается", ТестовыйКлиент.НеПоддерживается);

	Возврат Возможности;

КонецФункции

// Подключиться к SUT (сессия). Аналог connect(SessionTarget) из adapter.ts.
Функция ПодключитьСессию(Конфигурация = "afm", ПараметрыСоединения = Неопределено) Экспорт

	Если Конфигурация <> "afm" Тогда
		ВызватьИсключение "Адаптер afm не поддерживает конфигурацию '" + Конфигурация + "'";
	КонецЕсли;

	Подключение = СП_ТестовыйКлиент.Подключиться(ПараметрыСоединения);
	// status — реальный механизм (programmatic/test-client), а не литеральный "ready".
	Возврат Новый Структура("sessionId, status, mechanism",
		Строка(Подключение.Сессия), НРег(Строка(Подключение.Механизм)), Строка(Подключение.Механизм));

КонецФункции

// Закрыть (отключить) сессию.
Процедура ЗакрытьСессию(Сессия) Экспорт

	СП_ТестовыйКлиент.Отключиться(Сессия);

КонецПроцедуры

// Исполнение одного канонического шага (StepAction) через адаптер.
Функция ИсполнитьШаг(Сессия, Действие, Локатор, Значение = Неопределено,
	Свойство = "value", Ожидаемое = Неопределено, Состояние = "visible", ТаймаутМс = 15000) Экспорт

	ЛокаторСтруктура = ПреобразоватьЛокатор(Локатор);

	Результат = СП_ТестовыйКлиент.ВыполнитьДействие(
		Действие, ЛокаторСтруктура, Значение, Свойство, Ожидаемое, Состояние, ТаймаутМс);

	Результат.Вставить("action", Действие);
	Возврат Результат;

КонецФункции

// Разрешение локатора (resolveLocator).
Функция РазрешитьЛокатор(Локатор) Экспорт

	ЛокаторСтруктура = ПреобразоватьЛокатор(Локатор);
	Результат = СП_ТестовыйКлиент.РазрешитьЛокатор(ЛокаторСтруктура);
	Возврат Результат;

КонецФункции

// Инспекция UI.
Функция Инспектировать(Локатор = Неопределено, Параметры = Неопределено) Экспорт

	ЛокаторСтруктура = Неопределено;
	Если Локатор <> Неопределено Тогда
		ЛокаторСтруктура = ПреобразоватьЛокатор(Локатор);
	КонецЕсли;

	Возврат СП_ТестовыйКлиент.Инспектировать(ЛокаторСтруктура, Параметры);

КонецФункции

// Локатор из протокола (Соответствие/Структура) в структуру { kind, value, area }.
Функция ПреобразоватьЛокатор(Локатор) Экспорт

	Результат = Новый Структура("kind, value, area", "", "", "");

	Если Локатор = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(Локатор) = Тип("Соответствие") Тогда
		Если Локатор.Свойство("kind") Тогда Результат.Вставить("kind", Строка(Локатор["kind"])); КонецЕсли;
		Если Локатор.Свойство("value") Тогда Результат.Вставить("value", Строка(Локатор["value"])); КонецЕсли;
		Если Локатор.Свойство("area") Тогда Результат.Вставить("area", Строка(Локатор["area"])); КонецЕсли;
	ИначеЕсли ТипЗнч(Локатор) = Тип("Структура") Тогда
		Если Локатор.Свойство("kind") Тогда Результат.Вставить("kind", Строка(Локатор.kind)); КонецЕсли;
		Если Локатор.Свойство("value") Тогда Результат.Вставить("value", Строка(Локатор.value)); КонецЕсли;
		Если Локатор.Свойство("area") Тогда Результат.Вставить("area", Строка(Локатор.area)); КонецЕсли;
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти
