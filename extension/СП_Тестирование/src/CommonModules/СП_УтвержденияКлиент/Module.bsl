//©///////////////////////////////////////////////////////////////////////////©//
//  СП_УтвержденияКлиент - клиентские утверждения для сценариев на реальном UI.
//
//  Клиентский аналог СП_Утверждения (R2, assert-библиотека) для контура
//  реального UI: сконвертированные из Vanessa сценарии исполняются в
//  управляемом клиенте, где серверный модуль недоступен (undefined-variable).
//  Нарушение утверждения => ВызватьИсключение с машиночитаемым кодом
//  ASSERT_FAILED, который клиентский раннер (СП_ТестированиеКлиент) распознаёт
//  как падение шага/теста и фиксирует в единую модель результата.
//
//  Директивы: Клиент (управляемое приложение + обычное приложение).
//©///////////////////////////////////////////////////////////////////////////©//

#Область ПрограммныйИнтерфейс

// Код исключения, который движок трактует как падение assert.
//
// Возвращаемое значение:
//  Строка - код исключения ASSERT_FAILED.
Функция КодОшибкиУтверждения() Экспорт
	Возврат "ASSERT_FAILED";
КонецФункции

// Утверждение: условие должно быть Истина. Иначе - исключение ASSERT_FAILED.
//
// Параметры:
//  Условие   - Булево - проверяемое условие (должно быть истинным).
//  Сообщение - Строка - текст сообщения об ошибке (необязательно).
Процедура УтверждениеИстина(Условие, Сообщение = "") Экспорт

	Если НЕ КакБулево(Условие) Тогда
		ВызватьИсключение(ФормироватьСообщениеОшибки("условие должно быть истинным",
			Сообщение, Истина, Ложь));
	КонецЕсли;

КонецПроцедуры

// Утверждение: условие должно быть Ложь.
//
// Параметры:
//  Условие   - Булево - проверяемое условие (должно быть ложным).
//  Сообщение - Строка - текст сообщения об ошибке (необязательно).
Процедура УтверждениеЛожь(Условие, Сообщение = "") Экспорт

	Если КакБулево(Условие) Тогда
		ВызватьИсключение(ФормироватьСообщениеОшибки("условие должно быть ложным",
			Сообщение, Ложь, Истина));
	КонецЕсли;

КонецПроцедуры

// Утверждение равенства с типизированным сравнением и диагностикой mismatch.
//
// Параметры:
//  Ожидаемое   - Произвольный - ожидаемое значение.
//  Фактическое - Произвольный - фактическое значение.
//  Сообщение   - Строка - текст сообщения об ошибке (необязательно).
Процедура УтверждениеРавенство(Ожидаемое, Фактическое, Сообщение = "") Экспорт

	Если НЕ ЗначенияРавны(Ожидаемое, Фактическое) Тогда
		ВызватьИсключение(ФормироватьСообщениеОшибки("значения не равны",
			Сообщение, Ожидаемое, Фактическое));
	КонецЕсли;

КонецПроцедуры

// Утверждение неравенства.
//
// Параметры:
//  Ожидаемое   - Произвольный - ожидаемое значение.
//  Фактическое - Произвольный - фактическое значение.
//  Сообщение   - Строка - текст сообщения об ошибке (необязательно).
Процедура УтверждениеНеРавенство(Ожидаемое, Фактическое, Сообщение = "") Экспорт

	Если ЗначенияРавны(Ожидаемое, Фактическое) Тогда
		ВызватьИсключение(ФормироватьСообщениеОшибки("значения не должны быть равны",
			Сообщение, Ожидаемое, Фактическое));
	КонецЕсли;

КонецПроцедуры

// Утверждение: значение заполнено.
//
// Параметры:
//  Значение  - Произвольный - проверяемое значение.
//  Сообщение - Строка - текст сообщения об ошибке (необязательно).
Процедура УтверждениеЗаполнено(Значение, Сообщение = "") Экспорт

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		ВызватьИсключение(ФормироватьСообщениеОшибки("значение должно быть заполнено",
			Сообщение, "заполнено", "не заполнено"));
	КонецЕсли;

КонецПроцедуры

// Утверждение: значение не заполнено.
//
// Параметры:
//  Значение  - Произвольный - проверяемое значение.
//  Сообщение - Строка - текст сообщения об ошибке (необязательно).
Процедура УтверждениеНеЗаполнено(Значение, Сообщение = "") Экспорт

	Если ЗначениеЗаполнено(Значение) Тогда
		ВызватьИсключение(ФормироватьСообщениеОшибки("значение должно быть пустым",
			Сообщение, "пусто", Строка(Значение)));
	КонецЕсли;

КонецПроцедуры

// Типизированное сравнение значений. Используется тестами и шагами.
//
// Параметры:
//  Ожидаемое  - Произвольный - ожидаемое значение.
//  Фактическое - Произвольный - фактическое значение.
//
// Возвращаемое значение:
//  Булево - Истина, если значения эквивалентны.
Функция ЗначенияРавны(Ожидаемое, Фактическое) Экспорт

	Если Ожидаемое = Неопределено И Фактическое = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Если Ожидаемое = Неопределено ИЛИ Фактическое = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	ТипОжидаемого = ТипЗнч(Ожидаемое);
	ТипФактического = ТипЗнч(Фактическое);

	// Числа - как числа (не строки): 1.0 и 1 эквивалентны.
	Если ТипОжидаемого = Тип("Число") И ТипФактического = Тип("Число") Тогда
		Возврат Ожидаемое = Фактическое;
	КонецЕсли;

	// Булевы - как булевы.
	Если ТипОжидаемого = Тип("Булево") И ТипФактического = Тип("Булево") Тогда
		Возврат Ожидаемое = Фактическое;
	КонецЕсли;

	// Даты - точное равенство дат.
	Если ТипОжидаемого = Тип("Дата") И ТипФактического = Тип("Дата") Тогда
		Возврат Ожидаемое = Фактическое;
	КонецЕсли;

	// Ссылки/перечисления/объекты - по строковому представлению.
	Если ТипСсылкаИлиОбъект(ТипОжидаемого) ИЛИ ТипСсылкаИлиОбъект(ТипФактического) Тогда
		Возврат Строка(Фактическое) = Строка(Ожидаемое);
	КонецЕсли;

	// Прочие простые типы - строковое сравнение после нормализации.
	Возврат НРег(СокрЛП(Строка(Фактическое))) = НРег(СокрЛП(Строка(Ожидаемое)));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Собрать машиночитаемое сообщение ошибки assert.
//
// Параметры:
//  ТипОшибки             - Строка - краткое описание нарушения.
//  ПользовательскоеСообщение - Строка - текст сообщения пользователя.
//  Ожидаемое             - Произвольный - ожидаемое значение.
//  Фактическое           - Произвольный - фактическое значение.
//
// Возвращаемое значение:
//  Строка - сообщение с кодом ASSERT_FAILED и диагностикой «ожидал | получил».
Функция ФормироватьСообщениеОшибки(ТипОшибки, ПользовательскоеСообщение, Ожидаемое, Фактическое)

	Текст = КодОшибкиУтверждения() + ": " + ТипОшибки;
	Если НЕ ПустаяСтрока(ПользовательскоеСообщение) Тогда
		Текст = Текст + ". " + ПользовательскоеСообщение;
	КонецЕсли;

	// Диагностика mismatch: явно «ожидал ≠ получил», а не глухое «не совпало».
	Текст = Текст + ". Ожидал: '" + Строка(Ожидаемое) + "' | Получил: '" + Строка(Фактическое) + "'";

	Возврат Текст;

КонецФункции

// Проверка, что тип значения - ссылка/объект БД или перечисление (строковое представление сравнимо).
//
// Параметры:
//  ТипЗначения - Тип - проверяемый тип.
//
// Возвращаемое значение:
//  Булево - Истина, если тип - ссылка или объект БД/перечисление.
Функция ТипСсылкаИлиОбъект(ТипЗначения)

	ИмяТипа = Строка(ТипЗначения);
	// Типы ссылок/перечислений имеют вид "СправочникСсылка.X", "ПеречислениеСсылка.X",
	// "ДокументСсылка.X"; менеджеры/объекты - "СправочникОбъект.X".
	Если СтрНайти(ИмяТипа, "Ссылка.") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Если СтрНайти(ИмяТипа, "Объект.") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;

КонецФункции

// Надёжная проверка булева: Ложь/Истина/Неопределено/число 0|1.
//
// Параметры:
//  Значение - Произвольный - проверяемое значение.
//
// Возвращаемое значение:
//  Булево - интерпретация значения как истинности.
Функция КакБулево(Значение)

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение <> 0;
	Иначе
		Возврат ЗначениеЗаполнено(Значение);
	КонецЕсли;

КонецФункции

#КонецОбласти
