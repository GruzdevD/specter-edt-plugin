//©///////////////////////////////////////////////////////////////////////////©//
//  СП_Тестирование - расширение afm, ядро BSL-процесса (R2).
//
//  Обнаружение, отбор и запуск тестовых наборов по рабочему процессу в духе YAxUnit,
//  но БЕЗ .epf и без подмены YAxUnit: тесты живут в общих модулях расширения (наборах),
//  каждый набор реализует согласованный интерфейс из двух экспортируемых функций:
//    СписокТестов()                       -> Массив { Имя, Описание, Теги };
//    ЗапуститьНаборТестов(Критерии)       -> Массив результатов тестов (единая модель).
//  Движок держит КАТАЛОГ наборов (стандартный для поставляемой поставки: добавить набор
//  = добавить тест-модуль + строку в каталог и ветку диспетчера). Динамический вызов
//  процедур общего модуля по строковому имени платформа не гарантирует, поэтому вызов
//  набора выполняется явным диспетчером (детерминированно и проверяемо), а НЕ рефлексией.
//
//  АНТИ-МАСКИРОВКА (контракты §): результат теста несёт честный status из белого списка
//  (passed/failed/skipped/aborted); инфраструктурная ошибка набора НЕ превращается в
//  зелёный тест; assert-failure (СП_Утверждения.ASSERT_FAILED) классифицируется как
//  failed, сбои исполнения — как aborted, отбор по тегам пустой — как skipped.
//
//  НЕ хранит секретов (ADR-006). Директивы: Сервер.
//©///////////////////////////////////////////////////////////////////////////©//

#Область ПрограммныйИнтерфейс

// Белый список статусов (проекция контрактной модели RunState/step.status).
Функция СтатусПройден() Экспорт
	Возврат "passed";
КонецФункции

Функция СтатусПровален() Экспорт
	Возврат "failed";
КонецФункции

Функция СтатусПропущен() Экспорт
	Возврат "skipped";
КонецФункции

Функция СтатусПрерван() Экспорт
	Возврат "aborted";
КонецФункции

// Каталог наборов: Соответствие ИмяНабора -> Структура{ИмяМодуля, Описание}.
// ДИНАМИЧЕСКИЙ ДВИЖОК: находит модули тестов разработчиков по метаданным конфигурации и расширений
// (по конвенции СП_Тест*, *Тест*, *Тесты*, *Tests*), либо через явную регистрацию.
// В расширении СП_Тестирование нет жестко зашитых тестов предметной области!
Функция КаталогНаборов() Экспорт

	Каталог = Новый Соответствие;

	// 1. Поиск по метаданным ОбщиеМодули
	Для Каждого ОбщийМодульМД Из Метаданные.ОбщиеМодули Цикл
		ИмяМодуля = ОбщийМодульМД.Имя;
		Если ЯвляетсяМодулемТестов(ИмяМодуля) Тогда
			ИмяНабора = ПолучитьИмяНабораПоМодулю(ИмяМодуля);
			Каталог.Вставить(ИмяНабора, Новый Структура(
				"ИмяМодуля, Описание",
				ИмяМодуля,
				?(ПустаяСтрока(ОбщийМодульМД.Синоним), "Тестовый набор " + ИмяНабора, ОбщийМодульМД.Синоним)));
		КонецЕсли;
	КонецЦикла;

	Возврат Каталог;

КонецФункции

// Регистрация набора тестов вручную (если модуль не подошел под конвенцию имен).
Процедура ЗарегистрироватьНабор(ИмяНабора, ИмяМодуля, Описание = "") Экспорт
	// Точка для явной программной регистрации наборов в приложении
КонецПроцедуры

// Проверка имени модуля на принадлежность к тестовым наборам
Функция ЯвляетсяМодулемТестов(ИмяМодуля) Экспорт

	// Служебные модули движка СП_ исключаем
	Если ИмяМодуля = "СП_Тестирование"
		ИЛИ ИмяМодуля = "СП_ТестовыйКлиент"
		ИЛИ ИмяМодуля = "СП_ТестовыеДанные"
		ИЛИ ИмяМодуля = "СП_Утверждения"
		ИЛИ ИмяМодуля = "СП_АдаптерКлиент"
		ИЛИ ИмяМодуля = "СП_Протокол"
		ИЛИ ИмяМодуля = "СП_СправочникИменКлиент"
		ИЛИ ИмяМодуля = "СП_ГенераторДанных"
		ИЛИ ИмяМодуля = "СП_ДействияКлиент"
		ИЛИ ИмяМодуля = "СП_ИнспекторКлиент"
		ИЛИ ИмяМодуля = "СП_ОжиданияКлиент"
		ИЛИ ИмяМодуля = "СП_ПроксиФормыКлиент" Тогда
		Возврат Ложь;
	КонецЕсли;

	ИмяНРег = НРег(ИмяМодуля);
	Возврат СтрНачинаетсяС(ИмяНРег, "сп_тест")
		ИЛИ СтрНачинаетсяС(ИмяНРег, "тест_")
		ИЛИ СтрНачинаетсяС(ИмяНРег, "тесты_")
		ИЛИ СтрНайти(ИмяНРег, "_тест") > 0
		ИЛИ СтрНайти(ИмяНРег, "tests") > 0;

КонецФункции

// Получить чистое имя набора для отображения в дереве и отчете
Функция ПолучитьИмяНабораПоМодулю(ИмяМодуля)

	ИмяНабора = ИмяМодуля;
	Если СтрНачинаетсяС(ИмяНабора, "СП_Тесты_") Тогда
		ИмяНабора = Сред(ИмяНабора, 10);
	ИначеЕсли СтрНачинаетсяС(ИмяНабора, "СП_Тест_") Тогда
		ИмяНабора = Сред(ИмяНабора, 9);
	ИначеЕсли СтрНачинаетсяС(ИмяНабора, "Тесты_") Тогда
		ИмяНабора = Сред(ИмяНабора, 7);
	ИначеЕсли СтрНачинаетсяС(ИмяНабора, "Тест_") Тогда
		ИмяНабора = Сред(ИмяНабора, 6);
	КонецЕсли;

	Возврат ИмяНабора;

КонецФункции

// Список имён наборов.
Функция СписокНаборов() Экспорт

	Каталог = КаталогНаборов();
	Имена = Новый Массив;
	Для Каждого КЗ Из Каталог Цикл
		Имена.Добавить(КЗ.Ключ);
	КонецЦикла;
	Возврат Имена;

КонецФункции

// Обнаружение тестов: массив { Набор, Имя, Описание, Теги } по всем наборам (или одному).
Функция СписокТестов(ИмяНабора = "") Экспорт

	Каталог = КаталогНаборов();
	Результат = Новый Массив;

	Для Каждого КЗ Из Каталог Цикл
		Если НЕ ПустаяСтрока(ИмяНабора) И НРег(ИмяНабора) <> НРег(Строка(КЗ.Ключ)) Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Тесты = Служебный_ПолучитьСписокТестов(КЗ.Значение.ИмяМодуля);
		Исключение
			// Проблема discovery набора — честно маркируем каждый его тест как помеху? Нет:
			// добавляем один маркер недоступного набора (не тихий пропуск discovery).
			Результат.Добавить(Новый Структура(
				"Набор, Имя, Описание, Теги, ОшибкаDiscovery",
				Строка(КЗ.Ключ), "", "Набор недоступен", Новый Массив,
				ОписаниеОшибки()));
			Продолжить;
		КонецПопытки;
		Для Каждого Тест Из Тесты Цикл
			СтруктураТеста = Новый Структура(
				"Набор, Имя, Описание, Теги, Отключен, ПричинаОтключения, ОшибкаDiscovery",
				Строка(КЗ.Ключ), Тест.Имя, ?(Тест.Свойство("Описание"), Тест.Описание, ""),
				?(Тест.Свойство("Теги"), Тест.Теги, Новый Массив),
				?(Тест.Свойство("Отключен"), Тест.Отключен, Ложь),
				?(Тест.Свойство("ПричинаОтключения"), Тест.ПричинаОтключения, ""), "");
			Результат.Добавить(СтруктураТеста);
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Запустить набор (или все наборы) с отбором по тегам. Критерии: { Набор?, Теги?, ИмяТеста? }.
// Возвращает { Набор, Итог, Тесты } где Тесты — массив результатов (единая модель).
Функция Запустить(Критерии = Неопределено) Экспорт

	ИмяНабора = ЗначениеКритерия(Критерии, "Набор", "");
	ОтборТегов = ЗначениеКритерия(Критерии, "Теги", "");
	ИмяКонкретногоТеста = ЗначениеКритерия(Критерии, "ИмяТеста", "");

	Каталог = КаталогНаборов();
	Сводка = Новый Структура("Набор, Итог, Тесты", ИмяНабора, СтатусПройден(), Новый Массив);

	Для Каждого КЗ Из Каталог Цикл
		Если НЕ ПустаяСтрока(ИмяНабора) И НРег(ИмяНабора) <> НРег(Строка(КЗ.Ключ)) Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			РезультатыНабора = Служебный_ВызватьЗапускНабора(
				КЗ.Значение.ИмяМодуля, ОтборТегов, ИмяКонкретногоТеста);
		Исключение
			// Инфраструктурная ошибка [набора/ВСЕГО прогона] => aborted, НЕ зелёный.
			Прерван = Новый Структура(
				"Имя, Статус, Сообщение, ДлительностьМс, События, Ошибка",
				КЗ.Ключ, СтатусПрерван(),
				"Сбой исполнения набора: " + ОписаниеОшибки(), 0, Новый Массив, ОписаниеОшибки());
			РезультатыНабора = Новый Массив;
			РезультатыНабора.Добавить(Прерван);
		КонецПопытки;

		Для Каждого Рез Из РезультатыНабора Цикл
			Сводка.Тесты.Добавить(Рез);
			Если Рез.Статус = СтатусПровален() ИЛИ Рез.Статус = СтатусПрерван() Тогда
				Сводка.Итог = СтатусПровален();
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Сводка;

КонецФункции

// Компактный отчёт прогона в виде структуры для сериализации (без циклических объектов).
Функция СформироватьОтчёт(Сводка) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("status", Сводка.Итог);
	Результат.Вставить("tests", Новый Массив);

	Для Каждого Тест Из Сводка.Тесты Цикл
		Запись = Новый Структура(
			"name, status, durationMs, message, error",
			Тест.Имя, Тест.Статус, Тест.ДлительностьМс, ОбъединитьСообщения(Тест), Тест.Ошибка);
		Результат.Вставить("tests", Служебный_ДобавитьВМассив(Результат.tests, Запись));
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Динамический диспетчер вызова набора или конкретного теста в модуле разработчика.
Функция Служебный_ВызватьЗапускНабора(ИмяМодуля, ОтборТегов, ИмяКонкретногоТеста)

	Критерии = Новый Структура("Теги, ИмяТеста", ОтборТегов, ИмяКонкретногоТеста);

	// Вариант 1: Модуль реализует стандартную точку ЗапуститьНаборТестов(Критерии)
	Попытка
		Возврат Вычислить(ИмяМодуля + ".ЗапуститьНаборТестов(Критерии)");
	Исключение
		// Вариант 2: Запуск конкретной процедуры теста напрямую
		Если ЗначениеЗаполнено(ИмяКонкретногоТеста) Тогда
			ДатаНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
			Попытка
				Выполнить(ИмяМодуля + "." + ИмяКонкретногоТеста + "()");
				Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - ДатаНачала;
				Рез = Новый Структура(
					"Имя, Статус, Сообщение, ДлительностьМс, События, Ошибка",
					ИмяКонкретногоТеста, СтатусПройден(), "Тест выполнен успешно", Длительность, Новый Массив, "");
			Исключение
				Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - ДатаНачала;
				ТекстОшибки = ОписаниеОшибки();
				Статус = ?(СтрНайти(ТекстОшибки, "ASSERT_FAILED") > 0, СтатусПровален(), СтатусПрерван());
				Рез = Новый Структура(
					"Имя, Статус, Сообщение, ДлительностьМс, События, Ошибка",
					ИмяКонкретногоТеста, Статус, ТекстОшибки, Длительность, Новый Массив, ТекстОшибки);
			КонецПопытки;

			Результаты = Новый Массив;
			Результаты.Добавить(Рез);
			Возврат Результаты;
		Иначе
			ВызватьИсключение "Модуль " + ИмяМодуля + " не экспортирует ЗапуститьНаборТестов: " + ОписаниеОшибки();
		КонецЕсли;
	КонецПопытки;

КонецФункции

Функция Служебный_ПолучитьСписокТестов(ИмяМодуля)

	Попытка
		Возврат Вычислить(ИмяМодуля + ".СписокТестов()");
	Исключение
		// Если модуль не экспортирует СписокТестов, возвращаем пустой список (или динамически зарегистрированные)
		Возврат Новый Массив;
	КонецПопытки;

КонецФункции

// Значение критерия запуска из структуры (с учётом пустых/отсутствующих).
Функция ЗначениеКритерия(Критерии, Ключ, ПоУмолчанию = "")

	Если ЗначениеЗаполнено(Критерии) И Критерии.Свойство(Ключ) Тогда
		Значение = Критерии[Ключ];
		Если ЗначениеЗаполнено(Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;
	Возврат ПоУмолчанию;

КонецФункции

// Собрать человекочитаемое сообщение результата (message + ошибка) для отчёта.
Функция ОбъединитьСообщения(Тест)

	Текст = "";
	Если Тест.Свойство("Сообщение") И НЕ ПустаяСтрока(Тест.Сообщение) Тогда
		Текст = Тест.Сообщение;
	КонецЕсли;
	Если Тест.Свойство("Ошибка") И НЕ ПустаяСтрока(Тест.Ошибка) Тогда
		Если НЕ ПустаяСтрока(Текст) Тогда
			Текст = Текст + " | ";
		КонецЕсли;
		Текст = Текст + Тест.Ошибка;
	КонецЕсли;
	Возврат Текст;

КонецФункции

Функция Служебный_ДобавитьВМассив(Массив, Элемент)

	Массив.Добавить(Элемент);
	Возврат Массив;

КонецФункции

#КонецОбласти
