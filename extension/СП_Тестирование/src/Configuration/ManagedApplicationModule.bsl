//©///////////////////////////////////////////////////////////////////////////©//
//  СП_Тестирование - переопределение модуля управляемого приложения (Adopted).
//
//  Автозапуск UI-моста: при старте тонкого клиента с тестовым маркером
//  в ПараметреЗапуска (плагин EDT передаёт его как /C SPECTER_START_BRIDGE)
//  открываем форму списка «Контрагенты» - её ПриОткрытии (переопределён
//  в этом же расширении) исполняет мост команд Runner на РЕАЛЬНОМ слое UI.
//
//  Эталон оформления - afm.YAXUNIT (ManagedApplicationModule + &После).
//©///////////////////////////////////////////////////////////////////////////©//

#Область ОбработчикиСобытий

&После("ПриНачалеРаботыСистемы")
Процедура СП_ПриНачалеРаботыСистемы()

	// Маркер автозапуска моста, передаваемый EDT-плагином через стартовую опцию
	// клиента (RuntimeExecutionArguments.setStartupOption → 1cv8c ... /C <значение>,
	// на клиенте это значение доступно в ПараметреЗапуска).
	// ВНИМАНИЕ: в 1С Перем нельзя инициализировать при объявлении — маркер объявляем
	// как локальную переменную здесь, а не как глобальную Перем с присваиванием.
	МаркерАвтозапуска = "SPECTER_START_BRIDGE";
	МаркерСовместимости = "OZONUI_START_BRIDGE";

	// Запущен ли клиент с тестовым маркером (внешний Runner/плагин).
	Если СтрНайти(ПараметрЗапуска, МаркерАвтозапуска) = 0 И СтрНайти(ПараметрЗапуска, МаркерСовместимости) = 0 Тогда
		// Обычный запуск - не вмешиваемся в штатный интерфейс.
		Возврат;
	КонецЕсли;

	// Открываем форму консоли тестов движка СП_КонсольТестов
	ПараметрыФормы = Новый Структура("Автозапуск, ПараметрЗапуска", Истина, ПараметрЗапуска);
	ОткрытьФорму("Обработка.СП_КонсольТестов.Форма.ФормаСписка", ПараметрыФормы);

КонецПроцедуры

#КонецОбласти
