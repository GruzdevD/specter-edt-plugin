#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// Мост запускается по МАРКЕРУ СТАРТОВОЙ ОПЦИИ клиента (глобальный ПараметрЗапуска),
	// а НЕ по параметру формы: adopted-форма консоли не объявляет formParameters,
	// поэтому параметры из ОткрытьФорму(..., "Автозапуск,...") до обработчика не доходят.
	//@skip-check bsl-legacy-check-global-context-method-call
	// Маркер SPECTER_TESTCLIENT ставит мост на подчинённом TestClient: в нём мост НЕ запускаем,
	// иначе цели исполняются в подчинённом сеансе (двойное исполнение).
	// ГИГИЕНА ЛИЦЕНЗИЙ: TestClient, осиротевший после падения/прерывания ведущего
	// сеанса, висит вечно и держит клиентское место. Самозавершение через 10 минут:
	// обычный тест укладывается, а утечка ограничена. Счётчик обновляется при каждом
	// вызове обработчика; вмешательство в тест исключено (обработчик только завершает).
	Если СтрНайти(ПараметрЗапуска, "SPECTER_TESTCLIENT") > 0 Тогда
		ПодключитьОбработчикОжидания("СамозавершениеТестКлиента", 600, Истина);
		Возврат;
	КонецЕсли;
	Если СтрНайти(ПараметрЗапуска, "SPECTER_START_BRIDGE") > 0 ИЛИ СтрНайти(ПараметрЗапуска, "OZONUI_START_BRIDGE") > 0 Тогда
		ПодключитьОбработчикОжидания("ОбработатьАвтозапускМоста", 0.1, Истина);
	КонецЕсли;

КонецПроцедуры

// Самозавершение осиротевшего TestClient (гигиена лицензий): вызывается один раз
// через 10 минут после старта подчинённого сеанса. Если тест жив — он обычно
// завершается быстрее; осиротевший сеанс умирает и освобождает лицензию.
&НаКлиенте
Процедура СамозавершениеТестКлиента()

	ЗавершитьРаботуСистемы(Ложь);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыполнитьТесты(Команда)

	ВыполнитьТестыНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьТесты(Команда)

	ПоказатьТестыНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Обработчик автозапуска при старте моста из EDT (/C "SPECTER_START_BRIDGE|outDir=...")
&НаКлиенте
Процедура ОбработатьАвтозапускМоста()

	// Источник истины — глобальная стартовая опция клиента (/C "..."), а не параметры формы.
	ПараметрЗап = ПараметрЗапуска;

	КаталогОбмена = ПолучитьКаталогОбменаИзПараметра(ПараметрЗап);

	// ДИАГНОСТИКА: безусловная запись того, что увидел клиент прямо в начале
	// автозапуска моста. Если outDir= не долетел до ПараметраЗапуска — файл уходит
	// в фиксированный /tmp/specter-bridge-diagnostic.log (иначе «ничего не происходит»
	// из-за тихого Возврата ниже). Иначе пишем рядом с командами моста.
	Попытка
		//@skip-check bsl-legacy-check-dynamic-feature-access
		СП_ПротоколВызовСервера.АтомарноЗаписатьТекстВФайл(
			?(ПустаяСтрока(КаталогОбмена), "/tmp/specter-bridge-diagnostic.log", КаталогОбмена + "/specter-bridge-diagnostic.log"),
			"ts=" + Строка(ТекущаяУниверсальнаяДатаВМиллисекундах())
			+ " | ПараметрЗапуска=[" + ПараметрЗап + "]"
			+ " | outDir=[" + КаталогОбмена + "]");
	Исключение
		// диагностика не должна ронять автозапуск
	КонецПопытки;

	Если ПустаяСтрока(КаталогОбмена) Тогда
		Возврат;
	КонецЕсли;

	ПутьКоманд = КаталогОбмена + "/bridge-commands.json";
	КомандыМоста = ПрочитатьКомандыМоста(ПутьКоманд);

	RunId = "";
	Если КомандыМоста <> Неопределено И КомандыМоста.Свойство("runId") Тогда
		RunId = Строка(КомандыМоста.runId);
	Иначе
		RunId = СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	КонецЕсли;

	// Annotation Discovery: если плагин прислал явный список целей targets
	// [{module, method}] (парсинг //&Тест на build-time), переходим к новому
	// контуру ЗапуститьМодульПоЦелям — движок не полагается на контракт
	// СписокТестов/ЗапуститьНаборТестов в тестовом модуле.
	Цели = Неопределено;
	Если КомандыМоста <> Неопределено И КомандыМоста.Свойство("targets") Тогда
		Цели = КомандыМоста.targets;
	КонецЕсли;

	ИмяМодуля = "";
	ИмяТеста = "";
	Если КомандыМоста <> Неопределено И КомандыМоста.Свойство("module") Тогда
		ИмяМодуля = Строка(КомандыМоста.module);
	КонецЕсли;
	Если КомандыМоста <> Неопределено И КомандыМоста.Свойство("test") Тогда
		ИмяТеста = Строка(КомандыМоста.test);
	КонецЕсли;

	// Выполняем тесты (на клиенте или сервере в зависимости от модуля)
	РезультатПрогона = Неопределено;
	Попытка
		Если ЗначениеЗаполнено(Цели) Тогда
			// Новый контур: цели от EDT заданы явно.
			РезультатыПрогонаСписка = СП_ТестированиеКлиент.ЗапуститьМодульПоЦелям(Цели);
			Если РезультатыПрогонаСписка.Количество() = 0 Тогда
				// АНТИ-МАСКИРОВКА: цели были, но ни одна не исполнена (расхождение
				// ключей/имён) — честный aborted, а не зелёный passed.
				РезультатПрогона = Новый Структура;
				РезультатПрогона.Вставить("status", "aborted");
				ТестыПустые = Новый Массив;
				//@skip-check structure-consructor-too-many-keys
				ТестыПустые.Добавить(Новый Структура("name, status, durationMs, message, error",
					"targets", "aborted", 0, "Ни одна цель не исполнена (несовпадение ключей/имён модулей)", ""));
				РезультатПрогона.Вставить("tests", ТестыПустые);
			Иначе
				РезультатПрогона = СводкаИзРезультатов(РезультатыПрогонаСписка);
			КонецЕсли;
		Иначе
			Критерии = Новый Структура("Набор, ИмяТеста", ИмяМодуля, ИмяТеста);
			РезультатПрогона = ВыполнитьПрогонМоста(ИмяМодуля, Критерии);
		КонецЕсли;
	Исключение
		РезультатПрогона = Новый Структура;
		РезультатПрогона.Вставить("status", "aborted");
		Тесты = Новый Массив;
		//@skip-check structure-consructor-too-many-keys
		Тесты.Добавить(Новый Структура("name, status, durationMs, message, error",
			?(ЗначениеЗаполнено(ИмяТеста), ИмяТеста, ИмяМодуля), "aborted", 0, "Сбой исполнения моста", ОписаниеОшибки()));
		РезультатПрогона.Вставить("tests", Тесты);
	КонецПопытки;

	// Формируем результирующий JSON структуры BridgeResult
	ОтветМоста = Новый Структура;
	ОтветМоста.Вставить("runId", RunId);
	ОтветМоста.Вставить("status", РезультатПрогона.status);
	ОтветМоста.Вставить("timestamp", ТекущаяУниверсальнаяДатаВМиллисекундах());
	ОтветМоста.Вставить("steps", Новый Массив);

	// Переносим шаги / тесты в массив steps
	Для Каждого Т Из РезультатПрогона.tests Цикл
		Шаг = Новый Структура;
		Шаг.Вставить("action", "test");
		Шаг.Вставить("locator", Т.name);
		Шаг.Вставить("status", Т.status);
		Шаг.Вставить("message", ?(Т.Свойство("message"), Т.message, ""));
		ОтветМоста.steps.Добавить(Шаг);
	КонецЦикла;

	// АТОМАРНАЯ ЗАПИСЬ: двухэтапная схема (runId.tmp -> runId.json)
	ПутьРезультата = КаталогОбмена + "/bridge-result-" + RunId + ".json";
	Попытка
		//@skip-check bsl-legacy-check-dynamic-feature-access
		СП_ПротоколВызовСервера.АтомарноЗаписатьJSONВФайл(ПутьРезультата, ОтветМоста);
	Исключение
		// Запись журнала регистрации на управляемом клиенте недоступна; дублируем ошибку
		// атомарной записью в файл лога рядом с результатом (клиентская операция над файлами).
		ПутьЛога = КаталогОбмена + "/bridge-error-" + RunId + ".log";
		//@skip-check empty-except-statement
		Попытка
			//@skip-check bsl-legacy-check-dynamic-feature-access
			СП_ПротоколВызовСервера.АтомарноЗаписатьТекстВФайл(ПутьЛога,
				"Не удалось атомарно записать результат моста: " + ОписаниеОшибки());
		Исключение
		КонецПопытки;
	КонецПопытки;

	// Завершение работы клиента после выполнения автоматического прогона
	ЗавершитьРаботуСистемы(Ложь);

КонецПроцедуры

&НаКлиенте
Функция ПолучитьКаталогОбменаИзПараметра(Опция)

	Маркер = "outDir=";
	Позиция = СтрНайти(Опция, Маркер);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Значение = Сред(Опция, Позиция + СтрДлина(Маркер));
	Разделитель = СтрНайти(Значение, "|");
	Если Разделитель > 0 Тогда
		Значение = Лев(Значение, Разделитель - 1);
	КонецЕсли;

	Возврат СокрЛП(Значение);

КонецФункции

&НаКлиенте
Функция ПрочитатьКомандыМоста(ПутьКоманд)

	Файл = Новый Файл(ПутьКоманд);
	Если НЕ Файл.Существует() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		//@skip-check bsl-legacy-check-type-environments
		Чтение = Новый ЧтениеТекста(ПутьКоманд, КодировкаТекста.UTF8);
		//@skip-check bsl-legacy-check-dynamic-feature-access
		Текст = Чтение.Прочитать();
		//@skip-check bsl-legacy-check-dynamic-feature-access
		Чтение.Закрыть();
		//@skip-check bsl-legacy-check-dynamic-feature-access
		Возврат СП_ПротоколВызовСервера.РазобратьJson(Текст);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

&НаКлиенте
Функция ВыполнитьПрогонМоста(ИмяМодуля, Критерии)

	// Проверяем наличие клиентского контекста
	//@skip-check empty-except-statement
	Попытка
		Если ЗначениеЗаполнено(ИмяМодуля) Тогда
			РезультатыМассив = СП_ТестированиеКлиент.ЗапуститьНаборТестовКлиент(ИмяМодуля, Критерии);
			
			Сводка = Новый Структура("status, tests", "passed", Новый Массив);
			Для Каждого Рез Из РезультатыМассив Цикл
				//@skip-check structure-consructor-too-many-keys
				Сводка.tests.Добавить(Новый Структура(
					"name, status, durationMs, message, error",
					Рез.Имя, Рез.Статус, Рез.ДлительностьМс, Рез.Сообщение, Рез.Ошибка));
				Если Рез.Статус = "failed" ИЛИ Рез.Статус = "aborted" Тогда
					Сводка.status = "failed";
				КонецЕсли;
			КонецЦикла;
			Возврат Сводка;
		КонецЕсли;
	Исключение
		// Fallback на серверное исполнение
	КонецПопытки;

	Возврат ВыполнитьПрогонНаСервере(Критерии);

КонецФункции

&НаСервере
Функция ВыполнитьПрогонНаСервере(Критерии)

	Сводка = СП_Тестирование.Запустить(Критерии);
	Возврат СП_Тестирование.СформироватьОтчёт(Сводка);

КонецФункции

// Преобразует массив результатов (единая модель Specter: Имя/Статус/ДлительностьМс/
// Сообщение/Ошибка) в сводку моста {status, tests:[...]}.
//@skip-check form-module-pragma
&НаКлиенте
Функция СводкаИзРезультатов(РезультатыМассив)

	Сводка = Новый Структура("status, tests", "passed", Новый Массив);
	Для Каждого Рез Из РезультатыМассив Цикл
		//@skip-check structure-consructor-too-many-keys
		Сводка.tests.Добавить(Новый Структура(
			"name, status, durationMs, message, error",
			Рез.Имя, Рез.Статус, Рез.ДлительностьМс, Рез.Сообщение, Рез.Ошибка));
		Если Рез.Статус = "failed" ИЛИ Рез.Статус = "aborted" Тогда
			Сводка.status = "failed";
		КонецЕсли;
	КонецЦикла;
	Возврат Сводка;

КонецФункции

&НаСервере
Процедура ВыполнитьТестыНаСервере()

	Сводка = СП_Тестирование.Запустить();

	КолПройдено = 0;
	КолПровалено = 0;
	КолПрервано = 0;
	КолПропущено = 0;
	СтрокиОтчета = Новый Массив;

	Для Каждого Рез Из Сводка.Тесты Цикл

		Если Рез.Статус = СП_Тестирование.СтатусПройден() Тогда
			КолПройдено = КолПройдено + 1;
		ИначеЕсли Рез.Статус = СП_Тестирование.СтатусПровален() Тогда
			КолПровалено = КолПровалено + 1;
		ИначеЕсли Рез.Статус = СП_Тестирование.СтатусПрерван() Тогда
			КолПрервано = КолПрервано + 1;
		ИначеЕсли Рез.Статус = СП_Тестирование.СтатусПропущен() Тогда
			КолПропущено = КолПропущено + 1;
		КонецЕсли;

		СтрокиОтчета.Добавить(
			Строка(Рез.Имя) + " [" + Строка(Рез.Статус) + "] " + ОбъединитьСообщения(Рез));

	КонецЦикла;

	Итог = "Итог: " + Строка(Сводка.Итог)
		+ " (passed=" + Строка(КолПройдено)
		+ ", failed=" + Строка(КолПровалено)
		+ ", aborted=" + Строка(КолПрервано)
		+ ", skipped=" + Строка(КолПропущено)
		+ ", всего=" + Строка(Сводка.Тесты.Количество()) + ")";

	ТекстОтчета = СтрСоединить(СтрокиОтчета, Символы.ПС);

КонецПроцедуры

&НаСервере
Процедура ПоказатьТестыНаСервере()

	Строки = Новый Массив;
	Для Каждого Т Из СП_Тестирование.СписокТестов() Цикл
		Строки.Добавить("[" + Строка(Т.Набор) + "] " + Строка(Т.Имя)
			+ " - " + Строка(Т.Описание));
	КонецЦикла;

	Итог = "Найдено тестов: " + Строка(Строки.Количество());
	ТекстОтчета = "Наборы: " + СтрСоединить(СП_Тестирование.СписокНаборов(), ", ")
		+ Символы.ПС + СтрСоединить(Строки, Символы.ПС);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ОбъединитьСообщения(Рез)

	Текст = "";
	Если Рез.Свойство("Сообщение") И НЕ ПустаяСтрока(Рез.Сообщение) Тогда
		Текст = Рез.Сообщение;
	КонецЕсли;
	Если Рез.Свойство("Ошибка") И НЕ ПустаяСтрока(Рез.Ошибка) Тогда
		Если НЕ ПустаяСтрока(Текст) Тогда
			Текст = Текст + " | ";
		КонецЕсли;
		Текст = Текст + Рез.Ошибка;
	КонецЕсли;
	Возврат Текст;

КонецФункции

#КонецОбласти
