//  СП_УправлениеФормами.ОсновнаяФорма - форма-исполнитель реального
//  прогона сценария afm-programmatic-contractor-form (Фаза B, live afm).
//
//  Сценарий выполняется при открытии формы; ход выводится в ЗАГОЛОВОК формы
//  (виден без модальных диалогов), результат сериализуется в JSON и пишется
//  на хост (файловая ИБ). Контур programmatic (открытие форм кодом).
//©///////////////////////////////////////////////////////////////////////////©//

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ) Экспорт

	// LEGACY: programmatic-демо (работа с объектной моделью и данными, НЕ с реальным слоем
	// UI-ввода). Не считается доказательством UI-действий. Каталог обмена — из стартовой
	// опции клиента (единая конфигурация: /C "SPECTER_START_BRIDGE|outDir=<путь>").
	ПутьОтчёта = ПолучитьКаталогОбмена() + "/live-afm-run-raw.json";
	КонтрагентКод = "TEST-UL-0001";
	ИННОжидаемое = "7700000000";

	Шаги = Новый Массив;
	//@skip-check module-self-reference
	ЭтотОбъект.Заголовок = "LIVE: СТАРТ сценария";

	// --- setup (сервер) ---
	Попытка
		СсылкаКонтрагента = УстановитьДанные(КонтрагентКод);
		Шаги.Добавить(ШагДляОтчёта("setup", "prepareContractor", "passed",
			"контрагент " + КонтрагентКод + " подготовлен (" + Строка(СсылкаКонтрагента) + ")"));
		//@skip-check module-self-reference
		ЭтотОбъект.Заголовок = "LIVE: setup OK";
	Исключение
		Шаги.Добавить(ШагДляОтчёта("setup", "prepareContractor", "failed", ОписаниеОшибки()));
		//@skip-check module-self-reference
		ЭтотОбъект.Заголовок = "LIVE: setup FAILED: " + ОписаниеОшибки();
		ОтчётЗаписан = ЗаписатьОтчёт(ПутьОтчёта, Шаги);
		//@skip-check module-self-reference
		ЭтотОбъект.Заголовок = ЭтотОбъект.Заголовок + " | файл=" + ?(ОтчётЗаписан, "ok", "НЕ записан");
		Возврат;
	КонецПопытки;

	// --- waitFor: форма списка ---
	Попытка
		//@skip-check use-non-recommended-method
		ФормаСписка = ПолучитьФорму("Справочник.Контрагенты.ФормаСписка");
		ФормаСписка.Открыть();
		Видима = ФормаСписка.Открыта();
		Шаги.Добавить(ШагДляОтчёта("waitFor", "form:Контрагенты(list:visible)", ?(Видима, "passed", "failed"),
			"форма списка открыта=" + Строка(Видима)));
		//@skip-check module-self-reference
		ЭтотОбъект.Заголовок = "LIVE: список открыт=" + Строка(Видима);
		Если НЕ Видима Тогда
			ОтчётЗаписан = ЗаписатьОтчёт(ПутьОтчёта, Шаги);
			//@skip-check module-self-reference
			ЭтотОбъект.Заголовок = ЭтотОбъект.Заголовок + " | файл=" + ?(ОтчётЗаписан, "ok", "НЕ записан");
			Возврат;
		КонецЕсли;
	Исключение
		Шаги.Добавить(ШагДляОтчёта("waitFor", "form:Контрагенты(list:visible)", "failed", ОписаниеОшибки()));
		//@skip-check module-self-reference
		ЭтотОбъект.Заголовок = "LIVE: waitFor FAILED: " + ОписаниеОшибки();
		ОтчётЗаписан = ЗаписатьОтчёт(ПутьОтчёта, Шаги);
		//@skip-check module-self-reference
		ЭтотОбъект.Заголовок = ЭтотОбъект.Заголовок + " | файл=" + ?(ОтчётЗаписан, "ok", "НЕ записан");
		Возврат;
	КонецПопытки;

	// --- click (programmatic) -> карточка ---
	Попытка
		Если НЕ ЗначениеЗаполнено(СсылкаКонтрагента) Тогда
			СсылкаКонтрагента = НайтиСсылкуКонтрагента(КонтрагентКод);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СсылкаКонтрагента) Тогда
			ВызватьИсключение "контрагент не найден по коду " + КонтрагентКод;
		КонецЕсли;
		//@skip-check use-non-recommended-method
		//@skip-check bsl-legacy-check-string-literal
		Карточка = ПолучитьФорму("Справочник.Контрагенты.ФормаЭлемента", Новый Структура("Ключ", СсылкаКонтрагента));
		Карточка.Открыть();
		Если НЕ Карточка.Открыта() Тогда
			ВызватьИсключение "карточка контрагента не открылась";
		КонецЕсли;
		Шаги.Добавить(ШагДляОтчёта("click", "name:Наименование(table)", "passed",
			"карточка " + КонтрагентКод + " открыта программно (programmatic)"));
		//@skip-check module-self-reference
		ЭтотОбъект.Заголовок = "LIVE: карточка открыта";
	Исключение
		Шаги.Добавить(ШагДляОтчёта("click", "name:Наименование(table)", "failed", ОписаниеОшибки()));
		//@skip-check module-self-reference
		ЭтотОбъект.Заголовок = "LIVE: click FAILED: " + ОписаниеОшибки();
		ОтчётЗаписан = ЗаписатьОтчёт(ПутьОтчёта, Шаги);
		//@skip-check module-self-reference
		ЭтотОбъект.Заголовок = ЭтотОбъект.Заголовок + " | файл=" + ?(ОтчётЗаписан, "ok", "НЕ записан");
		Возврат;
	КонецПопытки;

	// --- setValue: НаименованиеСокращенное ---
	Попытка
		Карточка.Объект.НаименованиеСокращенное = "ООО Тест Контрагент";
		Шаги.Добавить(ШагДляОтчёта("setValue", "name:НаименованиеСокращенное(form)", "passed",
			"наименованиеСокращенное установлено 'ООО Тест Контрагент'"));
		//@skip-check module-self-reference
		ЭтотОбъект.Заголовок = "LIVE: setValue OK";
	Исключение
		Шаги.Добавить(ШагДляОтчёта("setValue", "name:НаименованиеСокращенное(form)", "failed", ОписаниеОшибки()));
		//@skip-check module-self-reference
		ЭтотОбъект.Заголовок = "LIVE: setValue FAILED: " + ОписаниеОшибки();
		ОтчётЗаписан = ЗаписатьОтчёт(ПутьОтчёта, Шаги);
		//@skip-check module-self-reference
		ЭтотОбъект.Заголовок = ЭтотОбъект.Заголовок + " | файл=" + ?(ОтчётЗаписан, "ok", "НЕ записан");
		Возврат;
	КонецПопытки;

	// --- assert: ИНН ---
	Попытка
		Карточка.Объект.ИНН = ИННОжидаемое;
		Факт = Строка(Карточка.Объект.ИНН);
		РезультатСовпадения = (Факт = ИННОжидаемое);
		Шаги.Добавить(ШагДляОтчёта("assert", "name:ИНН(value)", ?(РезультатСовпадения, "passed", "failed"),
			"ожидаемое=" + ИННОжидаемое + " факт=" + Факт));
		//@skip-check module-self-reference
		ЭтотОбъект.Заголовок = "LIVE: assert ИНН=" + Факт;
	Исключение
		Шаги.Добавить(ШагДляОтчёта("assert", "name:ИНН(value)", "failed", ОписаниеОшибки()));
		//@skip-check module-self-reference
		ЭтотОбъект.Заголовок = "LIVE: assert FAILED: " + ОписаниеОшибки();
	КонецПопытки;

	// --- teardown (сервер) ---
	Попытка
		ОчиститьДанные(КонтрагентКод);
		Шаги.Добавить(ШагДляОтчёта("teardown", "cleanupContractor", "passed",
			"контрагент " + КонтрагентКод + " очищен (пометка удаления)"));
		//@skip-check module-self-reference
		ЭтотОбъект.Заголовок = "LIVE: teardown OK";
	Исключение
		Шаги.Добавить(ШагДляОтчёта("teardown", "cleanupContractor", "failed", ОписаниеОшибки()));
		//@skip-check module-self-reference
		ЭтотОбъект.Заголовок = "LIVE: teardown FAILED: " + ОписаниеОшибки();
	КонецПопытки;

	ОтчётЗаписан = ЗаписатьОтчёт(ПутьОтчёта, Шаги);
	//@skip-check module-self-reference
	ЭтотОбъект.Заголовок = "LIVE: ИТОГ, файл=" + ?(ОтчётЗаписан, "ok", "НЕ записан");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ШагДляОтчёта(Действие, Локатор, Статус, Сообщение) Экспорт

	//@skip-check structure-consructor-too-many-keys
	Шаг = Новый Структура("action, locator, status, message", "", "", "", "");
	Шаг.action = Действие;
	Шаг.locator = Локатор;
	Шаг.status = Статус;
	Шаг.message = Сообщение;
	Возврат Шаг;

КонецФункции

//@skip-check doc-comment-export-function-return-section
//@skip-check doc-comment-parameter-section
// Сериализует шаги в JSON и пишет файл на хост.
&НаКлиенте
// Параметры:
//	Путь	- Строка - каталог и имя файла для записи отчёта.
//	Шаги	- Массив - выполненные шаги сценария (поля action, locator, status, message).
//
// Возвращаемое значение:
//	Булево - Истина при успешной записи, Ложь иначе.
Функция ЗаписатьОтчёт(Путь, Шаги) Экспорт

	Стр = "[";
	Первый = Истина;
	Для Каждого Шаг Из Шаги Цикл
		Если НЕ Первый Тогда
			Стр = Стр + ",";
		КонецЕсли;
		Первый = Ложь;
		Стр = Стр + "{"
			+ """action"":""" + Эск(Шаг.action) + """"
			+ ",""locator"":""" + Эск(Шаг.locator) + """"
			+ ",""status"":""" + Эск(Шаг.status) + """"
			+ ",""message"":""" + Эск(Шаг.message) + """"
			+ "}";
	КонецЦикла;
	Стр = Стр + "]";

	Попытка
		ЗаписатьФайлНаСервере(Путь, Стр);
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

&НаКлиенте
Функция Эск(Значение) Экспорт

	СтрокаЗначения = Строка(Значение);
	СтрокаЗначения = СтрЗаменить(СтрокаЗначения, "\", "/");
	СтрокаЗначения = СтрЗаменить(СтрокаЗначения, """", "'");
	СтрокаЗначения = СтрЗаменить(СтрокаЗначения, Символы.ПС, " ");
	СтрокаЗначения = СтрЗаменить(СтрокаЗначения, Символы.ВК, " ");
	Возврат СтрокаЗначения;

КонецФункции

&НаСервере
Функция УстановитьДанные(Код)

	СсылкаКонтрагента = Справочники.Контрагенты.НайтиПоКоду(Код, Истина);
	Если ЗначениеЗаполнено(СсылкаКонтрагента) Тогда
		Объект = СсылкаКонтрагента.ПолучитьОбъект();
	Иначе
		Объект = Справочники.Контрагенты.СоздатьЭлемент();
		Объект.Код = Код;
	КонецЕсли;

	Объект.Наименование = "Тестовый контрагент " + Код;
	Объект.НаименованиеСокращенное = "Тест " + Код;
	Объект.Записать();

	ЗаписьЖурналаРегистрации("СП_Тестирование.Сценарий", УровеньЖурналаРегистрации.Информация, , ,
		"setup: контрагент " + Код + " подготовлен");
	Возврат Объект.Ссылка;

КонецФункции

&НаСервере
Процедура ОчиститьДанные(Код)

	СсылкаКонтрагента = Справочники.Контрагенты.НайтиПоКоду(Код, Истина);
	Если ЗначениеЗаполнено(СсылкаКонтрагента) Тогда
		Объект = СсылкаКонтрагента.ПолучитьОбъект();
		Объект.УстановитьПометкуУдаления(Истина);
		Объект.Записать();
		ЗаписьЖурналаРегистрации("СП_Тестирование.Сценарий", УровеньЖурналаРегистрации.Информация, , ,
			"teardown: контрагент " + Код + " помечен на удаление");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция НайтиСсылкуКонтрагента(Код)

	Возврат Справочники.Контрагенты.НайтиПоКоду(Код, Истина);

КонецФункции

&НаСервереБезКонтекста
Процедура ЗаписатьФайлНаСервере(Путь, Текст)

	СП_ПротоколВызовСервера.АтомарноЗаписатьТекстВФайл(Путь, Текст);

КонецПроцедуры

// Каталог обмена из стартовой опции клиента (единая конфигурация с агентом моста).
&НаКлиенте
Функция ПолучитьКаталогОбмена()

	Маркер = "SPECTER_START_BRIDGE";
	ИмяПараметра = "outDir=";
	Опция = ПараметрЗапуска;

	Если СтрНайти(Опция, Маркер) = 0 Тогда
		ВызватьИсключение "Маркер '" + Маркер + "' не найден в параметре запуска";
	КонецЕсли;

	Позиция = СтрНайти(Опция, ИмяПараметра);
	Если Позиция = 0 Тогда
		ВызватьИсключение "Параметр '" + ИмяПараметра + "' не найден в стартовой опции клиента";
	КонецЕсли;

	Значение = Сред(Опция, Позиция + СтрДлина(ИмяПараметра));
	Разделитель = СтрНайти(Значение, "|");
	Если Разделитель > 0 Тогда
		Значение = Лев(Значение, Разделитель - 1);
	КонецЕсли;

	Если ПустаяСтрока(Значение) Тогда
		ВызватьИсключение "Каталог обмена пуст в стартовой опции клиента";
	КонецЕсли;

	Возврат СокрЛП(Значение);

КонецФункции

#КонецОбласти
