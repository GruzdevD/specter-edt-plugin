//©///////////////////////////////////////////////////////////////////////////©//
//  СП_УправлениеФормами - обработка расширения afm, UI-адаптер (Фаза A).
//
//  Сервис ПРОГРАММНОГО открытия/закрытия форм (не-full-UI / programmatic контур).
//  Метод открытия - реальный паттерн afm.Smoke (ДТОткрытиеФорм): ПолучитьФорму → Открыть
//  → контроль Форма.Открыта() → ОбновитьОтображениеДанных(). Это code-driven открытие,
//  НЕ клики. Объект-обработка: СП_УправлениеФормами. Собственной формы/реквизитов не
//  имеет - чистый сервис. Запускается в клиентской сессии.
//©///////////////////////////////////////////////////////////////////////////©//

#Область ПрограммныйИнтерфейс

// Открыть форму списка по стабильному имени (kind='form', area='list').
Функция ОткрытьФормуСписок(ИмяФормы) Экспорт

	Записи = СП_СправочникИмен.Формы();

	Если НЕ Записи.Свойство(ИмяФормы) Тогда
		ВызватьИсключение "СП_УправлениеФормами: неизвестная форма '" + ИмяФормы + "'";
	КонецЕсли;

	ПолноеИмяФормы = Записи[ИмяФормы].Форма;
	Параметры = Новый Структура;
	Форма = ОткрытьПолученнуюФорму(ПолноеИмяФормы, Параметры);
	Возврат Форма;

КонецФункции

// Открыть форму списка контрагентов (специализированный вход для сценария).
Функция ОткрытьСписокКонтрагентов() Экспорт

	Возврат ОткрытьФормуСписок("Контрагенты");

КонецФункции

// Открыть форму элемента справочника Контрагенты по ссылке (карточка).
Функция ОткрытьКарточкуКонтрагента(Ссылка) Экспорт

	ПолноеИмяФормы = "Справочник.Контрагенты.ФормаЭлемента";
	Параметры = Новый Структура("Ключ", Ссылка);
	Форма = ОткрытьПолученнуюФорму(ПолноеИмяФормы, Параметры);
	Возврат Форма;

КонецФункции

// Получить уже открытую форму списка (для waitFor/read без повторного открытия).
Функция НайтиОткрытуюФормуСписок(ИмяФормы) Экспорт

	Записи = СП_СправочникИмен.Формы();
	Если НЕ Записи.Свойство(ИмяФормы) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		//@skip-check use-non-recommended-method
		Форма = ПолучитьФорму(Записи[ИмяФормы].Форма, , , Новый УникальныйИдентификатор);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если Форма.Открыта() Тогда
		Возврат Форма;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОткрытьПолученнуюФорму(ПолноеИмяФормы, Параметры)

	Попытка
		//@skip-check use-non-recommended-method
		Форма = ПолучитьФорму(ПолноеИмяФормы, Параметры, , Новый УникальныйИдентификатор);
	Исключение
		ВызватьИсключение "СП_УправлениеФормами: не удалось получить форму '" + ПолноеИмяФормы + "': " + ОписаниеОшибки();
	КонецПопытки;

	Попытка
		Форма.Открыть();
	Исключение
		ВызватьИсключение "СП_УправлениеФормами: не удалось открыть форму '" + ПолноеИмяФормы + "': " + ОписаниеОшибки();
	КонецПопытки;

	Если НЕ Форма.Открыта() Тогда
		ВызватьИсключение "СП_УправлениеФормами: форма '" + ПолноеИмяФормы + "' не открылась";
	КонецЕсли;

	Попытка
		Форма.ОбновитьОтображениеДанных();
	Исключение
		// Обновление отображения - best-effort, не блокирует открытие.
	КонецПопытки;

	Возврат Форма;

КонецФункции

#КонецОбласти
